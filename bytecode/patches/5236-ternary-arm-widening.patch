+        self, vv: VyperValue, typ: VyperType, annotation: Optional[str] = None
+    ) -> VyperValue:
+        """Return `vv` laid out as `typ`, copying only when the layouts differ."""
+        if punnable(vv.typ, typ):
+            return vv

+def _bytestring_convert_value(ptr, src_t, out_t, ctx):
+    # Backport vyper#5338 to the bounded bytestring types at this pin.
+    # Consumers can read the result up to its type's size.
+    if src_t.memory_bytes_required < out_t.memory_bytes_required:
+        ret = ctx.new_temporary_value(out_t, annotation="convert")
+        assert isinstance(ret.operand, IRVariable)
+        ctx.copy_memory(ret.operand, ptr, src_t.memory_bytes_required)
+        return ret.operand
+    return ptr

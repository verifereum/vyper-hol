Upstream PR: https://github.com/vyperlang/vyper/pull/5350
Status: open (draft)

Reject a subscript of a pop() result whose index can write a variable the
base reads, or makes a risky call (CompilerPanic "risky overlap").

Adapted to this pin: the pin already has the overlap helpers this uses
(_subscript_read_write_overlap and the risky-call walk), so nothing else is
needed. The check goes first in _lower_array_subscript, before the pin's
own stale-base overlap check, as upstream places it.

diff --git a/vyper/codegen_venom/expr.py b/vyper/codegen_venom/expr.py
--- a/vyper/codegen_venom/expr.py
+++ b/vyper/codegen_venom/expr.py
@@ -175,6 +175,16 @@
     return False
 
 
+def _is_derived_from_pop(node: vy_ast.VyperNode) -> bool:
+    """Return True if `node` is a `pop()` result, or a member or element of one."""
+    while isinstance(node, (vy_ast.Subscript, vy_ast.Attribute)):
+        node = node.value
+    if not isinstance(node, vy_ast.Call):
+        return False
+    func_t = node.func._metadata.get("type")
+    return isinstance(func_t, MemberFunctionT) and func_t.name == "pop"
+
+
 class Expr:
     """Lower Vyper expressions to Venom IR.
 
@@ -997,6 +1007,13 @@
         assert isinstance(node, vy_ast.Subscript)
         base_typ = node.value._metadata["type"]
 
+        if _is_derived_from_pop(node.value) and _subscript_read_write_overlap(
+            node.value, node.slice
+        ):
+            # The popped element is past the array's new length, so the
+            # index can overwrite it before the base is read.
+            raise CompilerPanic("risky overlap")
+

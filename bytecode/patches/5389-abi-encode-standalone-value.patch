+def abi_encode_value_to_buf(
+    ctx: VenomCodegenContext, dst: IRVariable, arg_val: VyperValue, encode_type: VyperType
+) -> IROperand:
+    """Encode one value at dst using its own type."""
+    if encode_type._is_prim_word:
+        ctx.store_vyper_value(arg_val, dst, encode_type)
+        return IRLiteral(encode_type.abi_type.static_size())
+
+    src = ctx.unwrap(arg_val)
+    assert isinstance(src, IRVariable)
+    return abi_encode_to_buf(ctx, dst, src, encode_type)
+

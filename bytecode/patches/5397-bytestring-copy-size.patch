         return self.builder.sha3(data_ptr_op, length)
@@ -1182,10 +1180,7 @@ class Expr:

         # Not a constant - compute at runtime
         vv = Expr(node, self.ctx).lower()
-        assert isinstance(node, vy_ast.ExprNode)

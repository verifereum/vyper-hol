+    def snapshot_value_for_delayed_use(
+        self, vv: VyperValue, *, copy_composites: bool = False
+    ) -> VyperValue:
+        """Freeze a value whose source must survive later expression evaluation.
+
+        Delayed users such as assignment targets lower after the value they
+        store. If the value is still a storage pointer or a memory pointer into
+        mutable data, the target's side effects can change what is observed.
+        This helper turns primitives into stack values immediately and copies
+        composites when the delayed user needs owned memory.
+        """
+        if vv.typ._is_prim_word:
+            return VyperValue.from_stack_op(self.unwrap(vv), vv.typ)
+
+        if copy_composites:
+            return self.materialize_value(vv, vv.typ)
+
+        return vv
+

+(* Proof-only child interface: the extra relation holds at the same witness. *)
+Definition calldata_aggregate_child_rel_def:
+  calldata_aggregate_child_rel R lo ctx fn PG site initial G0 tn0 st final root src
+      TV ts vals d xs srcword member_ptrs oid base_addr cap cutoff <=>
+  !i a mid b ep dp ei az mz.
+    i < LENGTH xs /\ EL i xs = (ei,az,mz) /\
+    (do ep <- compile_getelemptr_abi src (dec_info_needs_offset ei)
+          (SUM (MAP (\(ei,az,mz). az) (TAKE i xs))) CALLDATALOAD (Lit 0w) (Lit 0w);
+        dp <- emit_op ADD [Var root; Lit (n2w (SUM (MAP (\(ei,az,mz). mz) (TAKE i xs))))];
+        return (ep,dp) od) a = ((ep,dp),mid) /\
+    compile_abi_decode_to_buf dp ep CALLDATALOAD (Lit 0w) (Lit 0w) ei mid = ((),b) /\
+    cs_extends st a /\ cs_extends b final /\ fn_has_code mid b fn /\
+    ci_mono st a /\ ci_mono b final /\
+    compile_abi_decode_complex_elems (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+      (DROP (SUC i) xs)
+      (az + SUM (MAP (\(ei,az,mz). az) (TAKE i xs)))
+      (mz + SUM (MAP (\(ei,az,mz). mz) (TAKE i xs))) b = ((),final) /\
+    fn_has_code b final fn ==>
+    !u w e G tn q.
+      ((?B bt. calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src
+          TV ts vals d i mid u B bt) /\ st.cs_next_var <= mid.cs_next_var /\
+        (mid.cs_next_var <= cutoff ==> future_frame cutoff initial u) /\
+        eval_operand (Var root) u = SOME (n2w d)) /\
+      (calldata_aggregate_address_resource lo ctx fn PG initial G0 tn0 st root src
+        TV ts vals d i ep dp mid u /\
+        eval_operand dp u = SOME (n2w (d + SUM (MAP type_memory_size (TAKE i ts)))) /\
+        d + SUM (MAP type_memory_size (TAKE i ts)) < dimword (:256)) /\
+      ~u.vs_halted /\ u.vs_current_bb = mid.cs_current_bb /\

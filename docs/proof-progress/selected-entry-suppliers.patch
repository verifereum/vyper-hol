+       `mid`, `ofs+4`, `st`] >> simp[] >>
+     qpat_x_assum `~MEM name _` mp_tac >>
+     simp[MEM_MAP, pairTheory.EXISTS_PROD] >> metis_tac[]) >>
+  simp[] >> metis_tac[abiDecoderCoherenceTheory.abi_decoder_coherent_layout_transport]
+QED

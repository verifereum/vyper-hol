+         qpat_assum `compile_abi_decode_to_buf _ _ _ _ _ di middle = _`
+           (mp_tac o MATCH_MP abiDecoderCountersTheory.abi_decoder_variable_counter) >> disch_tac >>
+         simp[MEM] >>
+         rpt strip_tac >> gvs[] >> decide_tac) >>
+     qpat_x_assum `lookup_block (FST (labels0,labels1,labels2)) _ = _` mp_tac >>
+     simp[]) >>
+  PairCases_on `b` >> qexistsl_tac [`b0`, `b1`, `b2`] >>
+  qpat_x_assum `calldata_reentrant_loop_output _ _ _ _ _ _ _ _ _ _ _ _ _ _ (b0,b1,b2)` mp_tac >>
+  qpat_x_assum `calldata_loop_framed_joint_rel _ _ _ _ _ (initial,G,tn) _` mp_tac >>
+  simp[calldata_reentrant_loop_output_def, calldata_reentrant_post_def,
+    dispatchedDecoderBoundaryFrameTheory.calldata_loop_framed_joint_rel_def] >>
+  qpat_x_assum `R initial (FST _)` mp_tac >> simp[]
+QED
+
+Theorem calldata_loop_reentrant_joint:
+  calldata_reentrant_pre ctx fn site lo st last initial src root srcword d
+    (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs))
+    oid base_addr cap G tn /\
+  compile_abi_decode_to_buf (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+    (DecDynArray di abi_sz mem_sz elem_dyn maxn) st = ((),last) /\
+  abi_sz = tv_abi_size tv /\ mem_sz = type_memory_size tv /\
+  elem_dyn = tv_abi_dynamic tv /\
+  dec_info_needs_offset di = tv_abi_dynamic tv /\
+  dec_info_needs_clamp di = tv_needs_clamp tv /\
+  maxn < dimword (:256) /\
+  (elem_dyn \/ dec_info_needs_clamp di) /\

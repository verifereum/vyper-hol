+    FST setup = Var q /\ eval_operand (FST setup) t = SOME (n2w p) /\
+    p+32 < dimword (:256) /\ mload p t = 0w /\
+    ptr_covers H u q (jump_to hdr t) 32 /\
+    ptr_covers H u root (jump_to hdr t) totalbytes /\

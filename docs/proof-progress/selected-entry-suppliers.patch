+Definition future_frame_def:
+  future_frame k s t <=>
+    !n. k <= n ==> lookup_var (STRING #"%" (toString n)) t =
+      lookup_var (STRING #"%" (toString n)) s
+End
+
+Theorem future_frame_refl[simp]:
+  future_frame k s s

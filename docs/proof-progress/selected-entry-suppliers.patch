+     simp[Abbr `u`, update_var_def, alloca_inv_def,
+       allocas_non_overlapping_def, alloca_next_valid_def,
+       allocaFrontierBoundTheory.alloca_frontier_inv_def,
+       allocaBudgetPropsTheory.remaining_alloca_budget_def]) >>
+  simp[]
+QED
+
+Finalise registration_ptr_guard_exact_frame

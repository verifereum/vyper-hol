+    val_in_memory tv x (d+32+j*type_memory_size tv) v.vs_memory /\
+    mem_bytes_at d (32+j*type_memory_size tv) v.vs_memory =
+      mem_bytes_at d (32+j*type_memory_size tv) u.vs_memory /\ Rel entry v
+Proof

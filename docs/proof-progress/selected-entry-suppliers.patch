index 000000000..e64af6c7a
--- /dev/null
+++ b/lowering/dispatchedDecoderAggregateJointScript.sml
@@ -0,0 +1,1363 @@
+Theory dispatchedDecoderAggregateJoint
+Ancestors
+  calldataExactLinkedMembers dispatchedDecoderMemberAddressJoint
+  dispatchedDecoderBoundaryFrame dispatchedDecoderWriteBounds
+  decoderNavigationPtr calldataMembers emitHelperProps exprLoweringProps
+  compileEnv emitHelper venomState venomExecSemantics venomInst words
+  entrySinkExtraction abiDecoderReentryPointer abiEncoder instIdxIndep
+  abiDecoderReentry abiDecoderExecution abiDecoderArrayInitExec fragExec rich_list
+  bodyPtrTypeBuiltinsRepresentation decoderGhostFramePtr dispatchedDecoderTrace
+  fragGasOriginPtr fragGasOriginPtrExec loweringStateRelDefs bodyPtrDefs ptrDiscipline
+  valueEncodingDefs valueEncodingProps finite_map pred_set list arithmetic
+
+(* The ghost witnesses in this relation describe the very same physical
+   endpoint as the finite traversal. Completed members are robust values,
+   not claims about their unused reserved capacity. *)
+Definition calldata_aggregate_resource_def:
+  calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src TV ts vals d
+      i a s G tn <=>
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (initial,G0,tn0) [] (OK s,G,tn)) /\
+    fresh_vars_wrt a s /\
+    ptr_covers G tn root s (type_memory_size TV) /\
+    op_prov G src = NONE /\ op_taint tn src = {} /\
+    allocas_from lo s /\ lo <= s.vs_alloca_next /\
+    tn.t_mem SUBSET tn0.t_mem /\
+    tn.t_stor = tn0.t_stor /\ tn.t_trans = tn0.t_trans /\ tn.t_imm = tn0.t_imm /\
+    (!z. not_fresh_at st z ==>
+      FLOOKUP G z = FLOOKUP G0 z /\ op_taint tn (Var z) = op_taint tn0 (Var z)) /\
+    (!j. j < i ==> val_wf (EL j ts) (EL j vals) /\
+      !m. mem_agree_outside tn.t_mem s.vs_memory m ==>
+        val_in_memory (EL j ts) (EL j vals)
+          (d + SUM (MAP type_memory_size (TAKE j ts))) m)
+End
+
+Definition calldata_aggregate_address_resource_def:
+  calldata_aggregate_address_resource lo ctx fn PG initial G0 tn0 st root src TV ts vals d
+      i ep dp a s <=>
+    ?G tn q.
+      calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src TV ts vals d
+        i a s G tn /\
+      dp = Var q /\ ptr_covers G tn q s (type_memory_size (EL i ts)) /\
+      op_prov G ep = NONE /\ op_taint tn ep = {}
+End
+
+Theorem calldata_aggregate_resource_initial:
+  ~initial.vs_halted /\ fresh_vars_wrt st initial /\
+  ptr_covers G0 tn0 root initial (type_memory_size TV) /\
+  op_prov G0 src = NONE /\ op_taint tn0 src = {} /\
+  allocas_from lo initial /\ lo <= initial.vs_alloca_next ==>
+  calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src TV ts vals d
+    0 st initial G0 tn0
+Proof
+  strip_tac >> simp[calldata_aggregate_resource_def] >>
+  rpt gen_tac >> irule (cj 1 gas_origin_ptr_path_rules) >> simp[]
+QED
+
+(* Address code leaves the memory and memory taint unchanged. Its old-name
+   frame therefore transports all completed members without footprint bounds. *)
+Theorem calldata_aggregate_resource_address_frame:
+  calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src TV ts vals d
+    i a s G tn /\
+  (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) [] (OK t,B,bt)) /\
+  fresh_vars_wrt b t /\ not_fresh_at a root /\
+  (!q. src = Var q ==> not_fresh_at a q) /\
+  st.cs_next_var <= a.cs_next_var /\
+  t.vs_memory = s.vs_memory /\ t.vs_allocas = s.vs_allocas /\
+  t.vs_alloca_next = s.vs_alloca_next /\
+  bt.t_mem = tn.t_mem /\ bt.t_stor = tn.t_stor /\
+  bt.t_trans = tn.t_trans /\ bt.t_imm = tn.t_imm /\
+  (!z. not_fresh_at a z ==>
+    lookup_var z t = lookup_var z s /\ FLOOKUP B z = FLOOKUP G z /\
+    op_taint bt (Var z) = op_taint tn (Var z)) ==>
+  calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src TV ts vals d
+    i b t B bt
+Proof
+  simp_tac bool_ss [calldata_aggregate_resource_def] >> strip_tac >>
+  `!z. not_fresh_at st z ==> not_fresh_at a z` by
+    (simp[not_fresh_at_def] >> metis_tac[LESS_EQ_TRANS]) >>
+  `ptr_covers B bt root t (type_memory_size TV)` by
+    (irule ptr_covers_frame >> metis_tac[]) >>
+  `op_prov B src = NONE /\ op_taint bt src = {}` by
+    (Cases_on `src` >> gvs[op_prov_def,op_taint_def]) >>
+  gvs[allocas_from_def] >> conj_tac
+  >- (rpt gen_tac >>
+      qpat_assum `!D explicit. gas_origin_ptr_path _ (initial,_,_) _ _`
+        (qspecl_then [`D`,`explicit`] mp_tac) >>
+      disch_then (mp_tac o MATCH_MP gas_origin_ptr_path_append) >>
+      simp[] >> disch_then drule >> simp[]) >>
+  metis_tac[]
+QED
+
+Theorem calldata_aggregate_completed_transport:
+  (!j. j < i ==> val_wf (EL j ts) (EL j vals) /\
+    !m. mem_agree_outside tn s.vs_memory m ==>
+      val_in_memory (EL j ts) (EL j vals)
+        (d + SUM (MAP type_memory_size (TAKE j ts))) m) /\
+  bt SUBSET tn /\
+  (!j. j < i ==>
+    mem_bytes_at (d + SUM (MAP type_memory_size (TAKE j ts)))
+      (type_memory_size (EL j ts)) t.vs_memory =
+    mem_bytes_at (d + SUM (MAP type_memory_size (TAKE j ts)))
+      (type_memory_size (EL j ts)) s.vs_memory) ==>
+  !j. j < i ==> val_wf (EL j ts) (EL j vals) /\
+    !m. mem_agree_outside bt t.vs_memory m ==>
+      val_in_memory (EL j ts) (EL j vals)
+        (d + SUM (MAP type_memory_size (TAKE j ts))) m
+Proof
+  strip_tac >> gen_tac >> strip_tac >>
+  qpat_assum `!j. j < i ==> val_wf _ _ /\ _` drule >> strip_tac >>
+  conj_tac >- simp[] >> rpt strip_tac >>
+  irule robust_val_in_memory_decreasing_taint_transport >>
+  conj_tac >- simp[] >>
+  qexistsl_tac [`s.vs_memory`,`t.vs_memory`,`type_memory_size (EL j ts)`,
+    `d + SUM (MAP type_memory_size (TAKE j ts))`,`tn`,`bt`] >>
+  simp[] >> conj_tac >- (gvs[SUBSET_DEF]) >>
+  metis_tac[exprSimPropsTheory.val_footprint_le]
+QED
+
+Theorem calldata_aggregate_resource_advance:
+  calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src TV ts vals d
+    i a s G tn /\
+  (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) [] (OK t,B,bt)) /\
+  fresh_vars_wrt b t /\ not_fresh_at a root /\
+  (!q. src = Var q ==> not_fresh_at a q) /\
+  st.cs_next_var <= a.cs_next_var /\
+  allocas_from lo t /\ s.vs_alloca_next <= t.vs_alloca_next /\
+  bt.t_mem SUBSET tn.t_mem /\ bt.t_stor = tn.t_stor /\
+  bt.t_trans = tn.t_trans /\ bt.t_imm = tn.t_imm /\
+  (!z. not_fresh_at a z ==>
+    lookup_var z t = lookup_var z s /\ FLOOKUP B z = FLOOKUP G z /\
+    op_taint bt (Var z) = op_taint tn (Var z)) /\
+  (!j. j < i ==>
+    mem_bytes_at (d + SUM (MAP type_memory_size (TAKE j ts)))
+      (type_memory_size (EL j ts)) t.vs_memory =
+    mem_bytes_at (d + SUM (MAP type_memory_size (TAKE j ts)))
+      (type_memory_size (EL j ts)) s.vs_memory) /\
+  val_wf (EL i ts) (EL i vals) /\
+  (!m. mem_agree_outside bt.t_mem t.vs_memory m ==>
+    val_in_memory (EL i ts) (EL i vals)
+      (d + SUM (MAP type_memory_size (TAKE i ts))) m) ==>
+  calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src TV ts vals d
+    (SUC i) b t B bt
+Proof
+  simp_tac bool_ss [calldata_aggregate_resource_def] >> strip_tac >>
+  `!z. not_fresh_at st z ==> not_fresh_at a z` by
+    (simp[not_fresh_at_def] >> metis_tac[LESS_EQ_TRANS]) >>
+  `ptr_covers B bt root t (type_memory_size TV)` by
+    (irule ptr_covers_frame >> metis_tac[]) >>
+  `op_prov B src = NONE /\ op_taint bt src = {}` by
+    (Cases_on `src` >> gvs[op_prov_def,op_taint_def]) >>
+  `!j. j < i ==> val_wf (EL j ts) (EL j vals) /\
+    !m. mem_agree_outside bt.t_mem t.vs_memory m ==>
+      val_in_memory (EL j ts) (EL j vals)
+        (d + SUM (MAP type_memory_size (TAKE j ts))) m` by
+    (metis_tac[calldata_aggregate_completed_transport]) >>
+  simp[] >> conj_tac
+  >- (rpt gen_tac >>
+      qpat_assum `!D explicit. gas_origin_ptr_path _ (initial,_,_) _ _`
+        (qspecl_then [`D`,`explicit`] mp_tac) >>
+      disch_then (mp_tac o MATCH_MP gas_origin_ptr_path_append) >>
+      simp[] >> disch_then drule >> simp[]) >>
+  rpt conj_tac
+  >- metis_tac[SUBSET_TRANS] >>
+  gen_tac >> strip_tac >> Cases_on `j = i` >> gvs[] >>
+  `j < i` by decide_tac >> metis_tac[]
+QED
+
+(* Recursive child contract: every physical side condition is supplied by the
+   indexed traversal. The child returns one common physical/ghost endpoint;
+   assembly of the next aggregate resource is deliberately not assumed. *)
+Definition calldata_aggregate_child_def:
+  calldata_aggregate_child lo ctx fn PG site initial G0 tn0 st final root src
+      TV ts vals d xs srcword member_ptrs oid base_addr cap cutoff <=>
+  !i a mid b ep dp ei az mz.
+    i < LENGTH xs /\ EL i xs = (ei,az,mz) /\
+    (do ep <- compile_getelemptr_abi src (dec_info_needs_offset ei)
+          (SUM (MAP (\(ei,az,mz). az) (TAKE i xs))) CALLDATALOAD (Lit 0w) (Lit 0w);
+        dp <- emit_op ADD [Var root; Lit (n2w (SUM (MAP (\(ei,az,mz). mz) (TAKE i xs))))];
+        return (ep,dp) od) a = ((ep,dp),mid) /\
+    compile_abi_decode_to_buf dp ep CALLDATALOAD (Lit 0w) (Lit 0w) ei mid = ((),b) /\
+    cs_extends st a /\ cs_extends b final /\ fn_has_code mid b fn /\
+    ci_mono st a /\ ci_mono b final /\
+    compile_abi_decode_complex_elems (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+      (DROP (SUC i) xs)
+      (az + SUM (MAP (\(ei,az,mz). az) (TAKE i xs)))
+      (mz + SUM (MAP (\(ei,az,mz). mz) (TAKE i xs))) b = ((),final) /\
+    fn_has_code b final fn ==>
+    !u w e G tn q.
+      ((?B bt. calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src
+          TV ts vals d i mid u B bt) /\ st.cs_next_var <= mid.cs_next_var /\
+        (mid.cs_next_var <= cutoff ==> future_frame cutoff initial u) /\
+        eval_operand (Var root) u = SOME (n2w d)) /\
+      (calldata_aggregate_address_resource lo ctx fn PG initial G0 tn0 st root src
+        TV ts vals d i ep dp mid u /\
+        eval_operand dp u = SOME (n2w (d + SUM (MAP type_memory_size (TAKE i ts)))) /\
+        d + SUM (MAP type_memory_size (TAKE i ts)) < dimword (:256)) /\
+      ~u.vs_halted /\ u.vs_current_bb = mid.cs_current_bb /\
+      u.vs_inst_idx = LENGTH mid.cs_current_insts /\
+      eval_operand ep u = SOME w /\ eval_operand dp u = SOME (n2w e) /\
+      u.vs_call_ctx.cc_calldata = initial.vs_call_ctx.cc_calldata /\ w2n w = member_ptrs i /\
+      alloca_inv u /\ alloca_frontier_inv ctx fn site u /\
+      (!id q k. mid.cs_next_id <= id /\ id < b.cs_next_id /\
+        FLOOKUP u.vs_allocas id = SOME (q,k) ==>
+        k = 32 /\ q < dimword (:256) /\ q+32 <= u.vs_alloca_next /\
+        ?ins. MEM ins (fn_insts fn) /\ ins.inst_id = id /\
+          ins.inst_opcode = ALLOCA /\ ins.inst_operands = [Lit 32w]) /\
+      FLOOKUP u.vs_allocas oid = SOME (base_addr,cap) /\
+      base_addr <= e /\ e+type_memory_size (EL i ts) <= base_addr+cap /\
+      e+type_memory_size (EL i ts) < dimword (:256) /\
+      calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src
+        TV ts vals d i mid u G tn /\
+      dp = Var q /\ ptr_covers G tn q u (type_memory_size (EL i ts)) /\
+      op_prov G ep = NONE /\ op_taint tn ep = {} ==>
+      ?v sc B bt.
+        ~v.vs_halted /\ v.vs_current_bb = b.cs_current_bb /\
+        v.vs_inst_idx = LENGTH b.cs_current_insts /\
+        (cd_decode F initial.vs_call_ctx.cc_calldata (EL i ts) (member_ptrs i) =
+          SOME (EL i vals) /\ value_has_type (EL i ts) (EL i vals)) /\
+        val_wf (EL i ts) (EL i vals) /\
+        val_in_memory (EL i ts) (EL i vals) e v.vs_memory /\
+        (!fuel r. run_from fuel ctx fn v = r /\ (!err. r <> Error err) ==>
+          ?fuel'. run_from fuel' ctx fn u = r /\
+            (mem_safe_run fuel ctx fn v ==> mem_safe_run fuel' ctx fn u)) /\
+        v.vs_call_ctx = u.vs_call_ctx /\ v.vs_data_section = u.vs_data_section /\
+        alloca_inv v /\ alloca_frontier_inv ctx fn site v /\
+        (!id q k. mid.cs_next_id <= id /\ id < b.cs_next_id /\
+          FLOOKUP v.vs_allocas id = SOME (q,k) ==>
+          k = 32 /\ q < dimword (:256) /\ q+32 <= v.vs_alloca_next /\
+          ?ins. MEM ins (fn_insts fn) /\ ins.inst_id = id /\
+            ins.inst_opcode = ALLOCA /\ ins.inst_operands = [Lit 32w]) /\
+        u.vs_alloca_next <= v.vs_alloca_next /\
+        (!id q k. FLOOKUP u.vs_allocas id = SOME (q,k) ==>
+          FLOOKUP v.vs_allocas id = SOME (q,k)) /\
+        (!id. id < mid.cs_next_id \/ b.cs_next_id <= id ==>
+          FLOOKUP v.vs_allocas id = FLOOKUP u.vs_allocas id) /\
+        (!op. abi_decoder_operand_live mid.cs_next_var op ==>
+          eval_operand op v = eval_operand op u) /\
+        abi_decode_footprint_frame ((e,type_memory_size (EL i ts))::sc) u v /\
+        (!q k. MEM (q,k) sc ==> ?id. mid.cs_next_id <= id /\ id < b.cs_next_id /\
+          FLOOKUP v.vs_allocas id = SOME (q,k)) /\
+        (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+          (u,G,tn) [] (OK v,B,bt)) /\
+        future_frame cutoff u v /\ fresh_vars_wrt b v /\ allocas_from lo v /\
+        bt.t_mem SUBSET tn.t_mem /\ bt.t_stor = tn.t_stor /\
+        bt.t_trans = tn.t_trans /\ bt.t_imm = tn.t_imm /\
+        (!z. not_fresh_at mid z ==> FLOOKUP B z = FLOOKUP G z /\
+          op_taint bt (Var z) = op_taint tn (Var z)) /\
+        (!m. mem_agree_outside bt.t_mem v.vs_memory m ==>
+          val_in_memory (EL i ts) (EL i vals) e m)
+End
+
+Theorem calldata_aggregate_child_apply:
+  !lo ctx fn PG site initial G0 tn0 st final root src TV ts vals d xs srcword
+    member_ptrs oid base_addr cap cutoff i a mid b ep dp ei az mz u w e G tn q.
+  calldata_aggregate_child lo ctx fn PG site initial G0 tn0 st final root src
+    TV ts vals d xs srcword member_ptrs oid base_addr cap cutoff /\
+  i < LENGTH xs /\ EL i xs = (ei,az,mz) /\
+  (do ep <- compile_getelemptr_abi src (dec_info_needs_offset ei)
+        (SUM (MAP (\(ei,az,mz). az) (TAKE i xs))) CALLDATALOAD (Lit 0w) (Lit 0w);
+      dp <- emit_op ADD [Var root; Lit (n2w (SUM (MAP (\(ei,az,mz). mz) (TAKE i xs))))];
+      return (ep,dp) od) a = ((ep,dp),mid) /\
+  compile_abi_decode_to_buf dp ep CALLDATALOAD (Lit 0w) (Lit 0w) ei mid = ((),b) /\
+  cs_extends st a /\ cs_extends b final /\ fn_has_code mid b fn /\
+  ci_mono st a /\ ci_mono b final /\
+  compile_abi_decode_complex_elems (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+    (DROP (SUC i) xs)
+    (az + SUM (MAP (\(ei,az,mz). az) (TAKE i xs)))
+    (mz + SUM (MAP (\(ei,az,mz). mz) (TAKE i xs))) b = ((),final) /\
+  fn_has_code b final fn /\ st.cs_next_var <= mid.cs_next_var /\
+  (mid.cs_next_var <= cutoff ==> future_frame cutoff initial u) /\
+  eval_operand (Var root) u = SOME (n2w d) /\
+  calldata_aggregate_address_resource lo ctx fn PG initial G0 tn0 st root src
+    TV ts vals d i ep dp mid u /\
+  eval_operand dp u = SOME (n2w (d + SUM (MAP type_memory_size (TAKE i ts)))) /\
+  d + SUM (MAP type_memory_size (TAKE i ts)) < dimword (:256) /\
+  ~u.vs_halted /\ u.vs_current_bb = mid.cs_current_bb /\
+  u.vs_inst_idx = LENGTH mid.cs_current_insts /\
+  eval_operand ep u = SOME w /\ eval_operand dp u = SOME (n2w e) /\
+  u.vs_call_ctx.cc_calldata = initial.vs_call_ctx.cc_calldata /\ w2n w = member_ptrs i /\
+  alloca_inv u /\ alloca_frontier_inv ctx fn site u /\
+  (!id q k. mid.cs_next_id <= id /\ id < b.cs_next_id /\
+    FLOOKUP u.vs_allocas id = SOME (q,k) ==>
+    k = 32 /\ q < dimword (:256) /\ q+32 <= u.vs_alloca_next /\
+    ?ins. MEM ins (fn_insts fn) /\ ins.inst_id = id /\
+      ins.inst_opcode = ALLOCA /\ ins.inst_operands = [Lit 32w]) /\
+  FLOOKUP u.vs_allocas oid = SOME (base_addr,cap) /\
+  base_addr <= e /\ e+type_memory_size (EL i ts) <= base_addr+cap /\
+  e+type_memory_size (EL i ts) < dimword (:256) /\
+  calldata_aggregate_resource lo ctx fn PG initial G0 tn0 st root src
+    TV ts vals d i mid u G tn /\
+  dp = Var q /\ ptr_covers G tn q u (type_memory_size (EL i ts)) /\
+  op_prov G ep = NONE /\ op_taint tn ep = {} ==>
+  ?v sc B bt.
+    ~v.vs_halted /\ v.vs_current_bb = b.cs_current_bb /\
+    v.vs_inst_idx = LENGTH b.cs_current_insts /\
+    (cd_decode F initial.vs_call_ctx.cc_calldata (EL i ts) (member_ptrs i) =
+      SOME (EL i vals) /\ value_has_type (EL i ts) (EL i vals)) /\
+    val_wf (EL i ts) (EL i vals) /\
+    val_in_memory (EL i ts) (EL i vals) e v.vs_memory /\
+    (!fuel r. run_from fuel ctx fn v = r /\ (!err. r <> Error err) ==>
+      ?fuel'. run_from fuel' ctx fn u = r /\
+        (mem_safe_run fuel ctx fn v ==> mem_safe_run fuel' ctx fn u)) /\
+    v.vs_call_ctx = u.vs_call_ctx /\ v.vs_data_section = u.vs_data_section /\
+    alloca_inv v /\ alloca_frontier_inv ctx fn site v /\
+    (!id q k. mid.cs_next_id <= id /\ id < b.cs_next_id /\
+      FLOOKUP v.vs_allocas id = SOME (q,k) ==>
+      k = 32 /\ q < dimword (:256) /\ q+32 <= v.vs_alloca_next /\
+      ?ins. MEM ins (fn_insts fn) /\ ins.inst_id = id /\
+        ins.inst_opcode = ALLOCA /\ ins.inst_operands = [Lit 32w]) /\
+    u.vs_alloca_next <= v.vs_alloca_next /\
+    (!id q k. FLOOKUP u.vs_allocas id = SOME (q,k) ==>
+      FLOOKUP v.vs_allocas id = SOME (q,k)) /\
+    (!id. id < mid.cs_next_id \/ b.cs_next_id <= id ==>
+      FLOOKUP v.vs_allocas id = FLOOKUP u.vs_allocas id) /\
+    (!op. abi_decoder_operand_live mid.cs_next_var op ==>
+      eval_operand op v = eval_operand op u) /\
+    abi_decode_footprint_frame ((e,type_memory_size (EL i ts))::sc) u v /\
+    (!q k. MEM (q,k) sc ==> ?id. mid.cs_next_id <= id /\ id < b.cs_next_id /\
+      FLOOKUP v.vs_allocas id = SOME (q,k)) /\
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (u,G,tn) [] (OK v,B,bt)) /\
+    future_frame cutoff u v /\ fresh_vars_wrt b v /\ allocas_from lo v /\
+    bt.t_mem SUBSET tn.t_mem /\ bt.t_stor = tn.t_stor /\

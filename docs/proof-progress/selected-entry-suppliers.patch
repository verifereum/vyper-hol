+Theorem registration_decoder_result:
+  dispatched_registration_caller ctx fn site lo PG st limit_st s G tn old /\
+  dispatched_registration_ready ctx fn site lo PG st first last limit_st
+    s G tn old cef name n info tv x srcword dst src t H u p /\
+  calldata_reentrant_post ctx fn site lo PG first last t H u root p tv x v J w /\
+  dst = Var root /\ n = type_memory_size tv /\
+  (!q. dst = Var q ==> FLOOKUP H q = SOME (p,n)) /\
+  u.t_stor = tn.t_stor /\ u.t_trans = tn.t_trans /\ u.t_imm = tn.t_imm /\
+  entry_decoder_obs t v /\
+  ((!fuel. mem_safe_run fuel ctx fn v) ==> !fuel. mem_safe_run fuel ctx fn t) /\
+  fn_inst_ids_distinct fn /\
+  first.cs_next_id <= last.cs_next_id /\
+  first.cs_next_var <= last.cs_next_var /\
+  last.cs_next_var <= limit_st.cs_next_var ==>
+  registration_result ctx fn site lo PG st last limit_st s G tn old
+    cef [(name,prim,dyn,sz,ty,tv)] [x] v J w
+    (old ++ [(root,st.cs_next_id,p,type_memory_size tv,tv,x)])
+    [(x,dst,p,st.cs_next_id)]
+Proof
+  strip_tac >>
+  `registration_old_resources last v J w old` by
+    (`registration_old_resources first t H u old /\
+      FLOOKUP t.vs_allocas st.cs_next_id = SOME (p,type_memory_size tv)` by
+       fs[dispatched_registration_ready_def, dispatched_registration_caller_def] >>
+     `!r id a n ty y. MEM (r,id,a,n,ty,y) old ==> id <> st.cs_next_id` by
+       (rpt strip_tac >>

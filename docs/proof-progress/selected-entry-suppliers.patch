+  disch_then (qspec_then `PG` strip_assume_tac) >>
+  qexistsl_tac [`v`, `H`, `u`] >> conj_tac >- first_assum ACCEPT_TAC >>
+  irule calldata_reentrant_fresh_boundary >>
+  goal_assum (drule_at Any) >> simp[] >>
+  mp_tac (cj 1 abiDecoderCountersTheory.abi_decoder_vars_mono_mutual) >>
+  simp_tac bool_ss [abiDecoderCountersTheory.abi_decoder_vars_mono_def] >>
+  strip_tac >> metis_tac[pairTheory.SND]
+QED
diff --git a/lowering/dispatchedDecoderLoadJointScript.sml b/lowering/dispatchedDecoderLoadJointScript.sml
new file mode 100644
index 000000000..ff4a06526
--- /dev/null
+++ b/lowering/dispatchedDecoderLoadJointScript.sml
@@ -0,0 +1,52 @@
+(* Actual calldata load: shared concrete endpoint and zero-event joint trace. *)
+Theory dispatchedDecoderLoadJoint
+Ancestors calldataWordStepsPtr dispatchedDecoderTrace abiDecoderContract
+  abiEncoder fragExec instIdxIndep bodyPtrDefs calldataClampPtr
+  calldataOverwritePtr loweringStateRelDefs venomMemDefs
+
+Theorem calldata_load_accepted_joint:
+  emit_op CALLDATALOAD [src] sa = (v,sb) /\
+  eval_operand src s = SOME sw /\ fresh_vars_wrt sa s /\
+  op_taint tn src = {} /\ fn_has_code sa sb fn /\ fn_inst_ids_distinct fn /\
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  s.vs_current_bb = sa.cs_current_bb /\
+  s.vs_inst_idx = LENGTH sa.cs_current_insts /\ alloca_inv s ==>
+  ?t H u.
+    run_inst_seq (emitted_insts sa sb) s = OK (t with vs_inst_idx := s.vs_inst_idx) /\
+    ~t.vs_halted /\ t.vs_current_bb = sb.cs_current_bb /\
+    t.vs_inst_idx = LENGTH sb.cs_current_insts /\ fresh_vars_wrt sb t /\
+    eval_operand v t = SOME (abi_decode_load CALLDATALOAD sw s) /\
+    op_taint u v = {} /\ op_prov H v = NONE /\
+    t.vs_memory = s.vs_memory /\ t.vs_call_ctx = s.vs_call_ctx /\
+    t.vs_allocas = s.vs_allocas /\ t.vs_alloca_next = s.vs_alloca_next /\
+    (!a w. eval_operand a s = SOME w ==> eval_operand a t = SOME w) /\
+    u.t_mem = tn.t_mem /\ u.t_stor = tn.t_stor /\
+    u.t_trans = tn.t_trans /\ u.t_imm = tn.t_imm /\
+    (!x. not_fresh_at sa x ==> FLOOKUP H x = FLOOKUP G x /\
+      op_taint u (Var x) = op_taint tn (Var x)) /\
+    (!D. (!fuel. ptr_safe_run D lo fuel ctx fn PG H u t) ==>
+     !fuel. ptr_safe_run D lo fuel ctx fn PG G tn s) /\
+    alloca_inv t /\
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) [] (OK t,H,u))
+Proof
+  strip_tac >>
+  `!x. src = Var x ==> not_fresh_at sa x` by
+    (rpt strip_tac >> irule evaluated_operand_not_fresh >>
+     goal_assum $ drule_at (Pat `eval_operand`) >> simp[]) >>
+  `abi_decode_source_opcode CALLDATALOAD` by simp[abi_decode_source_opcode_def] >>
+  drule_all abi_decode_read >> strip_tac >>
+  rename1 `run_inst_seq (emitted_insts sa sb) s = OK loaded` >>
+  drule_all calldata_load_overwrite_trace_uniform >>
+  disch_then (qspecl_then [`PG`, `G`] strip_assume_tac) >>
+  `loaded = t with vs_inst_idx := s.vs_inst_idx` by
+    (qpat_x_assum `run_inst_seq _ _ = OK loaded` mp_tac >> simp[]) >>
+  `fresh_vars_wrt sb t` by fs[fresh_vars_wrt_def] >>
+  `!a z. eval_operand a s = SOME z ==> eval_operand a t = SOME z` by
+    (rpt strip_tac >>
+     qpat_x_assum `!a z. eval_operand a s = SOME z ==> eval_operand a loaded = SOME z`
+       drule >> simp[eval_op_inst_idx]) >>
+  qexistsl_tac [`t`, `H`, `u`] >> simp[] >>
+  fs[alloca_inv_def, allocas_non_overlapping_def, alloca_next_valid_def] >>
+  metis_tac[]
+QED
diff --git a/lowering/dispatchedDecoderLoopCaseJointScript.sml b/lowering/dispatchedDecoderLoopCaseJointScript.sml
new file mode 100644
index 000000000..788d2c6a1
--- /dev/null
+++ b/lowering/dispatchedDecoderLoopCaseJointScript.sml
@@ -0,0 +1,359 @@
+Theory dispatchedDecoderLoopCaseJoint
+Ancestors
+  calldataDynStep calldataExactDynIteration calldataExactAggregateSource
+  calldataExactDyn valueEncodingDefs valueEncodingProps vyperValue
+  arithmetic list rich_list venomState fragGasOriginPtr bodyPtrDefs
+  ptrSafetyTransport loweringStateRelDefs dispatchedDecoderLoopEdgesJoint
+  venomInst finite_map ptrSafeRun ptrDiscipline dispatchedDecoderTrace
+
+Theorem calldata_accepted_joint_iteration:
+  !n j xs a.
+  LENGTH xs = n /\ j <= n /\ H j a /\
+  (!k. k < j ==> value_has_type tv (EL k xs) /\ val_wf tv (EL k xs) /\
+    val_in_memory tv (EL k xs) (d+32+k*type_memory_size tv) (project a).vs_memory) /\
+  (!a b c. J a b /\ J b c ==> J a c) /\
+  (!i a. i < n /\ H i a ==>
+    ?b. H (SUC i) b /\ J a b /\
+      value_has_type tv (EL i xs) /\ val_wf tv (EL i xs) /\
+      val_in_memory tv (EL i xs) (d+32+i*type_memory_size tv) (project b).vs_memory /\
+      mem_bytes_at d (32+i*type_memory_size tv) (project b).vs_memory =
+      mem_bytes_at d (32+i*type_memory_size tv) (project a).vs_memory) /\
+  (!a. H n a /\
+    (!k. k < n ==> value_has_type tv (EL k xs) /\ val_wf tv (EL k xs) /\
+      val_in_memory tv (EL k xs) (d+32+k*type_memory_size tv) (project a).vs_memory)
+    ==> ?b. Q xs b /\ J a b)
+  ==> ?b. Q xs b /\ J a b
+Proof
+  gen_tac >> measureInduct_on `n-j` >> rpt strip_tac >>
+  Cases_on `j = n`
+  >- metis_tac[] >>
+  `j < n` by decide_tac >>
+  qpat_assum `!i a. i < n /\ H i a ==> _` drule_all >> strip_tac >>
+  `!k. k < j ==> val_in_memory tv (EL k xs)
+    (d+32+k*type_memory_size tv) (project b).vs_memory` by
+    (rpt strip_tac >>
+     `val_in_memory tv (EL k (TAKE j xs))
+       (d+32+k*type_memory_size tv) (project b).vs_memory` suffices_by simp[EL_TAKE] >>
+     irule (cj 2 calldata_prefix_window_transport) >>
+     conj_tac >- simp[] >>
+     reverse conj_tac >- simp[EVERY_EL,EL_TAKE] >>
+     qexistsl_tac [`j`,`project a`] >>
+     simp[EVERY_EL,EL_TAKE] >> rpt strip_tac >>
+     qpat_assum `!k. k < j ==> _ /\ _ /\ _` drule >>
+     simp_tac bool_ss [AC ADD_ASSOC ADD_COMM]) >>
+  `!k. k < SUC j ==> value_has_type tv (EL k xs) /\ val_wf tv (EL k xs) /\
+    val_in_memory tv (EL k xs) (d+32+k*type_memory_size tv) (project b).vs_memory` by
+    (qpat_x_assum `!y. n-y < n-j ==> _` kall_tac >>
+     gen_tac >> strip_tac >> Cases_on `k = j`
+     >- asm_rewrite_tac[] >>
+     `k < j` by decide_tac >>
+     qpat_assum `!k. k < j ==> _ /\ _ /\ _` drule >>
+     strip_tac >> asm_rewrite_tac[] >> metis_tac[]) >>
+  qpat_x_assum `!y. n-y < n-j ==> _` (qspec_then `SUC j` mp_tac) >>
+  (impl_tac >- (simp[] >> decide_tac)) >>
+  disch_then (qspecl_then [`xs`,`b`] mp_tac) >>
+  (impl_tac >- (rpt conj_tac >> asm_rewrite_tac[] >> decide_tac)) >> metis_tac[]
+QED
+
+(* A coupled continuation/path relation: the endpoint state in both conjuncts
+   is the same, and the ghosts are chosen before either path index. *)
+Definition calldata_loop_joint_rel_def:
+  calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (t,H,u) <=>
+    (!fuel r. run_from fuel ctx fn t = r /\ (!err. r <> Error err) ==>
+      ?fuel'. run_from fuel' ctx fn s = r /\
+        (mem_safe_run fuel ctx fn t ==> mem_safe_run fuel' ctx fn s)) /\
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) [] (OK t,H,u))
+End
+
+Theorem calldata_loop_joint_rel_refl:
+  !s G tn. ~s.vs_halted ==>
+    calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (s,G,tn)
+Proof
+  rpt strip_tac >> simp[calldata_loop_joint_rel_def] >> conj_tac
+  >- (rpt strip_tac >> qexists_tac `fuel` >> simp[]) >>
+  rpt gen_tac >> irule (cj 1 gas_origin_ptr_path_rules) >> simp[]
+QED
+
+Theorem calldata_loop_joint_rel_trans:
+  !a b c. calldata_loop_joint_rel lo ctx fn PG a b /\
+    calldata_loop_joint_rel lo ctx fn PG b c ==>
+    calldata_loop_joint_rel lo ctx fn PG a c
+Proof
+  PairCases >> PairCases >> PairCases >>
+  simp_tac bool_ss [calldata_loop_joint_rel_def] >> strip_tac >> conj_tac
+  >- metis_tac[] >>
+  rpt gen_tac >>
+  qpat_assum `!D explicit. gas_origin_ptr_path _ (a0,_,_) _ _`
+    (qspecl_then [`D`,`explicit`] mp_tac) >>
+  disch_then (mp_tac o MATCH_MP gas_origin_ptr_path_append) >>
+  simp[] >> disch_then drule >> simp[]
+QED
+
+(* Physical allocation and frame invariants are independent of the ghosts. *)
+Definition calldata_loop_own_def:
+  calldata_loop_own fn l h s <=>
+    !id q k. l <= id /\ id < h /\ FLOOKUP s.vs_allocas id = SOME (q,k) ==>
+      k = 32 /\ q < dimword (:256) /\ q+32 <= s.vs_alloca_next /\
+      ?ins. MEM ins (fn_insts fn) /\ ins.inst_id = id /\
+        ins.inst_opcode = ALLOCA /\ ins.inst_operands = [Lit 32w]
+End
+
+Definition calldata_loop_frame_def:
+  calldata_loop_frame ctx fn site st last initial d capacity s <=>
+    s.vs_call_ctx = initial.vs_call_ctx /\
+    s.vs_data_section = initial.vs_data_section /\
+    alloca_inv s /\ alloca_frontier_inv ctx fn site s /\
+    calldata_loop_own fn st.cs_next_id last.cs_next_id s /\
+    initial.vs_alloca_next <= s.vs_alloca_next /\
+    (!id q k. FLOOKUP initial.vs_allocas id = SOME (q,k) ==>
+      FLOOKUP s.vs_allocas id = SOME (q,k)) /\
+    (!id. id < st.cs_next_id \/ last.cs_next_id <= id ==>
+      FLOOKUP s.vs_allocas id = FLOOKUP initial.vs_allocas id) /\
+    (!op. abi_decoder_operand_live st.cs_next_var op ==>
+      eval_operand op s = eval_operand op initial) /\
+    ?scratch. abi_decode_footprint_frame ((d,capacity)::scratch) initial s /\
+      !q k. MEM (q,k) scratch ==> ?id.
+        st.cs_next_id <= id /\ id < last.cs_next_id /\
+        FLOOKUP s.vs_allocas id = SOME (q,k)
+End
+
+Definition calldata_loop_phys_def:
+  calldata_loop_phys ctx fn site st last initial header hdr
+    src srcword root q p oid base_addr cap d tv maxn n i s <=>
+    ~s.vs_halted /\ s.vs_current_bb = hdr /\ s.vs_inst_idx = 0 /\
+    i <= n /\ n <= maxn /\
+    eval_operand src s = SOME srcword /\
+    eval_operand (Var root) s = SOME (n2w d) /\
+    eval_operand (Var q) s = SOME (n2w p) /\ mload p s = n2w i /\
+    mem_word_at d s.vs_memory = n2w n /\
+    FLOOKUP s.vs_allocas header.cs_next_id = SOME (p,32) /\
+    FLOOKUP s.vs_allocas oid = SOME (base_addr,cap) /\
+    calldata_loop_frame ctx fn site st last initial d
+      (32+maxn*type_memory_size tv) s
+End
+
+(* No iteration-freshness assumption is included: child registers may have
+   been assigned on an earlier trip through the loop. *)
+Definition calldata_loop_ghost_def:
+  calldata_loop_ghost lo st initial_G initial_tn src root q p d tv maxn i (s,G,tn) <=>
+    allocas_from lo s /\ lo <= s.vs_alloca_next /\
+    ptr_covers G tn root s (32+maxn*type_memory_size tv) /\
+    ptr_covers G tn q s 32 /\
+    op_prov G src = NONE /\ op_taint tn src = {} /\
+    (!a. p <= a /\ a < p+32 ==> a NOTIN tn.t_mem) /\
+    (!a. d <= a /\ a < d+32+i*type_memory_size tv ==> a NOTIN tn.t_mem) /\
+    tn.t_mem SUBSET initial_tn.t_mem /\
+    tn.t_stor = initial_tn.t_stor /\ tn.t_trans = initial_tn.t_trans /\
+    tn.t_imm = initial_tn.t_imm /\
+    (!z. not_fresh_at st z ==> FLOOKUP G z = FLOOKUP initial_G z /\
+      op_taint tn (Var z) = op_taint initial_tn (Var z))
+End
+
+Definition calldata_loop_invariant_def:
+  calldata_loop_invariant ctx fn site lo st last initial initial_G initial_tn
+    header hdr src srcword root q p oid base_addr cap d tv maxn n i a <=>
+    calldata_loop_phys ctx fn site st last initial header hdr src srcword root q p
+      oid base_addr cap d tv maxn n i (FST a) /\
+    calldata_loop_ghost lo st initial_G initial_tn src root q p d tv maxn i a
+End
+
+Definition calldata_loop_output_def:
+  calldata_loop_output ctx fn site lo st last initial initial_G initial_tn
+    root d tv maxn xs (t,H,u) <=>
+    ~t.vs_halted /\ t.vs_current_bb = last.cs_current_bb /\
+    t.vs_inst_idx = LENGTH last.cs_current_insts /\
+    value_has_type (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs)) /\
+    val_wf (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs)) /\
+    val_in_memory (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs)) d t.vs_memory /\
+    calldata_loop_frame ctx fn site st last initial d
+      (type_memory_size (ArrayTV tv (Dynamic maxn))) t /\
+    ptr_covers H u root t (type_memory_size (ArrayTV tv (Dynamic maxn))) /\
+    (!a. d <= a /\ a < d+32+LENGTH xs*type_memory_size tv ==> a NOTIN u.t_mem) /\
+    u.t_mem SUBSET initial_tn.t_mem /\
+    u.t_stor = initial_tn.t_stor /\ u.t_trans = initial_tn.t_trans /\
+    u.t_imm = initial_tn.t_imm /\ allocas_from lo t /\
+    (!z. not_fresh_at st z ==> FLOOKUP H z = FLOOKUP initial_G z /\
+      op_taint u (Var z) = op_taint initial_tn (Var z))
+End
+
+(* A repeated-child callback.  Its physical frame and joint path share v;
+   it deliberately does not ask for fresh_vars_wrt middle. *)
+Definition calldata_loop_child_def:
+  calldata_loop_child ctx fn site lo PG middle st1 srcop child root q
+    oid base_addr cap d tv maxn srcbase xs <=>
+  !a A at i w.
+    i < LENGTH xs /\
+    ~a.vs_halted /\ a.vs_current_bb = middle.cs_current_bb /\
+    a.vs_inst_idx = LENGTH middle.cs_current_insts /\
+    eval_operand srcop a = SOME w /\
+    w2n w = cd_member_ptr F a.vs_call_ctx.cc_calldata tv srcbase (i*tv_abi_size tv) /\
+    cd_decode F a.vs_call_ctx.cc_calldata tv (w2n w) = SOME (EL i xs) /\
+    eval_operand (Var child) a = SOME (n2w (d+32+i*type_memory_size tv)) /\
+    alloca_inv a /\ alloca_frontier_inv ctx fn site a /\
+    calldata_loop_own fn middle.cs_next_id st1.cs_next_id a /\
+    FLOOKUP a.vs_allocas oid = SOME (base_addr,cap) /\
+    base_addr <= d+32+i*type_memory_size tv /\
+    d+32+i*type_memory_size tv+type_memory_size tv <= base_addr+cap /\
+    d+32+i*type_memory_size tv+type_memory_size tv < dimword (:256) /\
+    ptr_covers A at child a (type_memory_size tv) /\
+    op_prov A srcop = NONE /\ op_taint at srcop = {} /\
+    allocas_from lo a /\ lo <= a.vs_alloca_next /\
+    ptr_covers A at root a (32+maxn*type_memory_size tv) /\
+    ptr_covers A at q a 32 ==>
+    ?v B bt.
+      ~v.vs_halted /\ v.vs_current_bb = st1.cs_current_bb /\
+      v.vs_inst_idx = LENGTH st1.cs_current_insts /\
+      value_has_type tv (EL i xs) /\ val_wf tv (EL i xs) /\
+      val_in_memory tv (EL i xs) (d+32+i*type_memory_size tv) v.vs_memory /\
+      calldata_loop_frame ctx fn site middle st1 a (d+32+i*type_memory_size tv)
+        (type_memory_size tv) v /\
+      calldata_loop_joint_rel lo ctx fn PG (a,A,at) (v,B,bt) /\
+      ptr_covers B bt child v (type_memory_size tv) /\
+      (!z. d+32+i*type_memory_size tv <= z /\
+        z < d+32+(i+1)*type_memory_size tv ==> z NOTIN bt.t_mem) /\
+      bt.t_mem SUBSET at.t_mem /\
+      bt.t_stor = at.t_stor /\ bt.t_trans = at.t_trans /\ bt.t_imm = at.t_imm /\
+      allocas_from lo v /\
+      (!z. not_fresh_at middle z ==>
+        lookup_var z v = lookup_var z a /\ FLOOKUP B z = FLOOKUP A z /\
+        op_taint bt (Var z) = op_taint at (Var z))
+End
+
+Theorem calldata_decoder_loop_backedge_ghost_joint:
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME bb /\
+  bb.bb_instructions = prefix ++
+    [mk_inst id ADD [Var iv;Lit 1w] [nv];
+     mk_inst (id+1) MSTORE [Var p;Var nv] [];
+     mk_inst (id+2) JMP [Label hdr] []] /\
+  s.vs_inst_idx = LENGTH prefix /\
+  lookup_block hdr fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  eval_operand (Var iv) s = SOME w /\ eval_operand (Var p) s = SOME dw /\
+  p <> nv /\ ptr_covers G tn p s 32 /\ op_taint tn (Var iv) = {} /\
+  w2n dw + 32 <= s.vs_alloca_next ==>
+  ?H tm.
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) []
+      (OK (jump_to hdr (mstore (w2n dw) (w+1w) (update_var nv (w+1w) s))),H,tm)) /\
+    (!x. x <> nv ==> FLOOKUP H x = FLOOKUP G x /\
+      op_taint tm (Var x) = op_taint tn (Var x)) /\
+    op_taint tm (Var nv) = {} /\
+    ptr_covers H tm p
+      (jump_to hdr (mstore (w2n dw) (w+1w) (update_var nv (w+1w) s))) 32 /\
+    tm.t_mem = tn.t_mem DIFF {a | w2n dw <= a /\ a < w2n dw+32} /\
+    tm.t_stor = tn.t_stor /\ tm.t_trans = tn.t_trans /\ tm.t_imm = tn.t_imm
+Proof
+  strip_tac >>
+  qabbrev_tac `a = mk_inst id ADD [Var iv;Lit 1w] [nv]` >>
+  qabbrev_tac `u = update_var nv (w+1w) s` >>
+  qabbrev_tac `G1 = step_prov PG G a u` >>
+  qabbrev_tac `tn1 = step_taint a s u tn` >>
+  qabbrev_tac `s1 = u with vs_inst_idx := SUC s.vs_inst_idx` >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+     (s,G,tn) [] (OK s1,G1,tn1)` by
+    (simp[NoAsms, Abbr `s1`, Abbr `G1`, Abbr `tn1`, Abbr `u`, Abbr `a`] >>
+     irule calldata_decoder_clean_add_joint >>
+     simp[get_instruction_def, EL_APPEND_EQN, eval_operand_def, op_taint_def]) >>
+  `(!x. x <> nv ==> FLOOKUP G1 x = FLOOKUP G x /\
+    op_taint tn1 (Var x) = op_taint tn (Var x)) /\
+    op_taint tn1 (Var nv) = {}` by
+    (simp[Abbr `G1`, Abbr `tn1`, Abbr `a`, step_prov_def, set_prov_def,
+      step_taint_def, set_var_taint_def, op_taint_def, out_taint_def,
+      mk_inst_def, FLOOKUP_UPDATE, FLOOKUP_DRESTRICT] >>
+     gen_tac >> strip_tac >> CASE_TAC >>
+     simp[FLOOKUP_UPDATE, FLOOKUP_DRESTRICT]) >>
+  `ptr_covers G1 tn1 p s1 32` by
+    (gvs[ptr_covers_def, Abbr `s1`, Abbr `u`, lookup_var_def,
+      update_var_def, FLOOKUP_UPDATE]) >>
+  qabbrev_tac `b = mk_inst (id+1) MSTORE [Var p;Var nv] []` >>
+  qabbrev_tac `v = mstore (w2n dw) (w+1w) s1` >>
+  qabbrev_tac `G2 = step_prov PG G1 b v` >>
+  qabbrev_tac `tn2 = step_taint b s1 v tn1` >>
+  qabbrev_tac `s2 = v with vs_inst_idx := SUC s1.vs_inst_idx` >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s1,G1,tn1) [] (OK s2,G2,tn2)` by
+    (simp[Abbr `s2`, Abbr `G2`, Abbr `tn2`, Abbr `v`, Abbr `b`] >>
+     irule calldata_decoder_clean_store_joint >>
+     gvs[Abbr `s1`, Abbr `u`, update_var_def, eval_operand_def,
+       lookup_var_def, FLOOKUP_UPDATE, allocas_from_def,
+       get_instruction_def, EL_APPEND_EQN] >> metis_tac[]) >>
+  `G2 = G1 /\ (!x. op_taint tn2 (Var x) = op_taint tn1 (Var x))` by
+    simp[Abbr `G2`, Abbr `tn2`, Abbr `b`, step_prov_def,
+      set_prov_def, step_taint_def, set_var_taint_def, mk_inst_def, op_taint_def,
+      DRESTRICT_UNIV] >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s2,G2,tn2) [] (OK (jump_to hdr s2),G2,tn2)` by
+    (irule calldata_decoder_jump_joint >>
+     simp[Abbr `s2`, Abbr `v`, Abbr `s1`, Abbr `u`,
+       mstore_def, update_var_def, allocas_from_def,
+       get_instruction_def, EL_APPEND_EQN, GSYM ADD1,
+       arithmeticTheory.ADD_SUB] >>

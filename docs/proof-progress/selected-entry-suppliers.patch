+        TV ts vals d i mid u G tn /\
+      dp = Var q /\ ptr_covers G tn q u (type_memory_size (EL i ts)) /\
+      op_prov G ep = NONE /\ op_taint tn ep = {} ==>
+      ?v sc B bt.

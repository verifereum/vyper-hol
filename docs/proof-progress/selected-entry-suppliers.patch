+    initial.vs_alloca_next <= v.vs_alloca_next /\
+    (!id q k. FLOOKUP initial.vs_allocas id = SOME (q,k) ==>
+      FLOOKUP v.vs_allocas id = SOME (q,k)) /\
+    (!id. id < st.cs_next_id \/ final.cs_next_id <= id ==>
+      FLOOKUP v.vs_allocas id = FLOOKUP initial.vs_allocas id) /\
+    (!op. abi_decoder_operand_live st.cs_next_var op ==>
+      eval_operand op v = eval_operand op initial) /\
+    abi_decode_footprint_frame ((d,type_memory_size tv)::sc) initial v /\
+    (!q k. MEM (q,k) sc ==> ?id. st.cs_next_id <= id /\ id < final.cs_next_id /\
+      FLOOKUP v.vs_allocas id = SOME (q,k))
+Proof
+  ho_match_mp_tac calldata_coherent_induction >>
+  conj_tac >- suspend "base" >>
+  conj_tac >- suspend "flag" >>
+  conj_tac >- suspend "array" >>
+  conj_tac >- suspend "tuple" >>
+  suspend "struct"
+QED
+
+Resume calldata_exact_owned_run[base]:
+  rpt gen_tac >> strip_tac >> rpt gen_tac >>
+  disch_then (map_every assume_tac o CONJUNCTS) >>
+  `abi_decoder_coherent ce env sf (BaseT bt) (BaseTV bt)` by
+    (irule (cj 1 abi_decoder_coherent_rules) >> asm_rewrite_tac[]) >>
+  Cases_on `is_word_type (BaseT bt)`
+  >- (drule_all calldata_exact_word_owned_run >> disch_then ACCEPT_TAC) >>
+  `is_bytestring_type (BaseT bt)` by
+    (qpat_x_assum `~is_word_type _` mp_tac >>
+     qpat_x_assum `abi_decoder_scalar_valid _` mp_tac >>
+     POP_ASSUM_LIST (K all_tac) >>
+     Cases_on `bt` >> simp[is_word_type_def, is_bytestring_type_def] >>
+     Cases_on `b` >> simp[abi_decoder_scalar_valid_def, is_word_type_def, is_bytestring_type_def]) >>
+  drule_all calldata_exact_bytestring_owned_run >> disch_then ACCEPT_TAC
+QED
+
+Resume calldata_exact_owned_run[flag]:
+  rpt gen_tac >> strip_tac >> rpt gen_tac >>
+  disch_then (map_every assume_tac o CONJUNCTS) >>
+  `abi_decoder_coherent ce env sf (FlagT nsid) (FlagTV n)` by
+    (irule (cj 2 abi_decoder_coherent_rules) >> asm_rewrite_tac[]) >>
+  `is_word_type (FlagT nsid)` by simp[is_word_type_def] >>
+  drule_all calldata_exact_word_owned_run >> disch_then ACCEPT_TAC
+QED
+
+Resume calldata_exact_owned_run[array]:
+  rpt gen_tac >>
+  mp_tac calldata_exact_array_case >>
+  pure_rewrite_tac[LET_THM] >> BETA_TAC >>
+  (impl_tac >- (rpt gen_tac >> MATCH_ACCEPT_TAC calldata_exact_aggregate_owned_run_linked_tail)) >>
+  (impl_tac >- (BETA_TAC >> rpt gen_tac >> strip_tac >> rpt gen_tac >>
+    disch_then (map_every assume_tac o CONJUNCTS) >>
+    `ArrayT ty (Dynamic n) = ArrayT ty (Dynamic n)` by simp[] >>
+    `type_to_abi_dec_info sf ce (ArrayT ty (Dynamic n)) =
+      DecDynArray (type_to_abi_dec_info sf ce ty)
+        (abi_embedded_static_size ce.ce_struct_fields ty)
+        (type_memory_bytes ce ty) F n` by
+      (qpat_x_assum `~is_abi_dynamic _ _` mp_tac >>
+       POP_ASSUM_LIST (K all_tac) >> simp[type_to_abi_dec_info_def]) >>
+    drule_all calldata_exact_bulk_array_owned_run >> disch_then ACCEPT_TAC)) >>
+  disch_then (ACCEPT_TAC o BETA_RULE)
+QED
+Resume calldata_exact_owned_run[tuple]:
+  rpt gen_tac >> mp_tac calldata_exact_tuple_case >>
+  pure_rewrite_tac[LET_THM] >> BETA_TAC >> disch_then (ACCEPT_TAC o BETA_RULE)
+QED
+Resume calldata_exact_owned_run[struct]:
+  rpt gen_tac >> mp_tac calldata_exact_struct_case >>
+  pure_rewrite_tac[LET_THM] >> BETA_TAC >> disch_then (MATCH_ACCEPT_TAC o BETA_RULE)
+QED
+Finalise calldata_exact_owned_run
diff --git a/lowering/calldataExactStaticScript.sml b/lowering/calldataExactStaticScript.sml
new file mode 100644
index 000000000..13b5e96ed
--- /dev/null
+++ b/lowering/calldataExactStaticScript.sml
@@ -0,0 +1,196 @@
+Theory calldataExactStatic
+Ancestors
+  calldataSourceSize calldataSourceDecisions calldataSourceWord
+  calldataReconstruction abiEncoderInputFrame vyperCalldata vyperCalldataProps
+  valueEncodingTyping valueEncodingDefs valueEncoding abiDecoderCoherence
+  memoryValueAbiTuple exprSimAggregateLoops
+  exprLowering compileEnv vyperTyping calldataWordProps entryDecodeProps abiEncoder words list arithmetic
+
+Theorem calldata_exact_static_word[local]:
+  abi_decoder_coherent ce env sf ty tv /\ is_word_type ty /\
+  type_to_abi_dec_info sf ce ty = DecPrimWord NoClamp /\
+  mem_bytes_at d 32 mem = mem_bytes_at pos 32 cd ==>
+  ?x. cd_word_value tv (cd_word cd pos) = SOME x /\
+    value_has_type tv x /\ val_wf tv x /\ val_in_memory tv x d mem
+Proof
+  strip_tac >>
+  `mem_word_at d mem = cd_word cd pos` by
+    gvs[mem_word_at_def, mem_bytes_at_def, cd_word_def, cd_bytes_def] >>
+  `cd_word_value tv (cd_word cd pos) <> NONE` by
+    (drule_all calldata_coherent_word_accepts >> simp[abi_clamp_ok_def]) >>
+  Cases_on `cd_word_value tv (cd_word cd pos)` >> gvs[] >>
+  drule_all calldata_coherent_word_value >> strip_tac >>
+  `value_has_type tv x /\ typed_val_to_w256 tv x = cd_word cd pos` by metis_tac[] >>
+  simp[] >> conj_tac
+  >- (irule (cj 1 value_has_type_val_wf) >> simp[]) >>
+  irule calldata_word_representation >>
+  drule abi_decoder_coherent_header >> simp[abi_decoder_header_def] >>
+  metis_tac[]
+QED
+
+Theorem calldata_exact_static_elems:
+  !n i d. ~tv_abi_dynamic tv /\
+  (!j. j < n ==> ?x.
+    cd_decode T cd tv (pos + (i+j)*type_memory_size tv) = SOME x /\
+    value_has_type tv x /\
+    val_in_memory tv x (d+j*type_memory_size tv) mem) ==>
+  ?vs. cd_decode_elems T cd tv pos i n = SOME vs /\
+    LENGTH vs = n /\ EVERY (value_has_type tv) vs /\
+    elems_in_memory vs d tv mem
+Proof
+  Induct >> simp[cd_decode_def, val_in_memory_def] >> rpt strip_tac >>
+  `?x. cd_decode T cd tv (pos+i*type_memory_size tv) = SOME x /\
+    value_has_type tv x /\ val_in_memory tv x d mem` by
+    (first_x_assum (qspec_then `0` mp_tac) >> simp[]) >>
+  `?vs. cd_decode_elems T cd tv pos (i+1) n = SOME vs /\
+    LENGTH vs = n /\ EVERY (value_has_type tv) vs /\
+    elems_in_memory vs (d+type_memory_size tv) tv mem` by
+    (first_x_assum irule >> simp[] >> rpt strip_tac >>
+     first_x_assum (qspec_then `SUC j` mp_tac) >>
+     asm_simp_tac std_ss [ADD1, ADD_ASSOC, LEFT_ADD_DISTRIB,
+       RIGHT_ADD_DISTRIB] >> metis_tac[ADD_COMM, ADD_ASSOC]) >>
+  qexists_tac `x::vs` >>
+  simp[cd_decode_def, cd_member_ptr_def, cd_at_def,
+       tv_abi_size_def, tv_abi_static_memory_size, val_in_memory_def]
+QED
+
+Theorem calldata_exact_static_list[local]:
+  !tvs ofs d.
+  EVERY (\tv. ~tv_abi_dynamic tv /\
+    !pos d. mem_bytes_at d (type_memory_size tv) mem =
+      mem_bytes_at pos (type_memory_size tv) cd ==>
+    ?x. cd_decode T cd tv pos = SOME x /\ value_has_type tv x /\
+      val_in_memory tv x d mem) tvs /\
+  mem_bytes_at d (type_memory_size_list tvs) mem =
+    mem_bytes_at (pos+ofs) (type_memory_size_list tvs) cd ==>
+  ?vs. cd_decode_list T cd tvs pos ofs = SOME vs /\
+    LIST_REL value_has_type tvs vs /\ tuple_in_memory vs tvs d mem
+Proof
+  Induct >> simp[cd_decode_def, val_in_memory_def] >> rpt strip_tac >>
+  `mem_bytes_at d (type_memory_size h) mem =
+    mem_bytes_at (pos+ofs) (type_memory_size h) cd` by
+    (drule abi_encoder_window_slice >>
+     disch_then (qspecl_then [`0`,`type_memory_size h`] mp_tac) >>
+     simp[type_memory_size_def]) >>
+  `?x. cd_decode T cd h (pos+ofs) = SOME x /\ value_has_type h x /\
+    val_in_memory h x d mem` by metis_tac[] >>
+  `mem_bytes_at (d+type_memory_size h) (type_memory_size_list tvs) mem =
+    mem_bytes_at (pos+(ofs+type_memory_size h)) (type_memory_size_list tvs) cd` by
+    (qpat_x_assum `mem_bytes_at d (type_memory_size h) mem = _` kall_tac >>
+     drule abi_encoder_window_slice >>
+     disch_then (qspecl_then [`type_memory_size h`,`type_memory_size_list tvs`] mp_tac) >>
+     simp_tac std_ss [type_memory_size_def, ADD_ASSOC] >> metis_tac[ADD_COMM]) >>
+  `?vs. cd_decode_list T cd tvs pos (ofs+type_memory_size h) = SOME vs /\
+    LIST_REL value_has_type tvs vs /\
+    tuple_in_memory vs tvs (d+type_memory_size h) mem` by metis_tac[] >>
+  qexists_tac `x::vs` >>
+  simp[cd_decode_def, cd_member_ptr_def, cd_at_def,
+       tv_abi_size_def, tv_abi_static_memory_size, val_in_memory_def] >>
+  `cd_decode T cd h (ofs+pos) = SOME x` by metis_tac[ADD_COMM] >>
+  asm_rewrite_tac[] >> simp[]
+QED
+
+Theorem calldata_exact_static_slice:
+  !ce env sf ty tv. abi_decoder_coherent ce env sf ty tv ==>
+  ~tv_abi_dynamic tv /\ ~tv_needs_clamp tv ==>
+  !cd pos d mem.
+  mem_bytes_at d (type_memory_size tv) mem =
+    mem_bytes_at pos (type_memory_size tv) cd ==>
+  ?x. cd_decode T cd tv pos = SOME x /\ value_has_type tv x /\
+    val_wf tv x /\ val_in_memory tv x d mem
+Proof
+  ho_match_mp_tac abi_decoder_coherent_strongind >> rpt conj_tac
+  >- suspend "scalar"
+  >- suspend "flag"
+  >- suspend "array"
+  >- suspend "tuple"
+  >> suspend "struct"
+QED
+
+Resume calldata_exact_static_slice[scalar]:
+  rpt strip_tac >>
+  `is_word_type (BaseT bt) /\
+   type_to_abi_dec_info (FEMPTY : string |-> (string # type # num) list) ce (BaseT bt) = DecPrimWord NoClamp /\
+   type_memory_size (BaseTV bt) = 32 /\
+   (!nat cd pos. cd_decode nat cd (BaseTV bt) pos =
+     cd_word_value (BaseTV bt) (cd_word cd pos))` by
+    (Cases_on `bt` >>
+     gvs[tv_needs_clamp_def, abi_decoder_scalar_valid_def,
+         is_word_type_def, type_to_abi_dec_info_def, type_to_abi_clamp_def,
+         type_memory_size_def, cd_decode_def] >>
+     rename1 `BytesT b` >> Cases_on `b` >>
+     gvs[tv_needs_clamp_def, abi_decoder_scalar_valid_def,
+         is_word_type_def, type_to_abi_dec_info_def, type_to_abi_clamp_def,
+         type_memory_size_def, cd_decode_def]) >>
+  simp[] >> irule calldata_exact_static_word >>
+  conj_tac >- gvs[] >> qexistsl_tac [`ce`,`env`,`FEMPTY`,`BaseT bt`] >>
+  simp[abi_decoder_coherent_base_iff]
+QED
+Resume calldata_exact_static_slice[flag]:
+  rpt strip_tac >>
+  `n = 256` by gvs[tv_needs_clamp_def] >> gvs[] >>
+  simp[cd_decode_def] >> irule calldata_exact_static_word >>
+  conj_tac >- gvs[type_memory_size_def] >>
+  qexistsl_tac [`ce`,`env`,`FEMPTY`,`FlagT nsid`] >>
+  simp[is_word_type_def, type_to_abi_dec_info_def,
+       abi_decoder_coherent_flag_iff]
+QED
+Resume calldata_exact_static_slice[array]:
+  rpt strip_tac >> Cases_on `bound` >>
+  gvs[tv_abi_dynamic_def, tv_needs_clamp_def] >>
+  `?vs. cd_decode_elems T cd tv pos 0 n = SOME vs /\
+    LENGTH vs = n /\ EVERY (value_has_type tv) vs /\
+    elems_in_memory vs d tv mem` by
+    (irule calldata_exact_static_elems >> simp[] >> rpt strip_tac >>
+     `mem_bytes_at (d+j*type_memory_size tv) (type_memory_size tv) mem =
+      mem_bytes_at (pos+j*type_memory_size tv) (type_memory_size tv) cd` by
+       (drule abi_encoder_window_slice >>
+        disch_then (qspecl_then [`j*type_memory_size tv`,`type_memory_size tv`] mp_tac) >>
+        simp[type_memory_size_def] >> impl_tac
+        >- (irule LESS_EQ_TRANS >> qexists_tac `(j+1)*type_memory_size tv` >>
+            simp[RIGHT_ADD_DISTRIB] >> irule LESS_MONO_MULT >> decide_tac) >>
+        metis_tac[]) >>
+     first_x_assum drule >> simp[] >> metis_tac[]) >>
+  qexists_tac `ArrayV (make_array_value tv (Fixed n) vs)` >>
+  simp[cd_decode_def] >> irule calldata_fixed_values_typed_memory >> simp[]
+QED
+Resume calldata_exact_static_slice[tuple]:
+  rpt strip_tac >>
+  `EVERY (\tv. ~tv_abi_dynamic tv /\
+    !pos d. mem_bytes_at d (type_memory_size tv) mem =
+      mem_bytes_at pos (type_memory_size tv) cd ==>
+    ?x. cd_decode T cd tv pos = SOME x /\ value_has_type tv x /\
+      val_in_memory tv x d mem) tvs` by
+    (gvs[tv_abi_dynamic_def, tv_needs_clamp_def,
+         tv_abi_dynamic_list_exists, tv_needs_clamp_list_exists,
+         EVERY_EL, LIST_REL_EL_EQN, EXISTS_MEM, MEM_EL] >> metis_tac[]) >>
+  `?vs. cd_decode_list T cd tvs pos 0 = SOME vs /\
+    LIST_REL value_has_type tvs vs /\ tuple_in_memory vs tvs d mem` by
+    (irule calldata_exact_static_list >> simp[] >>
+     gvs[type_memory_size_def]) >>
+  qexists_tac `ArrayV (TupleV vs)` >> simp[cd_decode_def] >>
+  irule calldata_tuple_values_typed_memory >> simp[]
+QED
+Resume calldata_exact_static_slice[struct]:
+  rpt strip_tac >>
+  `LENGTH args = LENGTH tvs` by gvs[LIST_REL_EL_EQN] >>
+  `MAP SND (ZIP (MAP FST args,tvs)) = tvs` by simp[MAP_ZIP] >>
+  `EVERY (\tv. ~tv_abi_dynamic tv /\
+    !pos d. mem_bytes_at d (type_memory_size tv) mem =
+      mem_bytes_at pos (type_memory_size tv) cd ==>
+    ?x. cd_decode T cd tv pos = SOME x /\ value_has_type tv x /\
+      val_in_memory tv x d mem) tvs` by
+    (gvs[tv_abi_dynamic_def, tv_needs_clamp_def,
+         tv_abi_dynamic_fields_map, tv_needs_clamp_fields_map,
+         tv_abi_dynamic_list_exists, tv_needs_clamp_list_exists,
+         EVERY_EL, LIST_REL_EL_EQN, EXISTS_MEM, MEM_EL] >> metis_tac[]) >>
+  `?vs. cd_decode_list T cd tvs pos 0 = SOME vs /\
+    LIST_REL value_has_type tvs vs /\ tuple_in_memory vs tvs d mem` by
+    (irule calldata_exact_static_list >> simp[] >>
+     gvs[type_memory_size_def, type_memory_size_fields_list]) >>
+  qexists_tac `StructV (ZIP (MAP FST args,vs))` >> simp[cd_decode_def, MAP_ZIP] >>
+  irule calldata_struct_values_typed_memory >> conj_tac
+  >- (gvs[LIST_REL_EL_EQN, EL_ZIP, EL_MAP]) >>
+  irule struct_tuple_memory_post >> simp[]
+QED
+Finalise calldata_exact_static_slice
diff --git a/lowering/calldataExactStructAssemblyScript.sml b/lowering/calldataExactStructAssemblyScript.sml
new file mode 100644
index 000000000..2fbc6fef8
--- /dev/null
+++ b/lowering/calldataExactStructAssemblyScript.sml
@@ -0,0 +1,251 @@
+Theory calldataExactStructAssembly
+Ancestors
+  calldataExactMembers calldataExactLinkedMembers calldataRecursiveProducers
+  calldataSourceCorrespondence calldataSourceDecisions calldataSourceSize abiDecoderCoherence
+  abiDecoderAppend abiDecoderMemberInfos calldataAggregateTyped
+  abiCallerAllocation exprLowering valueEncodingDefs vyperCalldata
+  arithmetic list rich_list words compileEnv abiEncoder
+
+Theorem calldata_exact_struct_case:
+  let R = \ce env sf ty tv.
+    !dst src st final fn initial p d ctx site oid base_addr cap.
+    compile_abi_decode_to_buf dst src CALLDATALOAD (Lit 0w) (Lit 0w)
+      (type_to_abi_dec_info sf ce ty) st = ((),final) /\
+    fn_has_code st final fn /\
+    eval_operand src initial = SOME p /\ eval_operand dst initial = SOME (n2w d) /\
+    abi_decoder_operand_live st.cs_next_var src /\
+    abi_decoder_operand_live st.cs_next_var dst /\
+    alloca_inv initial /\ alloca_frontier_inv ctx fn site initial /\
+    (!id q k. st.cs_next_id <= id /\ id < final.cs_next_id /\
+      FLOOKUP initial.vs_allocas id = SOME (q,k) ==>
+      k = 32 /\ q < dimword (:256) /\ q+32 <= initial.vs_alloca_next /\
+      ?ins. MEM ins (fn_insts fn) /\ ins.inst_id = id /\
+        ins.inst_opcode = ALLOCA /\ ins.inst_operands = [Lit 32w]) /\
+    FLOOKUP initial.vs_allocas oid = SOME (base_addr,cap) /\
+    (oid < st.cs_next_id \/ final.cs_next_id <= oid) /\
+    base_addr <= d /\ d+type_memory_size tv <= base_addr+cap /\
+    d+type_memory_size tv < dimword (:256) /\
+    ~initial.vs_halted /\ initial.vs_current_bb = st.cs_current_bb /\
+    initial.vs_inst_idx = LENGTH st.cs_current_insts /\
+    ALL_DISTINCT (MAP (\ins. ins.inst_id) (fn_insts fn)) /\
+    unit_alloca_budget ctx < dimword (:256) /\
+    (final.cs_current_insts = [] ==>
+      !bb. lookup_block final.cs_current_bb fn.fn_blocks = SOME bb ==>
+        phi_prefix_length bb.bb_instructions = 0) ==>
+    (cd_decode F initial.vs_call_ctx.cc_calldata tv (w2n p) = NONE /\
+      ?fuel z. run_from fuel ctx fn initial = Abort Revert_abort z /\
+        mem_safe_run fuel ctx fn initial) \/
+    ?v x sc. cd_decode F initial.vs_call_ctx.cc_calldata tv (w2n p) = SOME x /\
+      ~v.vs_halted /\ v.vs_current_bb = final.cs_current_bb /\
+      v.vs_inst_idx = LENGTH final.cs_current_insts /\ value_has_type tv x /\
+      val_wf tv x /\ val_in_memory tv x d v.vs_memory /\
+      (!fuel r. run_from fuel ctx fn v = r /\ (!err. r <> Error err) ==>
+        ?fuel'. run_from fuel' ctx fn initial = r /\
+          (mem_safe_run fuel ctx fn v ==> mem_safe_run fuel' ctx fn initial)) /\
+      v.vs_call_ctx = initial.vs_call_ctx /\ v.vs_data_section = initial.vs_data_section /\
+      alloca_inv v /\ alloca_frontier_inv ctx fn site v /\
+      (!id q k. st.cs_next_id <= id /\ id < final.cs_next_id /\
+        FLOOKUP v.vs_allocas id = SOME (q,k) ==>
+        k = 32 /\ q < dimword (:256) /\ q+32 <= v.vs_alloca_next /\
+        ?ins. MEM ins (fn_insts fn) /\ ins.inst_id = id /\
+          ins.inst_opcode = ALLOCA /\ ins.inst_operands = [Lit 32w]) /\
+      initial.vs_alloca_next <= v.vs_alloca_next /\
+      (!id q k. FLOOKUP initial.vs_allocas id = SOME (q,k) ==>
+        FLOOKUP v.vs_allocas id = SOME (q,k)) /\
+      (!id. id < st.cs_next_id \/ final.cs_next_id <= id ==>
+        FLOOKUP v.vs_allocas id = FLOOKUP initial.vs_allocas id) /\
+      (!op. abi_decoder_operand_live st.cs_next_var op ==>
+        eval_operand op v = eval_operand op initial) /\
+      abi_decode_footprint_frame ((d,type_memory_size tv)::sc) initial v /\
+      (!q k. MEM (q,k) sc ==> ?id. st.cs_next_id <= id /\ id < final.cs_next_id /\
+        FLOOKUP v.vs_allocas id = SOME (q,k))
+  in
+  FLOOKUP env nsid = SOME (StructArgs args) /\
+  FLOOKUP sf (nsid_to_string nsid) = SOME fields /\
+  MAP (\(name,ty,sz). (name,ty)) fields = args /\
+  EVERY (\(name,ty,sz). sz = type_memory_bytes ce ty) fields /\
+  LIST_REL (\ty tv.
+    abi_decoder_coherent ce (env \\ nsid) (sf \\ nsid_to_string nsid) ty tv /\
+    R ce (env \\ nsid) (sf \\ nsid_to_string nsid) ty tv) (MAP SND args) tvs /\
+  abi_decoder_header ce env (StructT nsid) (StructTV (ZIP (MAP FST args,tvs))) ==>
+  R ce env sf (StructT nsid) (StructTV (ZIP (MAP FST args,tvs)))
+Proof
+  pure_rewrite_tac[LET_THM] >> BETA_TAC >> strip_tac >>
+  `LIST_REL (abi_decoder_coherent ce (env \\ nsid) (sf \\ nsid_to_string nsid))
+    (MAP SND args) tvs` by
+    (qpat_assum `LIST_REL _ (MAP SND args) tvs` mp_tac >>
+     ho_match_mp_tac listTheory.LIST_REL_mono >>
+     rpt gen_tac >> strip_tac >> first_assum ACCEPT_TAC) >>
+  qpat_x_assum `LIST_REL (\ty tv. _ /\ _) _ tvs` mp_tac >>
+  qmatch_goalsub_abbrev_tac `LIST_REL ih (MAP SND args) tvs` >> disch_tac >>
+  `abi_decoder_coherent ce env sf (StructT nsid) (StructTV (ZIP (MAP FST args,tvs)))` by
+    (qpat_x_assum `Abbrev (ih = _)` kall_tac >>
+     irule (cj 5 abi_decoder_coherent_rules) >> asm_rewrite_tac[] >>
+     qexists `fields` >> asm_rewrite_tac[]) >>
+  BETA_TAC >> rpt gen_tac >> disch_then (map_every assume_tac o CONJUNCTS) >>
+  `MAP (FST o SND) fields = MAP SND args` by
+    (qpat_x_assum `MAP _ fields = args` (SUBST1_TAC o SYM) >>
+     simp[MAP_MAP_o, combinTheory.o_DEF, pairTheory.LAMBDA_PROD]) >>
+  drule abi_decoder_struct_infos >> disch_then (qspec_then `ce` mp_tac) >>
+  disch_then (fn th => qpat_assum `MAP (FST o SND) fields = _`
+    (fn eq => assume_tac (PURE_REWRITE_RULE [eq] th))) >>
+  drule calldata_member_indexed_metadata >> strip_tac >>

+(* Earlier packed slots are protected by the parent owner, even when the
+   child's scratch footprint includes allocations inside its ID interval. *)
+Theorem calldata_aggregate_prefix_bytes:
+  abi_decode_footprint_frame ((e,type_memory_size (EL i ts))::sc) u v /\
+  alloca_inv v /\
+  (!id. id < mid.cs_next_id \/ b.cs_next_id <= id ==>
+    FLOOKUP v.vs_allocas id = FLOOKUP u.vs_allocas id) /\
+  (oid < mid.cs_next_id \/ b.cs_next_id <= oid) /\
+  FLOOKUP u.vs_allocas oid = SOME (base_addr,cap) /\
+  base_addr <= d /\ d + SUM (MAP type_memory_size (TAKE i ts)) = e /\
+  e + type_memory_size (EL i ts) <= base_addr + cap /\
+  (!q k. MEM (q,k) sc ==> ?id. mid.cs_next_id <= id /\ id < b.cs_next_id /\
+    FLOOKUP v.vs_allocas id = SOME (q,k)) ==>
+  !j. j < i /\ i < LENGTH ts ==>
+    mem_bytes_at (d + SUM (MAP type_memory_size (TAKE j ts)))
+      (type_memory_size (EL j ts)) v.vs_memory =
+    mem_bytes_at (d + SUM (MAP type_memory_size (TAKE j ts)))
+      (type_memory_size (EL j ts)) u.vs_memory
+Proof
+  strip_tac >> rpt gen_tac >> strip_tac >>
+  `SUM (MAP type_memory_size (TAKE j ts)) + type_memory_size (EL j ts) <=
+    SUM (MAP type_memory_size (TAKE i ts))` by
+    (qspecl_then [`type_memory_size`,`TAKE i ts`,`j`] mp_tac
+       abiEncoderInputTheory.abi_encoder_prefix_sum_bound >>
+     simp[TAKE_TAKE, MIN_DEF, EL_TAKE]) >>
+  irule (cj 2 calldataChildFrameTheory.calldata_child_preserves_allocated_region) >>
+  qpat_assum `abi_decode_footprint_frame _ u v` (irule_at Any) >>
+  qpat_assum `FLOOKUP u.vs_allocas oid = SOME _` (irule_at Any) >>
+  qexistsl_tac [`mid.cs_next_id`,`b.cs_next_id`] >> simp[] >> metis_tac[]
+QED

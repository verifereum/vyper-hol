+(* Source/package specialization on the actual dispatched calldata. *)
+Theory dispatchedRegistrationJoint
+Ancestors
+  dispatchedRegistrationPositionalCertificate dispatchedRegistrationStep
+  dispatchedEntryFacts dispatchedRegistrationSourceResources
+  entrySelectedPackageCoherence compileVyper e2eDefs vyperLoweringCorrect
+  dispatchedRegistrationPrefixResources dispatchedRegistrationResultDefs
+  registrationSizeAdmissibility venomInst venomState bodyPtrDefs
+  entryRegistrationCursorHistory moduleLowering
+  gasPathPtrExec fragGasOriginPtr fragGasPathMem
+  finite_map words list arithmetic
+
+Theorem dispatched_package_parameter_locations[local]:
+  ALL_DISTINCT (MAP FST args) /\
+  set_external_package_target target
+    (package_external_fn tops ut nk (mut,nr,rr,name,args,dflts,ret,fbody)) =
+    (lbl,ce,pos,mincd,pay,nr',key,ut',iv,fbody',rt) ==>
+  EVERY (\a. ?off. FLOOKUP ce.ce_vars (FST a) =
+    SOME (MemLoc off (type_memory_bytes ce (SND a)))) args
+Proof
+  strip_tac >>
+  Cases_on `package_external_fn tops ut nk (mut,nr,rr,name,args,dflts,ret,fbody)` >>
+  PairCases_on `r` >> gvs[set_external_package_target_def] >>
+  drule_all entryStateRelTheory.package_external_fn_vars >> strip_tac >>
+  `!ty. type_memory_bytes (r0 with ce_target := target) ty = type_memory_bytes r0 ty` by
+    (gen_tac >> irule compileEnvTheory.type_memory_bytes_struct_fields >> simp[]) >>
+  gvs[]
+QED
+
+Theorem dispatched_registration_joint:
+  lower_vyper_runtime_unit tops rpolicy = SOME unit /\
+  supported_program tops /\ source_typing_ok tops am tx /\
+  calldata_dispatch tops vs.vs_call_ctx.cc_calldata =
+    SOME (tx.function_name,tx.args) /\
+  tx.function_name <> "__default__" /\
+  initial_venom_state_rel tops am tx vs /\
+  vyperInterpreter$lookup_function NONE tx.function_name External tops =
+    SOME (mut,F,args,[],ret,fbody) /\
+  bind_arguments (type_env tops) args tx.args = SOME env /\
+  set_external_package_target rpolicy.rpol_target
+    (package_external_fn tops T (K global_nonreentrant_slot)
+      (mut,F,lookup_raw_return_or_F (NONE:num option) tx.function_name External tops,
+       tx.function_name,args,([]:expr list),ret,fbody)) =
+    (lbl,ce,pos,mincd,pay,F,nkey,ut,iv,fbody,rt) /\
+  compile_register_positional_args ce pos 4 st = (cef,sa) /\
+  compile_entry_checks mincd pay opened = ((),st) /\
+  opened.cs_current_insts = [] /\
+  fn_has_code opened st fn /\
+  venomInst$lookup_function "__entry" unit.cu_context.ctx_functions = SOME fn /\
+  fn_has_code st sa fn /\ fn_inst_ids_distinct fn /\
+  vars_pc_only (vs with <|vs_prev_bb := NONE; vs_current_bb := elbl;
+                         vs_inst_idx := 0|>) s /\
+  fresh_vars_wrt st s /\ ~s.vs_halted /\
+  s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts ==>
+  ?tvs specs v H u owners outputs.
+    OPT_MMAP (evaluate_type (type_env tops)) (MAP SND args) = SOME tvs /\
+    MAP (\(name,prim,dyn,sz,ty,tv).
+      (name,prim,dyn,sz,type_to_abi_dec_info ce.ce_struct_fields ce ty)) specs = pos /\
+    MAP (\(name,prim,dyn,sz,ty,tv). ((name,ty),tv)) specs = ZIP (args,tvs) /\
+    registration_result unit.cu_context fn site 0 [] st sa sa s G tn []
+      cef specs tx.args v H u owners outputs /\
+    MAP (\(x,dst,p,id). x) outputs = tx.args /\
+    LIST_REL (\((name,ty),tv) (x,dst,p,id).
+      ?root ins. dst = Var root /\
+        FLOOKUP cef.ce_vars name = SOME (PtrVar dst (type_memory_size tv)) /\
+        MEM ins (fn_insts fn) /\ ins.inst_opcode = ALLOCA /\
+        ins.inst_outputs = [root] /\ ins.inst_id = id /\
+        not_fresh_at sa root /\ id < sa.cs_next_id /\
+        lookup_var root v = SOME (n2w p) /\
+        FLOOKUP v.vs_allocas id = SOME (p,type_memory_size tv) /\
+        FLOOKUP H root = SOME (p,type_memory_size tv) /\
+        ptr_covers H u root v (type_memory_size tv) /\
+        value_has_type tv x /\ val_wf tv x /\
+        (!m. mem_agree_outside u.t_mem v.vs_memory m ==>
+          val_in_memory tv x p m)) (ZIP (args,tvs)) outputs /\
+    ~v.vs_halted /\ v.vs_current_bb = sa.cs_current_bb /\
+    v.vs_inst_idx = LENGTH sa.cs_current_insts /\
+    alloca_history fn v /\ abi_alloca_history (fn_insts fn) v /\
+    alloca_inv v /\ alloca_frontier_inv unit.cu_context fn site v /\
+    fresh_vars_wrt sa v /\ allocas_from 0 v /\
+    entry_decoder_obs s v /\
+    u.t_stor = tn.t_stor /\ u.t_trans = tn.t_trans /\ u.t_imm = tn.t_imm /\
+    gas_path_mem unit.cu_context fn s 0 (OK v) /\
+    (!D explicit. gas_origin_ptr_path (D,0,explicit,unit.cu_context,fn,[])
+      (s,G,tn) [] (OK v,H,u)) /\
+    (!D. (!fuel. ptr_safe_run D 0 fuel unit.cu_context fn [] H u v) ==>
+      !fuel. ptr_safe_run D 0 fuel unit.cu_context fn [] G tn s) /\
+    (!fuel r. run_from fuel unit.cu_context fn v = r /\ (!err. r <> Error err) ==>
+      ?fuel'. run_from fuel' unit.cu_context fn s = r /\
+        (mem_safe_run fuel unit.cu_context fn v ==>
+          mem_safe_run fuel' unit.cu_context fn s)) /\
+    ((!fuel. mem_safe_run fuel unit.cu_context fn v) ==>
+      !fuel. mem_safe_run fuel unit.cu_context fn s)
+Proof
+  strip_tac >>
+  drule_all dispatched_decode_inputs >> strip_tac >>
+  drule_all selected_external_package_evaluated_metadata >> strip_tac >>
+  `~ctx_has_dalloca unit.cu_context` by
+    metis_tac[dispatched_registration_supported_no_dalloca] >>
+  drule_all dispatched_registration_initial_ptr_resources >>
+  disch_then (qspec_then `site` strip_assume_tac) >>
+  `st.cs_next_var <= sa.cs_next_var` by
+    metis_tac[calldataRegistrationExecTheory.registration_compile_counters] >>
+  `dispatched_registration_caller unit.cu_context fn site 0
+     ([]:(num # num) option list) st sa s G tn []` by
+    suspend "caller" >>
+  `LIST_REL (\(name,ty) (ty',tv).
+    ty = ty' /\ abi_decoder_coherent ce (type_env tops) ce.ce_struct_fields ty tv /\
+    (?loc. FLOOKUP ce.ce_vars name = SOME loc /\
+      var_location_memory_size loc = SOME (type_memory_size tv)) /\
+    type_memory_size tv < dimword (:256)) args (ZIP (MAP SND args,tvs))` by
+    suspend "metadata" >>
+  `4 + SUM (MAP tv_abi_size tvs) < dimword (:256)` by
+    suspend "head_bound" >>
+  `ALL_DISTINCT (MAP (\i. i.inst_id) (fn_insts fn))` by
+    fs[venomWfTheory.fn_inst_ids_distinct_def, fn_insts_def,
+       venomInstIdsPropsTheory.fn_insts_blocks_map_id] >>
+  mp_tac (GEN_ALL (MATCH_MP registration_positional_certificate_from_step
+    registration_singleton_joint)) >>
+  suspend "certificate"
+QED
+
+Resume dispatched_registration_joint[caller]:
+  `alloca_history fn s` by metis_tac[entry_checks_cursor_alloca_history] >>
+  `fresh_vars_wrt sa s` by
+    (irule emitHelperPropsTheory.fresh_vars_wrt_mono >>
+     qexists_tac `st` >> simp[]) >>
+  irule dispatched_registration_caller_empty >>
+  simp[abiAllocationHistoryTheory.abi_alloca_history_empty]
+QED
+Resume dispatched_registration_joint[metadata]:
+  drule_all dispatched_package_parameter_locations >> strip_tac >>
+  drule_all dispatched_registration_external_allocs_ok >> strip_tac >>
+  `ALL_DISTINCT (FLAT (MAP (type_def_keys_toplevel (NONE:num option)) tops))` by
+    metis_tac[entryStateRelTheory.source_typing_ok_type_def_keys_distinct] >>
+  drule vyperTypeABITheory.OPT_MMAP_LIST_REL >>
+  simp[LIST_REL_EL_EQN] >> strip_tac >>
+  rpt strip_tac >>
+  `n < LENGTH args` by gvs[LIST_REL_EL_EQN] >>
+  `MEM (EL n args) args` by simp[EL_MEM] >>
+  `evaluate_type (type_env tops) (SND (EL n args)) = SOME (EL n tvs)` by
+    (first_x_assum (qspec_then `n` mp_tac) >> simp[EL_MAP]) >>
+  `?off. FLOOKUP ce.ce_vars (FST (EL n args)) =
+     SOME (MemLoc off (type_memory_bytes ce (SND (EL n args))))` by
+    fs[EVERY_MEM] >>
+  `type_memory_size (EL n tvs) < 2 ** 64` by
+    (irule registration_parameter_memory_limit >>
+     goal_assum (drule_at Any) >> simp[] >>
+     goal_assum (drule_at Any) >> simp[] >>
+     qexists_tac `FST (EL n args)` >> simp[]) >>
+  `2 ** 64 < dimword (:256)` by
+    (rewrite_tac[dimword_def, fcpTheory.index_bit0, fcpTheory.finite_bit0,
+       fcpTheory.index_one, fcpTheory.finite_one] >> EVAL_TAC) >>
+  fs[LIST_REL_EL_EQN, EL_MAP, EL_ZIP] >>
+  qpat_x_assum `!i. i < LENGTH tvs ==> _ /\ _ /\ _`
+    (qspec_then `n` mp_tac) >> simp[] >> strip_tac >>
+  Cases_on `EL n args` >> gvs[var_location_memory_size_def] >> decide_tac
+QED
+Resume dispatched_registration_joint[head_bound]:
+  `LENGTH vs.vs_call_ctx.cc_calldata < dimword (:256)` by
+    (fs[initial_venom_state_rel_def, venom_env_rel_def, loweringStateRelDefsTheory.call_ctx_rel_def,
+        e2eDefsTheory.source_typing_ok_def,
+        vyperTypeContractSoundnessTheory.call_tx_well_typed_def] >>
+     gvs[wordsTheory.dimword_def]) >>
+  decide_tac
+QED
+Resume dispatched_registration_joint[certificate]:
+  `LENGTH (MAP SND args) = LENGTH tvs` by
+    metis_tac[LIST_REL_LENGTH] >>
+  disch_then drule >> simp[MAP_ZIP] >>
+  disch_then (drule_at (Pat `dispatched_registration_caller`)) >>
+  gvs[] >>
+  `!bb. lookup_block sa.cs_current_bb fn.fn_blocks = SOME bb ==>
+    phi_prefix_length bb.bb_instructions = 0` by metis_tac[] >>
+  simp[] >> strip_tac >>
+  qexistsl_tac [`specs`, `v`, `H`, `u`, `owners`, `outputs`] >>
+  simp[] >>
+  qpat_assum `registration_result _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _`
+    (strip_assume_tac o REWRITE_RULE [registration_result_def]) >>
+  drule dispatched_registration_caller_cursor >> strip_tac >>
+  fs[dispatched_registration_caller_def] >>
+  fs[dispatchedDecoderLoopCaseJointTheory.calldata_loop_joint_rel_def] >>
+  conj_tac
+  >- (qpat_assum `!D explicit. gas_origin_ptr_path _ _ _ _`
+        (mp_tac o Q.SPECL [`D`, `explicit`]) >>
+      disch_then (strip_assume_tac o MATCH_MP gas_origin_ptr_path_projections) >>
+      drule fragGasOriginTheory.gas_origin_path_erase >>
+      simp[fragGasModeTheory.gas_marked_path_def]) >>
+  gen_tac >> disch_tac >> irule gas_path_ptr_safe_run >>
+  conj_tac >- metis_tac[] >>
+  qexistsl_tac [`H`, `0`, `v`, `u`] >> simp[] >>
+  qpat_assum `!D explicit. gas_origin_ptr_path _ _ _ _`
+        (mp_tac o Q.SPECL [`D`, `explicit`]) >>
+  disch_then (strip_assume_tac o MATCH_MP gas_origin_ptr_path_projections) >>

+Theorem calldata_reentrant_loop_iterate:
+  let H = calldata_reentrant_loop_invariant ctx fn site lo st last initial
+        initial_G initial_tn header hdr src srcword root q p oid base_addr cap
+        d tv maxn xs;
+      Q = calldata_reentrant_loop_output ctx fn site lo st last initial
+        initial_G initial_tn root d tv maxn xs;
+      J = calldata_loop_framed_joint_rel cutoff lo ctx fn PG
+  in
+  J (initial,initial_G,initial_tn) start /\ H 0 start /\
+  (!i a. i < LENGTH xs /\ H i a ==> ?b. H (SUC i) b /\ J a b) /\
+  (!a. H (LENGTH xs) a ==> ?b. Q b /\ J a b) ==>
+  ?b. Q b /\ J (initial,initial_G,initial_tn) b
+Proof
+  simp_tac bool_ss [LET_THM] >>
+  qmatch_goalsub_abbrev_tac `H 0 start` >>
+  qabbrev_tac `Q = calldata_reentrant_loop_output ctx fn site lo st last initial
+    initial_G initial_tn root d tv maxn xs` >>
+  strip_tac >>
+  `!n. n <= LENGTH xs ==> ?a. H n a /\
+    calldata_loop_framed_joint_rel cutoff lo ctx fn PG
+      (initial,initial_G,initial_tn) a` by
+    (Induct >- metis_tac[] >> strip_tac >>
+     `n <= LENGTH xs /\ n < LENGTH xs` by decide_tac >>
+     `?a. H n a /\ calldata_loop_framed_joint_rel cutoff lo ctx fn PG
+        (initial,initial_G,initial_tn) a` by metis_tac[] >>
+     `?b. H (SUC n) b /\ calldata_loop_framed_joint_rel cutoff lo ctx fn PG a b`
+       by metis_tac[] >>
+     metis_tac[calldata_loop_framed_joint_rel_trans]) >>
+  metis_tac[calldata_loop_framed_joint_rel_trans, LESS_EQ_REFL]
+QED
+
+Theorem calldata_reentrant_loop_iterate_history:
+  let H = calldata_reentrant_loop_invariant ctx fn site lo st last initial
+        initial_G initial_tn header hdr src srcword root q p oid base_addr cap
+        d tv maxn xs;
+      Q = calldata_reentrant_loop_output ctx fn site lo st last initial
+        initial_G initial_tn root d tv maxn xs;
+      J = calldata_loop_framed_joint_rel cutoff lo ctx fn PG
+  in
+  J (initial,initial_G,initial_tn) start /\ H 0 start /\
+  (!i a. i < LENGTH xs /\ H i a ==> ?b. H (SUC i) b /\ J a b) /\
+  (!a. H (LENGTH xs) a /\ J (initial,initial_G,initial_tn) a ==>
+    ?b. Q b /\ J a b) ==>
+  ?b. Q b /\ J (initial,initial_G,initial_tn) b
+Proof
+  simp_tac bool_ss [LET_THM] >>
+  qmatch_goalsub_abbrev_tac `H 0 start` >>
+  qabbrev_tac `Q = calldata_reentrant_loop_output ctx fn site lo st last initial
+    initial_G initial_tn root d tv maxn xs` >>
+  strip_tac >>
+  `!n. n <= LENGTH xs ==> ?a. H n a /\
+    calldata_loop_framed_joint_rel cutoff lo ctx fn PG
+      (initial,initial_G,initial_tn) a` by
+    (Induct >- metis_tac[] >> strip_tac >>
+     `n <= LENGTH xs /\ n < LENGTH xs` by decide_tac >>
+     `?a. H n a /\ calldata_loop_framed_joint_rel cutoff lo ctx fn PG
+        (initial,initial_G,initial_tn) a` by metis_tac[] >>
+     `?b. H (SUC n) b /\ calldata_loop_framed_joint_rel cutoff lo ctx fn PG a b`
+       by metis_tac[] >>
+     metis_tac[calldata_loop_framed_joint_rel_trans]) >>
+  metis_tac[calldata_loop_framed_joint_rel_trans, LESS_EQ_REFL]
+QED
+
+Theorem calldata_reentrant_loop_iterate_history_rel:
+  let H = calldata_reentrant_loop_invariant ctx fn site lo st last initial
+        initial_G initial_tn header hdr src srcword root q p oid base_addr cap
+        d tv maxn xs;
+      Q = calldata_reentrant_loop_output ctx fn site lo st last initial
+        initial_G initial_tn root d tv maxn xs;
+      J = \a b. calldata_loop_framed_joint_rel cutoff lo ctx fn PG a b /\
+        R (FST a) (FST b)
+  in
+  (!a b c. R a b /\ R b c ==> R a c) /\
+  J (initial,initial_G,initial_tn) start /\ H 0 start /\
+  (!i a. i < LENGTH xs /\ H i a ==> ?b. H (SUC i) b /\ J a b) /\
+  (!a. H (LENGTH xs) a /\ J (initial,initial_G,initial_tn) a ==>
+    ?b. Q b /\ J a b) ==>
+  ?b. Q b /\ J (initial,initial_G,initial_tn) b
+Proof
+  simp_tac bool_ss [LET_THM] >>
+  qmatch_goalsub_abbrev_tac `H 0 start` >>
+  qabbrev_tac `Q = calldata_reentrant_loop_output ctx fn site lo st last initial
+    initial_G initial_tn root d tv maxn xs` >>
+  qabbrev_tac `J = \a b. calldata_loop_framed_joint_rel cutoff lo ctx fn PG a b /\
+    R (FST a) (FST b)` >>
+  strip_tac >>
+  `!a b c. J a b /\ J b c ==> J a c` by
+    (simp_tac bool_ss [Abbr `J`] >> metis_tac[calldata_loop_framed_joint_rel_trans]) >>
+  `!n. n <= LENGTH xs ==> ?a. H n a /\ J (initial,initial_G,initial_tn) a` by
+    (Induct >- metis_tac[] >> strip_tac >>
+     `n <= LENGTH xs /\ n < LENGTH xs` by decide_tac >>
+     `?a. H n a /\ J (initial,initial_G,initial_tn) a` by metis_tac[] >>
+     `?b. H (SUC n) b /\ J a b` by metis_tac[] >> metis_tac[]) >>
+  qpat_x_assum `!n. n <= LENGTH xs ==> _`
+    (qspec_then `LENGTH xs` mp_tac) >> simp_tac bool_ss [LESS_EQ_REFL] >>
+  strip_tac >>
+  qpat_x_assum `!a. H (LENGTH xs) a /\ _ ==> _`
+    (qspec_then `a` mp_tac) >>
+  (impl_tac >- fs[Abbr `J`]) >> strip_tac >>
+  qexists_tac `b` >> simp_tac bool_ss [] >>
+  qpat_x_assum `J (initial,initial_G,initial_tn) a` mp_tac >>
+  simp_tac bool_ss [Abbr `J`] >>
+  metis_tac[calldata_loop_framed_joint_rel_trans]
+QED

+Theorem calldata_reentrant_loop_exit_joint:
+  lookup_block hdr fn.fn_blocks = SOME
+    <|bb_label := hdr; bb_instructions :=
+      abi_decode_header_insts id (Var q) src CALLDATALOAD iv cv cmp done body_lbl exit|> /\
+  lookup_block exit fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  last.cs_current_bb = exit /\ last.cs_current_insts = [] /\
+  ~ctx_has_dalloca ctx /\ p < dimword (:256) /\ p+32 <= s.vs_alloca_next /\
+  LENGTH xs < dimword (:256) /\
+  abi_decode_load CALLDATALOAD srcword s = n2w (LENGTH xs) /\
+  (!v. MEM v [iv;cv;cmp;done] ==> q <> v /\ root <> v /\ src <> Var v) /\
+  iv <> cv /\
+  (!v z. MEM v [iv;cv;cmp;done] /\ not_fresh_at st z ==> z <> v) /\
+  (!r. last.cs_next_var <= r ==>
+    ~MEM (STRING #"%" (toString r)) [iv;cv;cmp;done]) /\
+  future_frame last.cs_next_var initial s /\ last.cs_next_var <= cutoff /\
+  calldata_reentrant_loop_invariant ctx fn site lo st last initial initial_G initial_tn
+    header hdr src srcword root q p oid base_addr cap d tv maxn xs (LENGTH xs) (s,G,tn) ==>
+  ?b. calldata_reentrant_loop_output ctx fn site lo st last initial initial_G initial_tn
+        root d tv maxn xs b /\
+      calldata_loop_framed_joint_rel cutoff lo ctx fn PG (s,G,tn) b
+Proof
+  strip_tac >> drule_all calldata_reentrant_loop_exit_joint_companion >>
+  disch_then (qspec_then `PG` strip_assume_tac) >>
+  qexists_tac `b` >> simp[]
+QED

+     p+32 <= s.vs_alloca_next /\ s.vs_alloca_next < dimword (:256))) /\
+  fn_has_code sa sb fn /\ allocas_from lo s /\ lo <= s.vs_alloca_next /\
+  d+32 <= s.vs_alloca_next /\ ~ctx_has_dalloca ctx /\
+  s.vs_current_bb = sa.cs_current_bb /\ s.vs_inst_idx = LENGTH sa.cs_current_insts /\
+  lookup_block sb.cs_current_bb fn.fn_blocks = SOME jumpbb /\
+  get_instruction jumpbb (LENGTH sb.cs_current_insts) = SOME (mk_inst jid JMP [Label hdr] []) /\
+  lookup_block hdr fn.fn_blocks = SOME target /\ phi_prefix_length target.bb_instructions = 0 /\

+Theorem calldata_member_address_frontier_joint:
+  (do ep <- compile_getelemptr_abi src dyn ao CALLDATALOAD (Lit 0w) (Lit 0w);
+      dp <- emit_op ADD [Var root; Lit (n2w vo)]; return (ep,dp) od) st = ((ep,dp),fin) /\
+  fn_has_code st fin func /\ ~ctx_has_dalloca ctx /\
+  s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts /\ ~s.vs_halted /\
+  fresh_vars_wrt st s /\ eval_operand src s = SOME p /\
+  lookup_var root s = SOME a /\ not_fresh_at st root /\
+  (!q. src = Var q ==> not_fresh_at st q) /\
+  ptr_covers G tn root s capacity /\ op_taint tn src = {} /\ op_prov G src = NONE /\
+  vo + needed <= capacity /\ w2n a + vo < dimword(:256) /\ allocas_from lo s ==>
+  ?q Gf tnf sf.
+    dp = Var q /\
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,func,PG)
+      (s,G,tn) [] (OK sf,Gf,tnf)) /\
+    sf.vs_current_bb = fin.cs_current_bb /\
+    sf.vs_inst_idx = LENGTH fin.cs_current_insts /\ ~sf.vs_halted /\
+    eval_operand dp sf = SOME (a + n2w vo) /\ ptr_covers Gf tnf q sf needed /\
+    eval_operand ep sf = SOME
+      (if dyn then p + abi_decode_load CALLDATALOAD (p + n2w ao) s else p + n2w ao) /\
+    op_taint tnf ep = {} /\ op_prov Gf ep = NONE /\ fresh_vars_wrt fin sf /\
+    sf.vs_allocas = s.vs_allocas /\ sf.vs_data_section = s.vs_data_section /\
+    sf.vs_memory = s.vs_memory /\ sf.vs_call_ctx = s.vs_call_ctx /\
+    tnf.t_mem = tn.t_mem /\ tnf.t_stor = tn.t_stor /\
+    tnf.t_trans = tn.t_trans /\ tnf.t_imm = tn.t_imm /\
+    (!x. not_fresh_at st x ==>
+      lookup_var x sf = lookup_var x s /\ FLOOKUP Gf x = FLOOKUP G x /\
+      op_taint tnf (Var x) = op_taint tn (Var x)) /\
+    sf.vs_alloca_next = s.vs_alloca_next
+Proof
+  strip_tac >>
+  drule calldata_member_address_shape >> strip_tac >>
+  `eval_operand (Var root) s = SOME a` by simp[eval_operand_def] >>
+  drule_all calldata_member_address_sequence >> strip_tac >>
+  `t.vs_alloca_next = s.vs_alloca_next` by
+    (irule (cj 2 abi_decoder_guard_sequence_fields) >>
+     qexists_tac `emitted_insts st fin` >> simp[] >>
+     fs[EVERY_MEM] >> metis_tac[]) >>

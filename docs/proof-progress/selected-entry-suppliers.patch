+    cs_extends st a /\ cs_extends b final /\ fn_has_code mid b fn /\
+    ci_mono st a /\ ci_mono b final /\
+    compile_abi_decode_complex_elems (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+      (DROP (SUC i) xs)
+      (az + SUM (MAP (\(ei,az,mz). az) (TAKE i xs)))
+      (mz + SUM (MAP (\(ei,az,mz). mz) (TAKE i xs))) b = ((),final) /\
+    fn_has_code b final fn ==>
+    !u w e G tn q.
+      ((?B bt. calldata_aggregate_reentrant_resource lo ctx fn PG initial G0 tn0 st root src
+          TV ts vals d i mid u B bt) /\ st.cs_next_var <= mid.cs_next_var /\
+        (mid.cs_next_var <= cutoff ==> future_frame cutoff initial u) /\
+        eval_operand (Var root) u = SOME (n2w d)) /\
+      (calldata_aggregate_reentrant_address_resource lo ctx fn PG initial G0 tn0 st root src
+        TV ts vals d i ep dp mid u /\
+        eval_operand dp u = SOME (n2w (d + SUM (MAP type_memory_size (TAKE i ts)))) /\
+        d + SUM (MAP type_memory_size (TAKE i ts)) < dimword (:256)) /\

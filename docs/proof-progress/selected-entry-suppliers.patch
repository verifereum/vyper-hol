+Theorem calldata_aggregate_reentrant_joint:
+  calldata_reentrant_pre ctx fn site lo st final initial src root srcword d TV
+    (build vals) oid base_addr cap G0 tn0 /\
+  compile_abi_decode_complex_elems (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+    xs 0 0 st = ((),final) /\
+  LENGTH ts = LENGTH xs /\
+  (!i. i < LENGTH xs ==> type_memory_size (EL i ts) = (\(ei,az,mz). mz) (EL i xs)) /\
+  (!i ei az mz. i < LENGTH xs /\ EL i xs = (ei,az,mz) ==>
+    dec_info_needs_offset ei = tv_abi_dynamic (EL i ts) /\
+    member_ptrs i = cd_member_ptr F initial.vs_call_ctx.cc_calldata (EL i ts)
+      (w2n srcword) (SUM (MAP (\(ei,az,mz). az) (TAKE i xs)))) /\
+  exact_aggregate_pack TV ts member_ptrs initial.vs_call_ctx.cc_calldata (w2n srcword) build /\
+  (!ys ao vo a b.
+    compile_abi_decode_complex_elems (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+      ys ao vo a = ((),b) ==> cs_extends a b) /\
+  (!ei ao vo a b.
+    (do ep <- compile_getelemptr_abi src (dec_info_needs_offset ei) ao CALLDATALOAD (Lit 0w) (Lit 0w);
+        dp <- emit_op ADD [Var root; Lit (n2w vo)];
+        compile_abi_decode_to_buf dp ep CALLDATALOAD (Lit 0w) (Lit 0w) ei od) a = ((),b) ==>
+    cs_extends a b) /\
+  LENGTH vals = LENGTH ts /\
+  (!i. i < LENGTH ts ==> cd_decode F initial.vs_call_ctx.cc_calldata (EL i ts)
+    (member_ptrs i) = SOME (EL i vals)) /\
+  calldata_aggregate_reentrant_child lo ctx fn PG site initial G0 tn0 st final root src
+    TV ts vals d xs srcword member_ptrs oid base_addr cap final.cs_next_var ==>
+  ?v H u. calldata_reentrant_post ctx fn site lo PG st final initial G0 tn0 root d TV
+    (build vals) v H u
+Proof
+  strip_tac >>
+  qhdtm_x_assum `calldata_reentrant_pre`
+    (map_every assume_tac o CONJUNCTS o REWRITE_RULE [calldata_reentrant_pre_def, calldata_loop_own_def]) >>
+  `not_fresh_at st root /\ (!q. src = Var q ==> not_fresh_at st q)` by
+    (qpat_assum `abi_decoder_operand_live st.cs_next_var src` mp_tac >>
+     qpat_assum `abi_decoder_operand_live st.cs_next_var (Var root)` mp_tac >>
+     POP_ASSUM_LIST (K all_tac) >> Cases_on `src` >>
+     simp[abi_decoder_operand_live_def, abi_decoder_older_vars_def, not_fresh_at_def]) >>
+  drule_all (SIMP_RULE bool_ss [LESS_EQ_REFL]
+    (Q.INST [`cutoff` |-> `final.cs_next_var`] calldata_exact_aggregate_reentrant_joint)) >>
+  strip_tac >>
+  qhdtm_assum `calldata_aggregate_reentrant_resource`
+    (strip_assume_tac o REWRITE_RULE [calldata_aggregate_reentrant_resource_def]) >>
+  qexistsl_tac [`t`,`G`,`tn`] >>
+  simp_tac bool_ss [calldata_reentrant_post_def, calldata_loop_frame_def,
+    calldata_loop_own_def, calldata_loop_joint_rel_def] >>
+  asm_rewrite_tac[] >> conj_tac
+  >- (qexists_tac `scratch` >> asm_rewrite_tac[]) >>
+  metis_tac[future_frame_mono]
+QED

+     simp_tac bool_ss [EVERY_MEM] >> gen_tac >> strip_tac >> conj_tac
+     >- (fs[EVERY_MEM] >> metis_tac[]) >> rpt strip_tac >>
+     qpat_x_assum `!i x. _ ==> not_fresh_at middle x`
+       (qspecl_then [`inst`, `STRING #"%" (toString r)`] mp_tac) >>
+     simp[exprSimAbiGasBridgeTheory.frag_code_def, fragExecTheory.emitted_blocks_def,
+       loweringStateRelDefsTheory.not_fresh_at_def] >> decide_tac) >>
+  `!v x. MEM v
+     [STRING #"%" (toString loop_st.cs_next_var);
+      STRING #"%" (toString (loop_st.cs_next_var+1));
+      STRING #"%" (toString (loop_st.cs_next_var+2));
+      STRING #"%" (toString (loop_st.cs_next_var+3))] /\
+      not_fresh_at loop_st x ==> x <> v` by
+    (pure_rewrite_tac[MEM, loweringStateRelDefsTheory.not_fresh_at_def] >>
+     rpt strip_tac >> gvs[] >>

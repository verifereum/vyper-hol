+Theory dispatchedRegistrationList
+Ancestors
+  dispatchedRegistrationResultDefs dispatchedRegistrationSource
+  dispatchedRegistrationInput
+  finite_map words list arithmetic
+
+Theorem registration_outputs_transport:
+  registration_outputs fn ce st s G tn owners specs outputs /\
+  EVERY (\owner. MEM owner owners') owners /\
+  (!name prim dyn sz ty tv. MEM (name,prim,dyn,sz,ty,tv) specs ==>
+    FLOOKUP ce'.ce_vars name = FLOOKUP ce.ce_vars name) ==>
+  registration_outputs fn ce' st' s' G' tn' owners' specs outputs
+Proof
+  qid_spec_tac `outputs` >> Induct_on `specs` >>
+  simp[registration_outputs_def] >>
+  Cases_on `outputs` >> simp[] >>
+  PairCases_on `h` >> gen_tac >> PairCases_on `h'` >>
+  simp[] >> disch_tac >>
+  conj_tac >- (gvs[EVERY_MEM] >> metis_tac[]) >>
+  first_x_assum (mp_tac o Q.SPEC `t`) >>
+  simp[registration_outputs_def] >>
+  gvs[EVERY_MEM] >> metis_tac[]
+QED
+
+Theorem registration_outputs_append:
+  registration_outputs fn ce st s G tn owners specs1 outs1 /\
+  registration_outputs fn ce st s G tn owners specs2 outs2 ==>
+  registration_outputs fn ce st s G tn owners (specs1++specs2) (outs1++outs2)
+Proof
+  simp[registration_outputs_def, LIST_REL_APPEND_suff]
+QED
+
+Theorem registration_result_compose:
+  registration_result ctx fn site lo PG st mid limit_st initial G tn old
+    cem specs1 xs1 t H u owners1 outs1 /\
+  registration_result ctx fn site lo PG mid last limit_st t H u owners1
+    cef specs2 xs2 v J z owners2 outs2 /\
+  st.cs_next_var <= mid.cs_next_var /\
+  (!name prim dyn sz ty tv. MEM (name,prim,dyn,sz,ty,tv) specs1 ==>
+    FLOOKUP cef.ce_vars name = FLOOKUP cem.ce_vars name) ==>
+  registration_result ctx fn site lo PG st last limit_st initial G tn old
+    cef (specs1++specs2) (xs1++xs2) v J z owners2 (outs1++outs2)
+Proof
+  simp_tac bool_ss [registration_result_def] >> strip_tac >>
+  `registration_outputs fn cef last v J z owners2 specs1 outs1` by
+    (drule_all registration_outputs_transport >> simp[registration_outputs_def]) >>
+  `registration_outputs fn cef last v J z owners2
+    (specs1++specs2) (outs1++outs2)` by
+    metis_tac[registration_outputs_append] >>
+  `calldata_loop_joint_rel lo ctx fn PG (initial,G,tn) (v,J,z)` by
+    metis_tac[dispatchedDecoderLoopCaseJointTheory.calldata_loop_joint_rel_trans] >>
+  `entry_decoder_obs initial v` by
+    metis_tac[entryDecoderStateFrameTheory.entry_decoder_obs_trans] >>
+  simp[] >> conj_tac
+  >- (gvs[EVERY_MEM] >> metis_tac[]) >>
+  conj_tac
+  >- (rpt strip_tac >>
+      `abi_decoder_operand_live mid.cs_next_var op` by
+        metis_tac[abiDecoderReentryTheory.abi_decoder_operand_live_mono] >>
+      metis_tac[]) >>
+  rpt strip_tac >>
+  qpat_x_assum `!fuel. (!err. run_from fuel ctx fn v <> Error err) ==> _`
+    (drule_then strip_assume_tac) >>
+  qpat_x_assum `!fuel. (!err. run_from fuel ctx fn t <> Error err) ==> _`
+    (qspec_then `fuel'` mp_tac) >> simp[] >> metis_tac[]
+QED
+
+Theorem registration_compile_cons_split:
+  !rest ce name prim dyn sz info ofs st cef last.
+  compile_register_positional_args ce ((name,prim,dyn,sz,info)::rest) ofs st =
+    (cef,last) ==>
+  ?cem mid.
+    compile_register_positional_args ce [(name,prim,dyn,sz,info)] ofs st =
+      (cem,mid) /\
+    compile_register_positional_args cem rest (ofs+sz) mid = (cef,last)
+Proof
+  rpt gen_tac >>
+  simp[moduleLoweringTheory.compile_register_positional_args_def] >>
+  Cases_on `FLOOKUP ce.ce_vars name` >> simp[]
+  >- (simp[compileEnvTheory.comp_return_def] >> metis_tac[]) >>
+  Cases_on `var_location_memory_size x` >> simp[]
+  >- (simp[compileEnvTheory.comp_return_def] >> metis_tac[]) >>
+  simp[compileEnvTheory.comp_bind_def, compileEnvTheory.comp_return_def,
+    compileEnvTheory.comp_ignore_bind_def] >>
+  rpt (pairarg_tac >> gvs[]) >> metis_tac[]
+QED
+
+Theorem registration_list_joint_from_step:
+  (!ctx fn site lo PG ce env sf name prim dyn sz ty tv ofs st cef last limit_st
+      initial G tn old xs.
+    registration_input ctx fn site lo PG ce env sf [(name,prim,dyn,sz,ty,tv)]
+      ofs st cef last limit_st initial G tn old xs ==>
+    ?v H u owners outputs.
+      registration_result ctx fn site lo PG st last limit_st initial G tn old
+        cef [(name,prim,dyn,sz,ty,tv)] xs v H u owners outputs) ==>
+  !specs ctx fn site lo PG ce env sf ofs st cef last limit_st initial G tn old xs.
+    registration_input ctx fn site lo PG ce env sf specs ofs st cef last limit_st
+      initial G tn old xs ==>
+    ?v H u owners outputs.
+      registration_result ctx fn site lo PG st last limit_st initial G tn old
+        cef specs xs v H u owners outputs
+Proof
+  disch_tac >> Induct >> rpt gen_tac
+  >- (simp[registration_input_def,
+        moduleLoweringTheory.compile_register_positional_args_def,
+        compileEnvTheory.comp_return_def,
+        vyperCalldataTheory.calldata_decode_args_def] >>
+      rpt strip_tac >> metis_tac[registration_result_nil]) >>
+  PairCases_on `h` >> strip_tac >>
+  drule registration_input_cons_head >> strip_tac >> gvs[] >>
+  qpat_assum `!ctx fn site lo PG ce env sf name prim dyn sz ty tv ofs st cef last limit_st initial G tn old xs. _`
+    (drule_then strip_assume_tac) >>
+  `registration_input ctx fn site lo PG cem env sf specs (ofs+h3)
+     mid cef last limit_st v H u owners ys` by
+    (irule registration_input_cons_tail >>
+     goal_assum (drule_at Any) >> simp[] >> qexists_tac `ce` >> simp[]) >>
+  first_x_assum (drule_then strip_assume_tac) >>
+  `~MEM h0 (MAP (\(n,p,d,z,t,v). n) specs)` by
+    (qpat_x_assum `registration_input _ _ _ _ _ _ _ _ (_::specs) _ _ _ _ _ _ _ _ _ _`
+      mp_tac >> simp[registration_input_def]) >>
+  `FLOOKUP cef.ce_vars h0 = FLOOKUP cem.ce_vars h0` by
+    (irule calldataRegistrationExecTheory.registration_unmentioned_binding >>
+     goal_assum (drule_at Any) >>
+     simp[MAP_MAP_o, combinTheory.o_DEF, pairTheory.LAMBDA_PROD]) >>
+  `!name prim dyn sz ty tv. MEM (name,prim,dyn,sz,ty,tv) [(h0,h1,h2,h3,h4,h5)] ==>
+     FLOOKUP cef.ce_vars name = FLOOKUP cem.ce_vars name` by simp[] >>
+  drule_all registration_result_compose >> simp[] >> metis_tac[]
+QED
diff --git a/lowering/dispatchedRegistrationPositionalCertificateScript.sml b/lowering/dispatchedRegistrationPositionalCertificateScript.sml

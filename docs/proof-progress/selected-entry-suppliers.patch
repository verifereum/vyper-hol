+  rename1 `op_taint tn2 offset = {}` >> rename1 `op_prov G2 offset = NONE` >>
+  `registration_address_physical ctx fn site s1 s2` by
+    (drule_all registration_load_at_joint >> simp[]) >>
+  `alloca_inv s2 /\ alloca_frontier_inv ctx fn site s2 /\ alloca_history fn s2` by

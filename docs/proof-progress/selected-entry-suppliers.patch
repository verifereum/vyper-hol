+Theorem registration_decoder_old_frame:
+  registration_old_resources first t H u old /\
+  calldata_reentrant_post ctx fn site lo PG first last t H u root p tv x v J z /\
+  FLOOKUP t.vs_allocas owner = SOME (p,type_memory_size tv) /\
+  (!r id a n ty y. MEM (r,id,a,n,ty,y) old ==> id <> owner) /\
+  first.cs_next_id <= last.cs_next_id /\
+  first.cs_next_var <= last.cs_next_var ==>
+  registration_old_resources last v J z old
+Proof
+  strip_tac >> simp[registration_old_resources_def, EVERY_MEM] >>
+  qx_gen_tac `e` >> strip_tac >> PairCases_on `e` >>
+  rename1 `MEM (q,oid,a,n,ty,y) old` >>
+  drule_all registration_old_resources_member >> strip_tac >>
+  qpat_x_assum `calldata_reentrant_post _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _`
+    (strip_assume_tac o REWRITE_RULE [calldata_reentrant_post_def]) >>
+  qpat_x_assum `calldata_loop_frame _ _ _ _ _ _ _ _ _`
+    (strip_assume_tac o REWRITE_RULE [calldata_loop_frame_def]) >>
+  `abi_decoder_operand_live first.cs_next_var (Var q)` by
+    simp[calldata_operand_live_not_fresh] >>
+  `lookup_var q v = lookup_var q t /\ FLOOKUP J q = FLOOKUP H q /\
+    op_taint z (Var q) = op_taint u (Var q)` by
+    metis_tac[venomStateTheory.eval_operand_def] >>
+  `FLOOKUP v.vs_allocas oid = SOME (a,n) /\
+   FLOOKUP v.vs_allocas owner = SOME (p,type_memory_size tv)` by metis_tac[] >>
+  `oid <> owner` by metis_tac[] >>
+  `a+n <= p \/ p+type_memory_size tv <= a` by
+    metis_tac[abi_caller_allocation_separate] >>
+  `val_footprint ty y <= n` by
+    (qpat_assum `val_wf ty y` (mp_tac o MATCH_MP val_footprint_le) >> decide_tac) >>
+  `abi_footprint_disjoint a (val_footprint ty y)
+      ((p,type_memory_size tv)::scratch)` by
+    (simp[abi_footprint_disjoint_def] >> rpt gen_tac >> strip_tac
+     >- (gvs[] >> drule_all abi_caller_allocation_separate >> decide_tac) >>
+     qpat_x_assum `!q k. MEM (q,k) scratch ==> _`
+       (qspecl_then [`d`, `sz`] mp_tac) >> simp[] >> strip_tac >>
+     `oid <> id` by decide_tac >>
+     drule_all abi_caller_allocation_separate >> decide_tac) >>
+  `ptr_covers J z q v n` by (gvs[ptr_covers_def] >> metis_tac[]) >>
+  `val_in_memory ty y a v.vs_memory /\
+   (!mem. mem_agree_outside z.t_mem v.vs_memory mem ==> val_in_memory ty y a mem)` by
+    (drule_all robust_value_footprint_frame >> simp[]) >>
+  simp[] >> gvs[not_fresh_at_def] >> metis_tac[LESS_EQ_TRANS, LESS_LESS_EQ_TRANS]
+QED

+Resume calldata_decoder_loop_prepare_joint[head_resources]:
+  qpat_x_assum `abi_decode_array_element_setup _ _ _ _ _ _ _ _ _ _ = _` kall_tac >>
+  qpat_x_assum `!D explicit. gas_origin_ptr_path _ _ _ _` kall_tac >>
+  qpat_x_assum `fn_has_code _ _ _` kall_tac >>
+  `head.vs_allocas = s.vs_allocas /\ head.vs_alloca_next = s.vs_alloca_next /\
+   ~head.vs_halted /\ head.vs_current_bb = st.cs_current_bb /\
+   head.vs_inst_idx = LENGTH st.cs_current_insts` by
+    (simp_tac (srw_ss()) [Abbr `head`,abi_decode_header_state_def,jump_to_def,
+      update_var_def] >> metis_tac[]) >>
+  simp[] >>
+  conj_tac >- (fs[allocas_from_def] >> metis_tac[]) >>
+  conj_tac >- (fs[ptr_covers_def] >>
+    simp[ptr_covers_def,FLOOKUP_DRESTRICT,FLOOKUP_UPDATE,op_taint_def,
+      lookup_var_def,DISJ_IMP_THM,FORALL_AND_THM] >>
+    gvs[lookup_var_def,op_taint_def]) >>
+  conj_tac >- (fs[ptr_covers_def] >>
+    simp[ptr_covers_def,FLOOKUP_DRESTRICT,FLOOKUP_UPDATE,op_taint_def,
+      lookup_var_def,DISJ_IMP_THM,FORALL_AND_THM] >>
+    gvs[lookup_var_def,op_taint_def]) >>
+  Cases_on `src` >>
+  fs[op_taint_def,op_prov_def,FLOOKUP_UPDATE,FLOOKUP_DRESTRICT,
+    DISJ_IMP_THM,FORALL_AND_THM]
+QED
+
+Resume calldata_decoder_loop_prepare_joint[joint]:
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (head,HG,ht) [] (OK entry,FG,ft)` by
+    (simp[Abbr `entry`] >> metis_tac[]) >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) [] (OK head,HG,ht)` by
+    (qpat_x_assum `!D explicit. gas_origin_ptr_path _ (s,G,tn) [] _` mp_tac >>
+     simp[Abbr `head`]) >>

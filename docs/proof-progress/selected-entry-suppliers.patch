+(* Proof-only resources for the actual registration prelude. *)
+Theory dispatchedRegistrationPrefixResources
+Ancestors
+  logValueFramePtr entryRegistrationSingletonFrame dispatchedDecoderTrace
+  dispatchedDecoderLoopCaseJoint vyperCalldata
+  abiAllocationHistory abiDecoderReentry calldataRegistrationExec
+  bodyPtrDefs exprSimProps venomMemDefs ptrDiscipline
+  finite_map words list arithmetic pred_set
+
+Theorem registration_old_value_fresh_interval:
+  val_wf tv x /\
+  (!m. mem_agree_outside taints mem m ==> val_in_memory tv x addr m) /\
+  addr + val_footprint tv x <= p ==>
+  !m. mem_agree_outside (taints UNION {j | p <= j /\ j < p+n}) mem m ==>
+    val_in_memory tv x addr m
+Proof
+  rpt strip_tac >> irule robust_val_in_memory_footprint_frame >>
+  conj_tac >- simp[] >>
+  qexistsl_tac [`mem`, `mem`, `taints`, `taints UNION {j | p <= j /\ j < p+n}`] >>
+  simp[] >> rpt strip_tac >> gvs[] >> decide_tac
+QED
+
+Definition registration_old_resources_def:
+  registration_old_resources st s G tn old <=>
+    EVERY (\(root,oid,addr,cap,tv,x).
+      not_fresh_at st root /\ oid < st.cs_next_id /\
+      lookup_var root s = SOME (n2w addr) /\
+      FLOOKUP s.vs_allocas oid = SOME (addr,cap) /\
+      FLOOKUP G root = SOME (addr,cap) /\ ptr_covers G tn root s cap /\
+      type_memory_size tv <= cap /\ value_has_type tv x /\ val_wf tv x /\
+      (!m. mem_agree_outside tn.t_mem s.vs_memory m ==>
+        val_in_memory tv x addr m)) old
+End
+
+Definition dispatched_registration_caller_def:
+  dispatched_registration_caller ctx fn site lo PG st limit_st s G tn old <=>
+    ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+    s.vs_inst_idx = LENGTH st.cs_current_insts /\
+    alloca_inv s /\ alloca_frontier_inv ctx fn site s /\
+    alloca_history fn s /\ abi_alloca_history (fn_insts fn) s /\
+    fresh_vars_wrt st s /\
+    fresh_vars_wrt limit_st s /\ st.cs_next_var <= limit_st.cs_next_var /\
+    allocas_from lo s /\ lo <= s.vs_alloca_next /\
+    (!id entry. FLOOKUP s.vs_allocas id = SOME entry ==> id < st.cs_next_id) /\
+    registration_old_resources st s G tn old
+End
+
+Theorem registration_old_value_unchanged:
+  mem' = mem /\ taints' = taints /\
+  (!m. mem_agree_outside taints mem m ==> val_in_memory tv x addr m) ==>
+  !m. mem_agree_outside taints' mem' m ==> val_in_memory tv x addr m
+Proof
+  simp[]
+QED
+
+Theorem registration_old_value_footprint_bound:
+  alloca_inv s /\ FLOOKUP s.vs_allocas oid = SOME (addr,cap) /\
+  type_memory_size tv <= cap /\ val_wf tv x ==>
+  addr + val_footprint tv x <= s.vs_alloca_next
+Proof
+  strip_tac >> drule val_footprint_le >>
+  gvs[alloca_inv_def, alloca_next_valid_def] >>
+  first_x_assum drule >> decide_tac
+QED
+
+Definition dispatched_registration_ready_def:
+  dispatched_registration_ready ctx fn site lo PG st first final limit_st
+    s G tn old cef name n info tv x srcword dst src t H u p <=>
+    calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (t,H,u) /\
+    dispatched_registration_caller ctx fn site lo PG first limit_st t H u old /\
+    FLOOKUP cef.ce_vars name = SOME (PtrVar dst n) /\
+    (?root ins. dst = Var root /\ MEM ins (fn_insts fn) /\
+      ins.inst_opcode = ALLOCA /\ ins.inst_outputs = [root] /\
+      ins.inst_id = st.cs_next_id /\ ptr_covers H u root t n) /\
+    compile_abi_decode_to_buf dst src CALLDATALOAD (Lit 0w) (Lit 0w) info first =
+      ((),final) /\ fn_has_code first final fn /\
+    st.cs_next_id < first.cs_next_id /\ st.cs_next_var <= first.cs_next_var /\
+    eval_operand src t = SOME srcword /\ op_taint u src = {} /\
+    op_prov H src = NONE /\ eval_operand dst t = SOME (n2w p) /\
+    abi_decoder_operand_live first.cs_next_var src /\
+    abi_decoder_operand_live first.cs_next_var dst /\
+    FLOOKUP t.vs_allocas st.cs_next_id = SOME (p,n) /\ p+n < dimword(:256) /\
+    s.vs_alloca_next <= t.vs_alloca_next /\
+    t.vs_memory = s.vs_memory /\ t.vs_call_ctx = s.vs_call_ctx /\
+    t.vs_data_section = s.vs_data_section /\
+    (!op. abi_decoder_operand_live st.cs_next_var op ==>
+      eval_operand op t = eval_operand op s) /\
+    (!id entry. FLOOKUP s.vs_allocas id = SOME entry ==>
+      FLOOKUP t.vs_allocas id = SOME entry) /\
+    (!id. id <> st.cs_next_id ==> FLOOKUP t.vs_allocas id = FLOOKUP s.vs_allocas id) /\
+    cd_decode F t.vs_call_ctx.cc_calldata tv (w2n srcword) = SOME x /\
+    entry_decoder_obs s t /\
+    (!fuel r. run_from fuel ctx fn t = r /\ (!err. r <> Error err) ==>
+      ?fuel'. run_from fuel' ctx fn s = r /\
+        (mem_safe_run fuel ctx fn t ==> mem_safe_run fuel' ctx fn s)) /\
+    ((!fuel. mem_safe_run fuel ctx fn t) ==> !fuel. mem_safe_run fuel ctx fn s)
+End
+
+Theorem dispatched_registration_caller_cursor:
+  dispatched_registration_caller ctx fn site lo PG st limit_st s G tn old ==>
+  ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts
+Proof
+  simp[dispatched_registration_caller_def]
+QED
+
+Theorem dispatched_registration_caller_old:
+  dispatched_registration_caller ctx fn site lo PG st limit_st s G tn old ==>
+  registration_old_resources st s G tn old
+Proof
+  simp[dispatched_registration_caller_def]
+QED
+
+Theorem dispatched_registration_ready_joint:
+  dispatched_registration_ready ctx fn site lo PG st first final limit_st
+    s G tn old cef name n info tv x srcword dst src t H u p ==>
+  calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (t,H,u)
+Proof
+  simp[dispatched_registration_ready_def]
+QED
+
+Theorem dispatched_registration_ready_resources:
+  dispatched_registration_ready ctx fn site lo PG st first final limit_st
+    s G tn old cef name n info tv x srcword dst src t H u p ==>
+  dispatched_registration_caller ctx fn site lo PG first limit_st t H u old
+Proof
+  simp[dispatched_registration_ready_def]
+QED
+
+Theorem dispatched_registration_ready_source:
+  dispatched_registration_ready ctx fn site lo PG st first final limit_st
+    s G tn old cef name n info tv x srcword dst src t H u p ==>
+  eval_operand src t = SOME srcword /\ op_taint u src = {} /\ op_prov H src = NONE /\
+  cd_decode F t.vs_call_ctx.cc_calldata tv (w2n srcword) = SOME x
+Proof
+  simp[dispatched_registration_ready_def]
+QED
+
+Theorem dispatched_registration_caller_empty:
+  ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts /\
+  alloca_inv s /\ alloca_frontier_inv ctx fn site s /\
+  alloca_history fn s /\ abi_alloca_history (fn_insts fn) s /\
+  fresh_vars_wrt st s /\
+  fresh_vars_wrt limit_st s /\ st.cs_next_var <= limit_st.cs_next_var /\
+  allocas_from lo s /\ lo <= s.vs_alloca_next /\
+  (!id entry. FLOOKUP s.vs_allocas id = SOME entry ==> id < st.cs_next_id) ==>
+  dispatched_registration_caller ctx fn site lo PG st limit_st s G tn []
+Proof
+  simp[dispatched_registration_caller_def, registration_old_resources_def]
+QED
+
+Theorem registration_old_resources_member:
+  registration_old_resources st s G tn old /\
+  MEM (root,oid,addr,cap,tv,x) old ==>
+  not_fresh_at st root /\ oid < st.cs_next_id /\
+  lookup_var root s = SOME (n2w addr) /\
+  FLOOKUP s.vs_allocas oid = SOME (addr,cap) /\
+  FLOOKUP G root = SOME (addr,cap) /\ ptr_covers G tn root s cap /\
+  type_memory_size tv <= cap /\ value_has_type tv x /\ val_wf tv x /\
+  (!m. mem_agree_outside tn.t_mem s.vs_memory m ==> val_in_memory tv x addr m)
+Proof
+  simp[registration_old_resources_def, EVERY_MEM] >> strip_tac >>
+  first_x_assum drule >> simp[]
+QED
+
+Theorem dispatched_registration_caller_footprint:
+  dispatched_registration_caller ctx fn site lo PG st limit_st s G tn old /\
+  MEM (root,oid,addr,cap,tv,x) old ==>
+  addr + val_footprint tv x <= s.vs_alloca_next
+Proof
+  strip_tac >> drule dispatched_registration_caller_old >> strip_tac >>
+  drule_all registration_old_resources_member >> strip_tac >>
+  irule registration_old_value_footprint_bound >>
+  gvs[dispatched_registration_caller_def] >> metis_tac[]
+QED
+
+Theorem dispatched_registration_ready_decoder:
+  dispatched_registration_ready ctx fn site lo PG st first final limit_st
+    s G tn old cef name n info tv x srcword dst src t H u p ==>
+  compile_abi_decode_to_buf dst src CALLDATALOAD (Lit 0w) (Lit 0w) info first =
+    ((),final) /\ fn_has_code first final fn /\
+  eval_operand dst t = SOME (n2w p) /\
+  abi_decoder_operand_live first.cs_next_var src /\
+  abi_decoder_operand_live first.cs_next_var dst /\
+  FLOOKUP t.vs_allocas st.cs_next_id = SOME (p,n) /\ p+n < dimword(:256)
+Proof
+  simp[dispatched_registration_ready_def]
+QED
+
+Theorem dispatched_registration_caller_fresh:
+  dispatched_registration_caller ctx fn site lo PG st limit_st s G tn old ==>
+  fresh_vars_wrt st s
+Proof
+  simp[dispatched_registration_caller_def]
+QED
+
+Theorem registration_fresh_vars_mono:
+  fresh_vars_wrt st s /\ st.cs_next_var <= last.cs_next_var ==>
+  fresh_vars_wrt last s
+Proof
+  simp[loweringStateRelDefsTheory.fresh_vars_wrt_def] >>
+  rpt strip_tac >> first_x_assum irule >> decide_tac
+QED

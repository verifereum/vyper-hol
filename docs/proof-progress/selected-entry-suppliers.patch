+    op_taint th src = {} /\ op_prov H src = NONE /\
+    entry.vs_memory = s.vs_memory /\ entry.vs_allocas = s.vs_allocas /\
+    entry.vs_alloca_next = s.vs_alloca_next /\ entry.vs_call_ctx = s.vs_call_ctx /\
+    entry.vs_data_section = s.vs_data_section /\ th.t_mem = tn.t_mem /\
+    th.t_stor = tn.t_stor /\ th.t_trans = tn.t_trans /\ th.t_imm = tn.t_imm /\
+    (!x. not_fresh_at old x ==>
+      lookup_var x entry = lookup_var x s /\ FLOOKUP H x = FLOOKUP G x /\
+      op_taint th (Var x) = op_taint tn (Var x)) /\

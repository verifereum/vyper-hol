+(* Static positional descriptors for arbitrary accepted calldata. *)
+Theory dispatchedRegistrationPositionalInput
+Ancestors
+  dispatchedRegistrationResultDefs dispatchedRegistrationSource
+  calldataRegistration words list arithmetic
+
+Theorem registration_positional_specs_full:
+  !args tys.
+    LIST_REL (\(name,ty) (ty',tv).
+      ty = ty' /\ abi_decoder_coherent ce env ce.ce_struct_fields ty tv /\
+      (?loc. FLOOKUP ce.ce_vars name = SOME loc /\
+        var_location_memory_size loc = SOME (type_memory_size tv)) /\
+      type_memory_size tv < dimword (:256)) args tys ==>
+    ?specs.
+      MAP (\(name,prim,dyn,sz,ty,tv).
+        (name,prim,dyn,sz,type_to_abi_dec_info ce.ce_struct_fields ce ty)) specs =
+        build_positional_args ce args /\
+      MAP (\(name,prim,dyn,sz,ty,tv). name) specs = MAP FST args /\
+      MAP (\(name,prim,dyn,sz,ty,tv). ((name,ty),tv)) specs =
+        ZIP (args,MAP SND tys) /\
+      EVERY (\(name,prim,dyn,sz,ty,tv).
+        abi_decoder_coherent ce env ce.ce_struct_fields ty tv /\
+        (?loc. FLOOKUP ce.ce_vars name = SOME loc /\
+          var_location_memory_size loc = SOME (type_memory_size tv)) /\
+        (prim ==> ?c. type_to_abi_dec_info ce.ce_struct_fields ce ty = DecPrimWord c) /\
+        type_memory_size tv < dimword (:256)) specs /\
+      MAP (\(name,prim,dyn,sz,ty,tv). tv) specs = MAP SND tys /\
+      EVERY (\(name,prim,dyn,sz,ty,tv).
+        dyn = tv_abi_dynamic tv /\ sz = tv_abi_size tv /\
+        (prim ==> ~dyn /\ ?c.
+          type_to_abi_dec_info ce.ce_struct_fields ce ty = DecPrimWord c)) specs
+Proof
+  Induct >> Cases_on `tys` >> simp[compileVyperTheory.build_positional_args_def] >>
+  gen_tac >> PairCases_on `h` >> PairCases_on `h'` >>
+  simp[] >> rpt strip_tac >> gvs[] >>
+  first_x_assum drule >> strip_tac >>
+  rename1 `abi_decoder_coherent ce env ce.ce_struct_fields ty tv` >>
+  rename1 `FLOOKUP ce.ce_vars name = SOME loc` >>
+  drule registration_positional_source_metadata >>
+  disch_then (qspec_then `name` strip_assume_tac) >>
+  qexists `(name,prim,dyn,sz,ty,tv)::specs` >>
+  simp[compileVyperTheory.build_positional_args_def] >> metis_tac[]
+QED
+
+Theorem registration_positional_input:
+  LIST_REL (\(name,ty) (ty',tv).
+    ty = ty' /\ abi_decoder_coherent ce env ce.ce_struct_fields ty tv /\
+    (?loc. FLOOKUP ce.ce_vars name = SOME loc /\
+      var_location_memory_size loc = SOME (type_memory_size tv)) /\
+    type_memory_size tv < dimword (:256)) args tys /\
+  ALL_DISTINCT (MAP FST args) /\
+  compile_register_positional_args ce (build_positional_args ce args) (4+ofs) st =
+    (cef,last) /\
+  calldata_decode_args initial.vs_call_ctx.cc_calldata (MAP SND tys) ofs = SOME xs /\
+  4+ofs+SUM (MAP tv_abi_size (MAP SND tys)) < dimword (:256) /\
+  dispatched_registration_caller ctx fn site lo PG st limit_st initial G tn old /\
+  fn_has_code st last fn /\ fn_inst_ids_distinct fn /\
+  ALL_DISTINCT (MAP (\i. i.inst_id) (fn_insts fn)) /\
+  unit_alloca_budget ctx < dimword (:256) /\ ~ctx_has_dalloca ctx /\
+  (last.cs_current_insts = [] ==>
+    !bb. lookup_block last.cs_current_bb fn.fn_blocks = SOME bb ==>
+      phi_prefix_length bb.bb_instructions = 0) /\
+  last.cs_next_var <= limit_st.cs_next_var ==>
+  ?specs.
+    MAP (\(name,prim,dyn,sz,ty,tv).
+      (name,prim,dyn,sz,type_to_abi_dec_info ce.ce_struct_fields ce ty)) specs =
+      build_positional_args ce args /\
+    MAP (\(name,prim,dyn,sz,ty,tv). name) specs = MAP FST args /\
+    MAP (\(name,prim,dyn,sz,ty,tv). ((name,ty),tv)) specs =
+      ZIP (args,MAP SND tys) /\
+    EVERY (\(name,prim,dyn,sz,ty,tv).
+      abi_decoder_coherent ce env ce.ce_struct_fields ty tv /\
+      (?loc. FLOOKUP ce.ce_vars name = SOME loc /\
+        var_location_memory_size loc = SOME (type_memory_size tv)) /\
+      (prim ==> ?c. type_to_abi_dec_info ce.ce_struct_fields ce ty = DecPrimWord c) /\
+      type_memory_size tv < dimword (:256)) specs /\
+    MAP (\(name,prim,dyn,sz,ty,tv). tv) specs = MAP SND tys /\
+    EVERY (\(name,prim,dyn,sz,ty,tv).
+      dyn = tv_abi_dynamic tv /\ sz = tv_abi_size tv /\
+      (prim ==> ~dyn /\ ?c.
+        type_to_abi_dec_info ce.ce_struct_fields ce ty = DecPrimWord c)) specs /\
+    registration_input ctx fn site lo PG ce env ce.ce_struct_fields specs ofs st
+      cef last limit_st initial G tn old xs
+Proof
+  strip_tac >> drule registration_positional_specs_full >> strip_tac >>
+  `EVERY (\(name,prim,dyn,sz,ty,tv).
+    abi_decoder_coherent ce env ce.ce_struct_fields ty tv /\
+    (?loc. FLOOKUP ce.ce_vars name = SOME loc /\
+      var_location_memory_size loc = SOME (type_memory_size tv)) /\
+    dyn = tv_abi_dynamic tv /\ sz = tv_abi_size tv /\
+    (prim ==> ~dyn /\ ?c.
+      type_to_abi_dec_info ce.ce_struct_fields ce ty = DecPrimWord c) /\
+    type_memory_size tv < dimword (:256)) specs` by
+    (gvs[EVERY_MEM, pairTheory.FORALL_PROD] >> metis_tac[]) >>
+  `MAP (\(name,prim,dyn,sz,ty,tv). tv_abi_size tv) specs =
+    MAP tv_abi_size (MAP SND tys)` by
+    (qpat_x_assum `MAP (\(name,prim,dyn,sz,ty,tv). tv) specs = _`
+      (mp_tac o AP_TERM ``MAP tv_abi_size``) >>
+     simp[MAP_COMPOSE, combinTheory.o_DEF, pairTheory.LAMBDA_PROD]) >>
+  qexists `specs` >> simp[registration_input_def] >> gvs[]
+QED

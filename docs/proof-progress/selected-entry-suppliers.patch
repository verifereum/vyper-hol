+  d + abi_decode_bytes_copy_size maxn < dimword (:256) /\
+  d + abi_decode_bytes_copy_size maxn <= s.vs_alloca_next /\
+  maxn < dimword (:256) /\ fn_has_code st last fn /\
+  ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts /\
+  run_inst_seq (emitted_insts st last) s = OK t ==>
+  entry_decoder_obs s (t with vs_inst_idx := LENGTH last.cs_current_insts) /\
+  ((!fuel. mem_safe_run fuel ctx fn

+    (fs[frag_code_def, same_blocks_def, emitted_blocks_def]) >>
+  spose_not_then assume_tac >>
+  `not_fresh_at last (STRING #"%" (toString n))` by metis_tac[] >>
+  fs[not_fresh_at_def] >> metis_tac[LESS_EQ_TRANS]
+QED

+Theorem calldata_decoder_loop_init_framed_joint:
+  abi_decode_array_loop_init (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+    maxn abi_sz sa = (setup,sb) /\
+  fn_has_code sa sb fn /\
+  lookup_block sb.cs_current_bb fn.fn_blocks = SOME jumpbb /\
+  get_instruction jumpbb (LENGTH sb.cs_current_insts) =
+    SOME (mk_inst jid JMP [Label hdr] []) /\
+  lookup_block hdr fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  allocas_from lo s /\ lo <= s.vs_alloca_next /\ ~ctx_has_dalloca ctx /\
+  ~s.vs_halted /\ s.vs_current_bb = sa.cs_current_bb /\
+  s.vs_inst_idx = LENGTH sa.cs_current_insts /\
+  lookup_var root s = SOME (n2w d) /\ d < dimword(:256) /\
+  ptr_covers G tn root s capacity /\ 32 <= capacity /\
+  not_fresh_at sa root /\ (!x. src = Var x ==> not_fresh_at sa x) /\
+  eval_operand src s = SOME (n2w off) /\ op_taint tn src = {} /\ op_prov G src = NONE /\
+  abi_decode_load CALLDATALOAD (n2w off:bytes32) s = n2w n /\
+  n <= maxn /\ maxn < dimword(:256) /\
+  abi_decoder_budget first last b cap s /\ first <= sa.cs_next_id /\ sb.cs_next_id <= last /\
+  (d + 32 <= b \/ b + cap <= d) /\ fresh_vars_wrt sa s /\
+  alloca_inv s /\ FLOOKUP s.vs_allocas oid = SOME (owner_base,extent) /\
+  owner_base <= d /\ d + capacity <= owner_base + extent /\
+  EVERY (\i. i.inst_opcode <> INVOKE /\
+    !r. cutoff <= r ==> ~MEM (STRING #"%" (toString r)) i.inst_outputs)
+    (emitted_insts sa sb) ==>
+  ?t p q H th.
+    run_inst_seq (emitted_insts sa sb) s = OK t /\
+    FST setup = Var q /\
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) [] (OK (jump_to hdr t),H,th)) /\
+    ~t.vs_halted /\ t.vs_current_bb = sb.cs_current_bb /\
+    eval_operand (FST setup) t = SOME (n2w p) /\
+    eval_operand (SND setup) t = SOME (n2w n) /\
+    mload p t = 0w /\ mem_word_at d t.vs_memory = n2w n /\
+    b <= p /\ p+32 <= b+cap /\ p+32 < dimword(:256) /\
+    abi_decoder_budget first last b cap t /\ fresh_vars_wrt sb t /\
+    (!op w. eval_operand op s = SOME w ==> eval_operand op t = SOME w) /\
+    abi_decode_footprint_frame [(d,32);(b,cap)] s t /\
+    abi_decode_footprint_frame [(d,32);(p,32)] s t /\
+    FLOOKUP t.vs_allocas (sb.cs_next_id - 2) = SOME (p,32) /\
+    (!id. id <> sb.cs_next_id - 2 ==> FLOOKUP t.vs_allocas id = FLOOKUP s.vs_allocas id) /\
+    inst_extends sa sb /\ allocas_from lo t /\ p+32 <= t.vs_alloca_next /\
+    ptr_covers H th q (jump_to hdr t) 32 /\
+    ptr_covers H th root (jump_to hdr t) capacity /\
+    op_taint th (SND setup) = {} /\ op_prov H (SND setup) = NONE /\
+    op_taint th src = {} /\ op_prov H src = NONE /\
+    th.t_stor = tn.t_stor /\ th.t_trans = tn.t_trans /\ th.t_imm = tn.t_imm /\
+    th.t_mem = (tn.t_mem DIFF {x | d <= x /\ x < d+32})
+                         DIFF {x | p <= x /\ x < p+32} /\
+    (!x. not_fresh_at sa x ==> lookup_var x t = lookup_var x s /\
+       FLOOKUP H x = FLOOKUP G x /\ op_taint th (Var x) = op_taint tn (Var x)) /\
+    future_frame cutoff s (jump_to hdr t)
+Proof
+  disch_then (map_every assume_tac o CONJUNCTS) >>
+  drule_all calldata_decoder_loop_init_joint >>
+  disch_then (qspec_then `PG` strip_assume_tac) >>
+  qexistsl_tac [`t`,`p`,`q`,`H`,`th`] >> simp[] >>
+  drule_all decoder_sequence_future_frame >> simp[]
+QED

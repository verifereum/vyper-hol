+Theorem calldata_decoder_loop_init_joint:
+  abi_decode_array_loop_init (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+    maxn abi_sz sa = (setup,sb) /\
+  fn_has_code sa sb fn /\
+  lookup_block sb.cs_current_bb fn.fn_blocks = SOME jumpbb /\
+  get_instruction jumpbb (LENGTH sb.cs_current_insts) =
+    SOME (mk_inst jid JMP [Label hdr] []) /\
+  lookup_block hdr fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  allocas_from lo s /\ lo <= s.vs_alloca_next /\ ~ctx_has_dalloca ctx /\
+  ~s.vs_halted /\ s.vs_current_bb = sa.cs_current_bb /\
+  s.vs_inst_idx = LENGTH sa.cs_current_insts /\
+  lookup_var root s = SOME (n2w d) /\ d < dimword(:256) /\
+  ptr_covers G tn root s capacity /\ 32 <= capacity /\
+  not_fresh_at sa root /\ (!x. src = Var x ==> not_fresh_at sa x) /\
+  eval_operand src s = SOME (n2w off) /\ op_taint tn src = {} /\ op_prov G src = NONE /\
+  abi_decode_load CALLDATALOAD (n2w off:bytes32) s = n2w n /\
+  n <= maxn /\ maxn < dimword(:256) /\
+  abi_decoder_budget first last b cap s /\ first <= sa.cs_next_id /\ sb.cs_next_id <= last /\
+  (d + 32 <= b \/ b + cap <= d) /\ fresh_vars_wrt sa s /\
+  alloca_inv s /\ FLOOKUP s.vs_allocas oid = SOME (owner_base,extent) /\
+  owner_base <= d /\ d + capacity <= owner_base + extent ==>
+  ?t p q H th.
+    run_inst_seq (emitted_insts sa sb) s = OK t /\
+    FST setup = Var q /\
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) [] (OK (jump_to hdr t),H,th)) /\
+    ~t.vs_halted /\ t.vs_current_bb = sb.cs_current_bb /\
+    eval_operand (FST setup) t = SOME (n2w p) /\
+    eval_operand (SND setup) t = SOME (n2w n) /\
+    mload p t = 0w /\ mem_word_at d t.vs_memory = n2w n /\
+    b <= p /\ p+32 <= b+cap /\ p+32 < dimword(:256) /\
+    abi_decoder_budget first last b cap t /\ fresh_vars_wrt sb t /\
+    (!op w. eval_operand op s = SOME w ==> eval_operand op t = SOME w) /\
+    abi_decode_footprint_frame [(d,32);(b,cap)] s t /\
+    abi_decode_footprint_frame [(d,32);(p,32)] s t /\
+    FLOOKUP t.vs_allocas (sb.cs_next_id - 2) = SOME (p,32) /\
+    (!id. id <> sb.cs_next_id - 2 ==> FLOOKUP t.vs_allocas id = FLOOKUP s.vs_allocas id) /\
+    inst_extends sa sb /\ allocas_from lo t /\ p+32 <= t.vs_alloca_next /\
+    ptr_covers H th q (jump_to hdr t) 32 /\
+    ptr_covers H th root (jump_to hdr t) capacity /\
+    op_taint th (SND setup) = {} /\ op_prov H (SND setup) = NONE /\
+    op_taint th src = {} /\ op_prov H src = NONE /\
+    th.t_stor = tn.t_stor /\ th.t_trans = tn.t_trans /\ th.t_imm = tn.t_imm /\
+    th.t_mem = (tn.t_mem DIFF {x | d <= x /\ x < d+32})
+                         DIFF {x | p <= x /\ x < p+32} /\
+    (!x. not_fresh_at sa x ==> lookup_var x t = lookup_var x s /\
+       FLOOKUP H x = FLOOKUP G x /\ op_taint th (Var x) = op_taint tn (Var x))
+Proof
+  disch_then (map_every assume_tac o CONJUNCTS) >>
+  `first <= sb.cs_next_id - 2` by
+    (drule abi_decode_array_loop_init_trace >> strip_tac >>
+     drule abi_decode_index_init_shape >> strip_tac >>
+     drule abi_decode_dynarray_position_prefix_shape >>
+     simp[abi_decode_source_opcode_def] >> strip_tac >>
+     drule abi_decode_array_header_shape >>
+     simp[abi_decode_source_opcode_def] >> strip_tac >> decide_tac) >>
+  `eval_operand (Var root) s = SOME (n2w d)` by simp[eval_operand_def] >>
+  drule_at (Pat `abi_decoder_budget _ _ _ _ _`) abi_decode_array_loop_init_sequence >>
+  disch_then (drule_at (Pat `abi_decode_array_loop_init _ _ _ _ _ _ _ _ = _`)) >>
+  disch_then (drule_at (Pat `eval_operand src s = _`)) >>
+  disch_then (qspecl_then [`off`,`n`,`0`] mp_tac) >>
+  impl_tac >- simp[abi_decode_source_opcode_def,eval_operand_def] >>
+  strip_tac >>
+  `d + 32 <= s.vs_alloca_next` by
+    (qpat_assum `alloca_inv s` mp_tac >>
+     pure_rewrite_tac[venomMemDefsTheory.alloca_inv_def,venomMemDefsTheory.alloca_next_valid_def] >>
+     strip_tac >> first_x_assum drule >> strip_tac >> decide_tac) >>
+  drule_all calldata_array_init_endpoint_joint_core >>
+  disch_then (qspecl_then [`ARB`,`ctx`,`ARB`,`PG`,`ARB`] strip_assume_tac) >>
+  `p < dimword(:256) /\ p' < dimword(:256)` by
+    (qpat_assum `abi_decoder_budget first last b cap t` mp_tac >>
+     pure_rewrite_tac[abiDecoderAllocationTheory.abi_decoder_budget_def] >> strip_tac >> decide_tac) >>
+  `p = p'` by metis_tac[wordsTheory.n2w_11,optionTheory.SOME_11,LESS_MOD] >>
+  gvs[] >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) [] (OK (t with vs_inst_idx := LENGTH sb.cs_current_insts),HG,u)` by
+    metis_tac[] >>
+  `allocas_from lo t /\ lo <= t.vs_alloca_next` by
+    (qpat_assum `!D explicit. gas_origin_ptr_path _ _ _ _` (qspecl_then [`ARB`,`ARB`] mp_tac) >>
+     disch_then (mp_tac o MATCH_MP gas_origin_ptr_path_projections) >>
+     strip_tac >> drule calldata_decoder_path_allocas >>
+     simp[] >> simp_tac (srw_ss()) [allocas_from_def] >> metis_tac[]) >>
+  `2 <= sb.cs_next_id` by
+    (drule abi_decode_array_loop_init_trace >> strip_tac >>
+     drule abi_decode_index_init_shape >> strip_tac >> decide_tac) >>
+  `p+32 <= t.vs_alloca_next` by
+    (qpat_assum `abi_decoder_budget first last b cap t` mp_tac >>
+     pure_rewrite_tac[abiDecoderAllocationTheory.abi_decoder_budget_def] >>
+     strip_tac >>
+     qpat_x_assum `!id off sz. _ ==> sz = 32 /\ _` (qspec_then `sb.cs_next_id - 2` mp_tac) >>
+     simp[abiDecoderAllocationTheory.abi_decoder_ids_def] >> decide_tac) >>
+  `t.vs_current_bb = sb.cs_current_bb` by
+    (drule abiDecoderArrayInitTheory.abi_decode_array_loop_init_shape >>
+     simp[abi_decode_source_opcode_def] >> strip_tac >>
+     drule_all run_inst_seq_preserves_entry_control >> simp[]) >>
+  `op_taint u src = {} /\ op_prov HG src = NONE` by
+    (Cases_on `src` >> fs[op_taint_def,op_prov_def] >> metis_tac[]) >>
+  qexistsl_tac [`HG`,`u`] >> simp[] >>
+  reverse conj_tac
+  >- (fs[ptr_covers_def,jump_to_def,lookup_var_def] >> metis_tac[]) >>
+  rpt gen_tac >>
+  `gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (t with vs_inst_idx := LENGTH sb.cs_current_insts,HG,u) []
+    (OK (jump_to hdr t),HG,u)` by
+    (`jump_to hdr t = jump_to hdr (t with vs_inst_idx := LENGTH sb.cs_current_insts)` by
+       simp[jump_to_def] >> pop_assum SUBST1_TAC >>
+     irule calldata_decoder_jump_joint >> simp[allocas_from_def] >>
+     fs[allocas_from_def] >> conj_tac >- (qexists_tac `jid` >> simp[]) >>
+     metis_tac[]) >>
+  qpat_assum `!D explicit. gas_origin_ptr_path _ _ _ _` (qspecl_then [`D`,`explicit`] mp_tac) >>
+  disch_then (mp_tac o MATCH_MP gas_origin_ptr_path_append) >>
+  simp[] >> disch_then drule >> simp[] >>
+  fs[ptr_covers_def,jump_to_def,lookup_var_def] >> metis_tac[]
+QED

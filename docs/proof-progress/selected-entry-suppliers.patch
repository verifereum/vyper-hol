+Theorem calldata_decoder_clean_mload_joint[local]:
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME bb /\
+  get_instruction bb s.vs_inst_idx = SOME (mk_inst id MLOAD [Var p] [out]) /\
+  eval_operand (Var p) s = SOME dw /\ ptr_covers G tn p s 32 /\
+  mem_word_taint tn.t_mem (w2n dw) = {} /\
+  w2n dw + 32 <= s.vs_alloca_next ==>
+  !D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) []
+    (OK ((update_var out (mload (w2n dw) s) s) with vs_inst_idx := SUC s.vs_inst_idx),
+     DRESTRICT G (COMPL {out}),tn with t_var := tn.t_var |+ (out,{}))
+Proof
+  strip_tac >>
+  `out_taint tn (mk_inst id MLOAD [Var p] [out]) s = {}` by
+    simp[out_taint_def, mk_inst_def] >>
+  drule_at (Pat `out_taint _ _ _ = {}`) calldata_decoder_read_ghost >>
+  simp[] >>
+  disch_then (qspecl_then [`mload (w2n dw) s`,`PG`,`G`] strip_assume_tac) >>
+  `ghost_step 0 ctx PG G tn (mk_inst id MLOAD [Var p] [out]) s =
+     (DRESTRICT G (COMPL {out}),tn with t_var := tn.t_var |+ (out,{}))` by
+    (`step_inst 0 ctx (mk_inst id MLOAD [Var p] [out]) s =
+        OK (update_var out (mload (w2n dw) s) s)` by
+       simp[step_inst_non_invoke, mk_inst_def, step_inst_base_opcode_eqs,
+         exec_read1_def] >>
+     drule_at (Pat `step_inst _ _ _ _ = _`) ghost_step_non_invoke >>
+     gvs[mk_inst_def]) >>
+  irule dispatched_decoder_joint_step >>
+  simp[update_var_def] >> qexists_tac `0` >>
+  simp[step_inst_non_invoke, ghost_step_non_invoke, mk_inst_def,
+    step_inst_base_opcode_eqs, exec_read1_def, update_var_def,
+    gas_events_step_def, gas_count_step_def, is_terminator_def] >>
+  conj_tac
+  >- (gen_tac >> simp_tac (srw_ss()) [ptr_safe_defs] >>
+      irule ptr_inst_ok_lower_bound_transport >>
+      conj_tac >- simp[] >> qexists_tac `0` >> simp[] >>
+      irule (SRULE [mk_inst_def] ptr_inst_ok_mload) >> simp[]) >>
+  simp[mem_safe_step_non_invoke, inst_mem_below_frontier_def,
+    source_memory_read_ranges_def, source_memory_write_ranges_def,
+    inst_dload_in_section_def, fixed_source_write_range_def]
+QED

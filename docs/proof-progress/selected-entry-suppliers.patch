+Theorem reentrant_counter_slots_frame[local]:
+  i <= maxn /\ (p+32 <= d \/ d+32+maxn*type_memory_size tv <= p) ==>
+  !j. j < i ==>
+    mem_bytes_at (d+32+j*type_memory_size tv) (type_memory_size tv)
+      (mstore p w s).vs_memory =
+    mem_bytes_at (d+32+j*type_memory_size tv) (type_memory_size tv) s.vs_memory
+Proof
+  rpt strip_tac >> irule mstore_mem_bytes_at_disjoint >>
+  `SUC j <= maxn` by decide_tac >>
+  `SUC j * type_memory_size tv <= maxn * type_memory_size tv` by
+    metis_tac[LESS_MONO_MULT] >>
+  qpat_x_assum `SUC j * _ <= _` mp_tac >>
+  pure_rewrite_tac[MULT_CLAUSES] >> decide_tac
+QED

+  LENGTH ts = LENGTH xs /\
+  (!i. i < LENGTH xs ==> type_memory_size (EL i ts) = (\(ei,az,mz). mz) (EL i xs)) /\
+  (!i ei az mz. i < LENGTH xs /\ EL i xs = (ei,az,mz) ==>

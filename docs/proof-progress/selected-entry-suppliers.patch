+Theory dispatchedDecoderReentrantDefs
+Ancestors
+  dispatchedDecoderBoundaryFrame dispatchedDecoderLoopCaseJoint
+  calldataRecursiveProducers abiDecoderCoherence calldataExact
+  bodyPtrDefs ptrDiscipline ptrSafeRun valueEncodingProps
+  words list arithmetic finite_map
+
+(* The operational input does not constrain stale generated registers. *)
+Definition calldata_reentrant_pre_def:
+  calldata_reentrant_pre ctx fn site lo st last initial src root p d tv x
+      oid base_addr cap G tn <=>
+    fn_has_code st last fn /\ fn_inst_ids_distinct fn /\
+    eval_operand src initial = SOME p /\
+    eval_operand (Var root) initial = SOME (n2w d) /\
+    abi_decoder_operand_live st.cs_next_var src /\
+    abi_decoder_operand_live st.cs_next_var (Var root) /\
+    alloca_inv initial /\ alloca_frontier_inv ctx fn site initial /\
+    calldata_loop_own fn st.cs_next_id last.cs_next_id initial /\
+    FLOOKUP initial.vs_allocas oid = SOME (base_addr,cap) /\
+    (oid < st.cs_next_id \/ last.cs_next_id <= oid) /\
+    base_addr <= d /\ d+type_memory_size tv <= base_addr+cap /\
+    d+type_memory_size tv < dimword (:256) /\
+    ~initial.vs_halted /\ initial.vs_current_bb = st.cs_current_bb /\
+    initial.vs_inst_idx = LENGTH st.cs_current_insts /\
+    ptr_covers G tn root initial (type_memory_size tv) /\
+    op_taint tn src = {} /\ op_prov G src = NONE /\
+    allocas_from lo initial /\ lo <= initial.vs_alloca_next /\
+    ~ctx_has_dalloca ctx /\ unit_alloca_budget ctx < dimword (:256) /\
+    (last.cs_current_insts = [] ==>
+      !bb. lookup_block last.cs_current_bb fn.fn_blocks = SOME bb ==>
+        phi_prefix_length bb.bb_instructions = 0) /\
+    cd_decode F initial.vs_call_ctx.cc_calldata tv (w2n p) = SOME x
+End
+
+(* Robustness permits untouched slack in nested dynamic values to remain tainted.
+   Physical and ghost facts refer to exactly the same v. *)
+Definition calldata_reentrant_post_def:
+  calldata_reentrant_post ctx fn site lo PG st last initial G tn root d tv x v H u <=>
+    ~v.vs_halted /\ v.vs_current_bb = last.cs_current_bb /\
+    v.vs_inst_idx = LENGTH last.cs_current_insts /\
+    value_has_type tv x /\ val_wf tv x /\ val_in_memory tv x d v.vs_memory /\
+    calldata_loop_frame ctx fn site st last initial d (type_memory_size tv) v /\
+    calldata_loop_joint_rel lo ctx fn PG (initial,G,tn) (v,H,u) /\
+    ptr_covers H u root v (type_memory_size tv) /\
+    (!m. mem_agree_outside u.t_mem v.vs_memory m ==> val_in_memory tv x d m) /\
+    u.t_mem SUBSET tn.t_mem /\ u.t_stor = tn.t_stor /\
+    u.t_trans = tn.t_trans /\ u.t_imm = tn.t_imm /\ allocas_from lo v /\
+    (!z. not_fresh_at st z ==> FLOOKUP H z = FLOOKUP G z /\
+      op_taint u (Var z) = op_taint tn (Var z)) /\
+    (!cutoff. last.cs_next_var <= cutoff ==> future_frame cutoff initial v)
+End
+
+Theorem calldata_reentrant_fresh_boundary:
+  calldata_reentrant_post ctx fn site lo PG st last initial G tn root d tv x v H u /\
+  fresh_vars_wrt st initial /\ st.cs_next_var <= last.cs_next_var ==>
+  fresh_vars_wrt last v
+Proof
+  simp_tac bool_ss [calldata_reentrant_post_def] >> strip_tac >>
+  irule decoder_future_frame_freshness >>
+  qexistsl_tac [`st`, `last.cs_next_var`, `initial`] >> simp[]
+QED
+
+Definition calldata_reentrant_loop_child_def:
+  calldata_reentrant_loop_child ctx fn site lo PG middle st1 srcop child root q
+    oid base_addr cap d tv maxn srcbase xs <=>
+  !a A at i w.
+    i < LENGTH xs /\
+    ~a.vs_halted /\ a.vs_current_bb = middle.cs_current_bb /\
+    a.vs_inst_idx = LENGTH middle.cs_current_insts /\
+    eval_operand srcop a = SOME w /\
+    w2n w = cd_member_ptr F a.vs_call_ctx.cc_calldata tv srcbase (i*tv_abi_size tv) /\
+    cd_decode F a.vs_call_ctx.cc_calldata tv (w2n w) = SOME (EL i xs) /\
+    eval_operand (Var child) a = SOME (n2w (d+32+i*type_memory_size tv)) /\
+    alloca_inv a /\ alloca_frontier_inv ctx fn site a /\
+    calldata_loop_own fn middle.cs_next_id st1.cs_next_id a /\
+    FLOOKUP a.vs_allocas oid = SOME (base_addr,cap) /\
+    base_addr <= d+32+i*type_memory_size tv /\
+    d+32+i*type_memory_size tv+type_memory_size tv <= base_addr+cap /\
+    d+32+i*type_memory_size tv+type_memory_size tv < dimword (:256) /\
+    ptr_covers A at child a (type_memory_size tv) /\
+    op_prov A srcop = NONE /\ op_taint at srcop = {} /\
+    allocas_from lo a /\ lo <= a.vs_alloca_next /\
+    ptr_covers A at root a (32+maxn*type_memory_size tv) /\
+    ptr_covers A at q a 32 ==>
+    ?v B bt.
+      ~v.vs_halted /\ v.vs_current_bb = st1.cs_current_bb /\
+      v.vs_inst_idx = LENGTH st1.cs_current_insts /\
+      value_has_type tv (EL i xs) /\ val_wf tv (EL i xs) /\
+      val_in_memory tv (EL i xs) (d+32+i*type_memory_size tv) v.vs_memory /\
+      calldata_loop_frame ctx fn site middle st1 a (d+32+i*type_memory_size tv)
+        (type_memory_size tv) v /\
+      calldata_loop_joint_rel lo ctx fn PG (a,A,at) (v,B,bt) /\
+      ptr_covers B bt child v (type_memory_size tv) /\
+      (!m. mem_agree_outside bt.t_mem v.vs_memory m ==>
+        val_in_memory tv (EL i xs) (d+32+i*type_memory_size tv) m) /\
+      bt.t_mem SUBSET at.t_mem /\
+      bt.t_stor = at.t_stor /\ bt.t_trans = at.t_trans /\ bt.t_imm = at.t_imm /\
+      allocas_from lo v /\
+      (!z. not_fresh_at middle z ==>
+        lookup_var z v = lookup_var z a /\ FLOOKUP B z = FLOOKUP A z /\
+        op_taint bt (Var z) = op_taint at (Var z)) /\
+      (!cutoff. st1.cs_next_var <= cutoff ==> future_frame cutoff a v)
+End
+
+(* Only the length and loop counter words must be uniformly clean. *)
+Definition calldata_reentrant_loop_invariant_def:
+  calldata_reentrant_loop_invariant ctx fn site lo st last initial initial_G initial_tn
+    header hdr src srcword root q p oid base_addr cap d tv maxn xs i (s,G,tn) <=>
+    calldata_loop_phys ctx fn site st last initial header hdr src srcword root q p
+      oid base_addr cap d tv maxn (LENGTH xs) i s /\
+    allocas_from lo s /\ lo <= s.vs_alloca_next /\
+    ptr_covers G tn root s (32+maxn*type_memory_size tv) /\
+    ptr_covers G tn q s 32 /\ op_prov G src = NONE /\ op_taint tn src = {} /\
+    (!a. p <= a /\ a < p+32 ==> a NOTIN tn.t_mem) /\
+    (!a. d <= a /\ a < d+32 ==> a NOTIN tn.t_mem) /\
+    (!j. j < i ==> value_has_type tv (EL j xs) /\ val_wf tv (EL j xs) /\
+      !m. mem_agree_outside tn.t_mem s.vs_memory m ==>
+        val_in_memory tv (EL j xs) (d+32+j*type_memory_size tv) m) /\
+    tn.t_mem SUBSET initial_tn.t_mem /\ tn.t_stor = initial_tn.t_stor /\
+    tn.t_trans = initial_tn.t_trans /\ tn.t_imm = initial_tn.t_imm /\
+    (!z. not_fresh_at st z ==> FLOOKUP G z = FLOOKUP initial_G z /\
+      op_taint tn (Var z) = op_taint initial_tn (Var z))
+End
+
+Definition calldata_reentrant_loop_output_def:
+  calldata_reentrant_loop_output ctx fn site lo st last initial initial_G initial_tn
+    root d tv maxn xs (t,H,u) <=>
+    ~t.vs_halted /\ t.vs_current_bb = last.cs_current_bb /\
+    t.vs_inst_idx = LENGTH last.cs_current_insts /\
+    value_has_type (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs)) /\
+    val_wf (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs)) /\
+    val_in_memory (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs)) d t.vs_memory /\
+    calldata_loop_frame ctx fn site st last initial d
+      (type_memory_size (ArrayTV tv (Dynamic maxn))) t /\
+    ptr_covers H u root t (type_memory_size (ArrayTV tv (Dynamic maxn))) /\
+    (!m. mem_agree_outside u.t_mem t.vs_memory m ==>
+      val_in_memory (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs)) d m) /\
+    u.t_mem SUBSET initial_tn.t_mem /\
+    u.t_stor = initial_tn.t_stor /\ u.t_trans = initial_tn.t_trans /\
+    u.t_imm = initial_tn.t_imm /\ allocas_from lo t /\
+    (!z. not_fresh_at st z ==> FLOOKUP H z = FLOOKUP initial_G z /\
+      op_taint u (Var z) = op_taint initial_tn (Var z)) /\
+    (!cutoff. last.cs_next_var <= cutoff ==> future_frame cutoff initial t)
+End
+
+Theorem calldata_reentrant_loop_child_projection:
+  (!a A at w e y.
+    calldata_reentrant_pre ctx fn site lo middle st1 a srcop child w e tv y
+      oid base_addr cap A at ==>
+    ?v B bt. calldata_reentrant_post ctx fn site lo PG middle st1 a A at
+      child e tv y v B bt) /\
+  fn_has_code middle st1 fn /\ fn_inst_ids_distinct fn /\
+  abi_decoder_operand_live middle.cs_next_var srcop /\
+  abi_decoder_operand_live middle.cs_next_var (Var child) /\
+  (oid < middle.cs_next_id \/ st1.cs_next_id <= oid) /\
+  ~ctx_has_dalloca ctx /\ unit_alloca_budget ctx < dimword (:256) /\
+  (st1.cs_current_insts = [] ==>
+    !bb. lookup_block st1.cs_current_bb fn.fn_blocks = SOME bb ==>
+      phi_prefix_length bb.bb_instructions = 0) ==>
+  calldata_reentrant_loop_child ctx fn site lo PG middle st1 srcop child root q
+    oid base_addr cap d tv maxn srcbase xs
+Proof
+  strip_tac >> simp_tac bool_ss [calldata_reentrant_loop_child_def] >>
+  rpt gen_tac >> strip_tac >>
+  `calldata_reentrant_pre ctx fn site lo middle st1 a srcop child w
+     (d+32+i*type_memory_size tv) tv (EL i xs) oid base_addr cap A at` by
+    simp[calldata_reentrant_pre_def] >>
+  first_x_assum drule >> strip_tac >>
+  qexistsl_tac [`v`, `B`, `bt`] >>
+  fs[calldata_reentrant_post_def] >>
+  rpt strip_tac >>
+  qpat_x_assum `calldata_loop_frame _ _ _ _ _ _ _ _ _` mp_tac >>
+  simp_tac bool_ss [calldata_loop_frame_def] >> strip_tac >>
+  first_x_assum (qspec_then `Var z` mp_tac) >>
+  simp[calldataDynOwnedTheory.calldata_operand_live_not_fresh,
+    venomStateTheory.eval_operand_def]
+QED
+
+Definition calldata_reentrant_loop_child_rel_def:
+  calldata_reentrant_loop_child_rel R ctx fn site lo PG middle st1 srcop child root q
+    oid base_addr cap d tv maxn srcbase xs <=>
+  !a A at i w.
+    i < LENGTH xs /\
+    ~a.vs_halted /\ a.vs_current_bb = middle.cs_current_bb /\
+    a.vs_inst_idx = LENGTH middle.cs_current_insts /\
+    eval_operand srcop a = SOME w /\
+    w2n w = cd_member_ptr F a.vs_call_ctx.cc_calldata tv srcbase (i*tv_abi_size tv) /\
+    cd_decode F a.vs_call_ctx.cc_calldata tv (w2n w) = SOME (EL i xs) /\
+    eval_operand (Var child) a = SOME (n2w (d+32+i*type_memory_size tv)) /\
+    alloca_inv a /\ alloca_frontier_inv ctx fn site a /\
+    calldata_loop_own fn middle.cs_next_id st1.cs_next_id a /\
+    FLOOKUP a.vs_allocas oid = SOME (base_addr,cap) /\
+    base_addr <= d+32+i*type_memory_size tv /\
+    d+32+i*type_memory_size tv+type_memory_size tv <= base_addr+cap /\
+    d+32+i*type_memory_size tv+type_memory_size tv < dimword (:256) /\
+    ptr_covers A at child a (type_memory_size tv) /\
+    op_prov A srcop = NONE /\ op_taint at srcop = {} /\
+    allocas_from lo a /\ lo <= a.vs_alloca_next /\
+    ptr_covers A at root a (32+maxn*type_memory_size tv) /\
+    ptr_covers A at q a 32 ==>
+    ?v B bt.
+      ~v.vs_halted /\ v.vs_current_bb = st1.cs_current_bb /\
+      v.vs_inst_idx = LENGTH st1.cs_current_insts /\
+      value_has_type tv (EL i xs) /\ val_wf tv (EL i xs) /\
+      val_in_memory tv (EL i xs) (d+32+i*type_memory_size tv) v.vs_memory /\
+      calldata_loop_frame ctx fn site middle st1 a (d+32+i*type_memory_size tv)
+        (type_memory_size tv) v /\
+      calldata_loop_joint_rel lo ctx fn PG (a,A,at) (v,B,bt) /\
+      ptr_covers B bt child v (type_memory_size tv) /\
+      (!m. mem_agree_outside bt.t_mem v.vs_memory m ==>
+        val_in_memory tv (EL i xs) (d+32+i*type_memory_size tv) m) /\
+      bt.t_mem SUBSET at.t_mem /\
+      bt.t_stor = at.t_stor /\ bt.t_trans = at.t_trans /\ bt.t_imm = at.t_imm /\
+      allocas_from lo v /\
+      (!z. not_fresh_at middle z ==>
+        lookup_var z v = lookup_var z a /\ FLOOKUP B z = FLOOKUP A z /\
+        op_taint bt (Var z) = op_taint at (Var z)) /\
+      (!cutoff. st1.cs_next_var <= cutoff ==> future_frame cutoff a v) /\ R a v
+End
+
+Theorem calldata_reentrant_loop_child_rel_true:
+  calldata_reentrant_loop_child_rel (\a b. T) ctx fn site lo PG middle st1 srcop child root q
+    oid base_addr cap d tv maxn srcbase xs <=>
+  calldata_reentrant_loop_child ctx fn site lo PG middle st1 srcop child root q
+    oid base_addr cap d tv maxn srcbase xs
+Proof
+  simp[calldata_reentrant_loop_child_rel_def,calldata_reentrant_loop_child_def]
+QED
+
+Theorem calldata_reentrant_loop_child_projection_rel:
+  (!a A at w e y.
+    calldata_reentrant_pre ctx fn site lo middle st1 a srcop child w e tv y
+      oid base_addr cap A at ==>
+    ?v B bt. calldata_reentrant_post ctx fn site lo PG middle st1 a A at
+      child e tv y v B bt /\ R a v) /\
+  fn_has_code middle st1 fn /\ fn_inst_ids_distinct fn /\
+  abi_decoder_operand_live middle.cs_next_var srcop /\
+  abi_decoder_operand_live middle.cs_next_var (Var child) /\
+  (oid < middle.cs_next_id \/ st1.cs_next_id <= oid) /\
+  ~ctx_has_dalloca ctx /\ unit_alloca_budget ctx < dimword (:256) /\
+  (st1.cs_current_insts = [] ==>
+    !bb. lookup_block st1.cs_current_bb fn.fn_blocks = SOME bb ==>
+      phi_prefix_length bb.bb_instructions = 0) ==>
+  calldata_reentrant_loop_child_rel R ctx fn site lo PG middle st1 srcop child root q
+    oid base_addr cap d tv maxn srcbase xs
+Proof
+  strip_tac >> simp_tac bool_ss [calldata_reentrant_loop_child_rel_def] >>
+  rpt gen_tac >> strip_tac >>
+  `calldata_reentrant_pre ctx fn site lo middle st1 a srcop child w
+     (d+32+i*type_memory_size tv) tv (EL i xs) oid base_addr cap A at` by
+    simp[calldata_reentrant_pre_def] >>
+  first_x_assum drule >> strip_tac >>
+  qexistsl_tac [`v`, `B`, `bt`] >>
+  fs[calldata_reentrant_post_def] >>
+  rpt strip_tac >>
+  qpat_x_assum `calldata_loop_frame _ _ _ _ _ _ _ _ _` mp_tac >>
+  simp_tac bool_ss [calldata_loop_frame_def] >> strip_tac >>
+  first_x_assum (qspec_then `Var z` mp_tac) >>
+  simp[calldataDynOwnedTheory.calldata_operand_live_not_fresh,
+    venomStateTheory.eval_operand_def]
+QED

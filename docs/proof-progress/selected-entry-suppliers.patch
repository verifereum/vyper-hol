+     rpt strip_tac >> gvs[] >> Cases_on `src` >>
+     gvs[abi_decoder_operand_live_def, abi_decoder_older_vars_def] >>
+     metis_tac[LESS_EQ_ADD]) >>
+  `EVERY (\inst. inst.inst_opcode <> INVOKE /\
+      !r. cutoff <= r ==> ~MEM (STRING #"%" (toString r)) inst.inst_outputs)
+      (emitted_insts st0 middle)` by
+    (drule (GEN_ALL (SRULE[abi_decode_outputs_below_final_def] reentrant_setup_output_bounds)) >>

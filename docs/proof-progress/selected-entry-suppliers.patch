+  st.cs_current_bb = body_lbl /\ st.cs_current_insts = [] /\
+  lookup_var p s = SOME (n2w slot) /\ slot+32 < dimword(:256) /\
+  slot+32 <= s.vs_alloca_next /\ ptr_covers G tn p s 32 /\
+  (!a. slot <= a /\ a < slot+32 ==> a NOTIN tn.t_mem) /\
+  mload slot s = n2w j /\
+  eval_operand src s = SOME (n2w sb) /\ op_taint tn src = {} /\ op_prov G src = NONE /\
+  abi_decode_load CALLDATALOAD (n2w sb:bytes32) s = n2w n /\ j < n /\ n < dimword(:256) /\
+  lookup_var root s = SOME (n2w d) /\ ptr_covers G tn root s capacity /\
+  not_fresh_at st p /\ not_fresh_at st root /\

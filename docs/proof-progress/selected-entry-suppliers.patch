+(* Fresh allocation with one concrete endpoint shared by continuation and ghosts. *)
+Theory dispatchedRegistrationAllocJoint
+Ancestors
+  ctorDeployMemoryRunPtrPrefixRegisterAlloc dispatchedDecoderTrace
+  dispatchedDecoderLoopCaseJoint successfulSequenceEndpoint fragGasOriginPtrExec
+  abiDecoderReentry
+  emitHelperProps loweringHalt context compileEnv emitHelper fragExec
+  ptrSafeRun ptrDiscipline bodyPtrDefs loweringStateRelDefs
+  venomState venomInst venomExecSemantics venomMemDefs
+  memSafeRun unitTransformDefs contextCodegenRel codegenRel gasEvents gasCount
+  finite_map words list arithmetic
+
+Theorem registration_alloc_buffer_fresh_joint:
+  compile_alloc_buffer n st = (buf,sa) /\ fn_has_code st sa fn /\
+  ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts /\
+  FLOOKUP s.vs_allocas st.cs_next_id = NONE /\
+  n < dimword(:256) /\ s.vs_alloca_next+n < dimword(:256) /\
+  fresh_vars_wrt st s /\ allocas_from lo s /\ lo <= s.vs_alloca_next /\
+  ~ctx_has_dalloca ctx ==>
+  let root = STRING #"%" (toString st.cs_next_var);
+      p = s.vs_alloca_next;
+      a = (update_var root (n2w p)
+        (s with <|vs_allocas := s.vs_allocas |+ (st.cs_next_id,(p,n));
+                  vs_alloca_next := p+n|>))
+        with vs_inst_idx := LENGTH sa.cs_current_insts;
+      H = G |+ (root,(p,n));
+      u = tn with <|t_var := tn.t_var |+ (root,{});
+                    t_mem := tn.t_mem UNION {j | p <= j /\ j < p+n}|>
+  in buf.buf_operand = Var root /\
+     calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (a,H,u) /\
+     ptr_covers H u root a n /\
+     ~a.vs_halted /\ a.vs_current_bb = sa.cs_current_bb /\
+     a.vs_inst_idx = LENGTH sa.cs_current_insts /\ fresh_vars_wrt sa a /\
+     allocas_from lo a /\ lo <= a.vs_alloca_next /\
+     a.vs_memory = s.vs_memory /\ a.vs_call_ctx = s.vs_call_ctx /\
+     a.vs_data_section = s.vs_data_section /\
+     (a with <|vs_vars := s.vs_vars; vs_allocas := s.vs_allocas;
+       vs_alloca_next := s.vs_alloca_next; vs_inst_idx := s.vs_inst_idx|>) = s /\
+     u.t_stor = tn.t_stor /\ u.t_trans = tn.t_trans /\ u.t_imm = tn.t_imm /\
+     (!v. not_fresh_at st v ==>
+       lookup_var v a = lookup_var v s /\ FLOOKUP H v = FLOOKUP G v /\
+       op_taint u (Var v) = op_taint tn (Var v)) /\
+     (!op. abi_decoder_operand_live st.cs_next_var op ==>
+       eval_operand op a = eval_operand op s) /\
+     (!v k. ptr_covers G tn v s k ==> ptr_covers H u v a k)
+Proof
+  strip_tac >> pure_rewrite_tac[LET_THM] >> BETA_TAC >>
+  qabbrev_tac `root = STRING #"%" (toString st.cs_next_var)` >>
+  qabbrev_tac `v = update_var root (n2w s.vs_alloca_next)
+    (s with <|vs_allocas := s.vs_allocas |+ (st.cs_next_id,(s.vs_alloca_next,n));
+              vs_alloca_next := s.vs_alloca_next+n|>)` >>
+  qabbrev_tac `H = G |+ (root,(s.vs_alloca_next,n))` >>
+  qabbrev_tac `u = tn with <|t_var := tn.t_var |+ (root,{});
+    t_mem := tn.t_mem UNION {j | s.vs_alloca_next <= j /\ j < s.vs_alloca_next+n}|>` >>
+  qpat_assum `n < dimword(:256)`
+    (mp_then (Pat `n < dimword(:256)`) mp_tac prefix_register_alloc_pair) >>
+  disch_then drule_all >>
+  disch_then (qspecl_then [`root`,`tn`,`0`,`fn`,`PG`,`G`,`ARB`] mp_tac) >>
+  simp_tac bool_ss [LET_THM] >> BETA_TAC >> strip_tac >>
+  drule_all prefix_register_alloc_layout >> strip_tac >>
+  `buf.buf_operand = Var root` by
+    (drule compile_alloc_buffer_parts >> simp[Abbr `root`]) >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) [] (OK (v with vs_inst_idx := LENGTH sa.cs_current_insts),H,u)` by
+    suspend "path" >>
+  `!vname. not_fresh_at st vname ==> vname <> root` by
+    (simp[not_fresh_at_def, Abbr `root`] >> metis_tac[LESS_EQ_REFL]) >>
+  simp[] >> conj_tac >- suspend "continuation" >>
+  conj_tac >- suspend "covers" >> suspend "frame"
+QED
+
+Resume registration_alloc_buffer_fresh_joint[path]:
+  rpt gen_tac >>
+  qpat_x_assum `LENGTH sa.cs_current_insts = _` (fn th => rewrite_tac[th]) >>
+  irule dispatched_decoder_joint_step >>
+  conj_tac >- simp[] >> conj_tac >- simp[Abbr `v`, update_var_def] >>
+  qexistsl_tac [`bb`,`0`,`mk_inst st.cs_next_id ALLOCA [Lit (n2w n)] [root]`] >>
+  simp[Abbr `v`, Abbr `H`, Abbr `u`, mk_inst_def, step_inst_non_invoke,
+    gas_events_step_def, gas_count_step_def, is_terminator_def] >>
+  conj_tac
+  >- (gen_tac >> irule (SRULE [mk_inst_def]
+        ctorDeployMemoryRunPtrPrefixStepsTheory.prefix_alloca_ptr_step) >> simp[]) >>
+  simp[mem_safe_step_non_invoke, inst_mem_below_frontier_def,
+    source_memory_read_ranges_def, source_memory_write_ranges_def,
+    inst_dload_in_section_def]
+QED
+Resume registration_alloc_buffer_fresh_joint[continuation]:
+  qpat_assum `!D explicit. gas_origin_ptr_path _ _ _ _`
+    (qspecl_then [`ARB`,`ARB`] mp_tac) >>
+  disch_then (mp_tac o MATCH_MP gas_origin_ptr_path_exec) >>
+  simp[exit_result_def, calldata_loop_joint_rel_def] >> metis_tac[]
+QED
+Resume registration_alloc_buffer_fresh_joint[covers]:
+  simp[ptr_covers_def, Abbr `H`, Abbr `u`, Abbr `v`,
+    op_taint_def, lookup_var_def, update_var_def, FLOOKUP_UPDATE]
+QED
+Resume registration_alloc_buffer_fresh_joint[frame]:
+  drule compile_alloc_buffer_parts >> strip_tac >>
+  simp[Abbr `v`, Abbr `H`, Abbr `u`, update_var_def,
+    lookup_var_def, op_taint_def, FLOOKUP_UPDATE,
+    fresh_vars_wrt_def, allocas_from_def, abi_decoder_operand_live_def] >>
+  conj_tac
+  >- (gvs[fresh_vars_wrt_def, Abbr `root`, ASCIInumbersTheory.toString_inj]) >>
+  conj_tac
+  >- (rpt gen_tac >> IF_CASES_TAC >> gvs[allocas_from_def] >> metis_tac[]) >>
+  conj_tac
+  >- (qpat_x_assum `s.vs_inst_idx = _` (fn th => rewrite_tac[GSYM th]) >>
+      simp[]) >>
+  conj_tac
+  >- (Cases >> simp[eval_operand_def, lookup_var_def, FLOOKUP_UPDATE] >>
+      simp[abi_decoder_older_vars_def, Abbr `root`] >> metis_tac[LESS_EQ_REFL]) >>
+  rpt strip_tac >>
+  `v' <> root` by
+    (strip_tac >> gvs[ptr_covers_def, lookup_var_def, Abbr `root`] >>
+     qpat_x_assum `fresh_vars_wrt _ _` mp_tac >>
+     simp[fresh_vars_wrt_def] >>
+     qexists_tac `st.cs_next_var` >> simp[] >>
+     metis_tac[FLOOKUP_DEF, optionTheory.NOT_SOME_NONE]) >>
+  gvs[ptr_covers_def, lookup_var_def, op_taint_def, FLOOKUP_UPDATE]
+QED
+Finalise registration_alloc_buffer_fresh_joint

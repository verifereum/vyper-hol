+Theory dispatchedDecoderReentrantExit
+Ancestors
+  dispatchedDecoderReentrantDefs dispatchedDecoderBoundaryFrame
+  abiDecoderRecursiveLoopLayout abiDecoderLoopCode dispatchedDecoderLoopCaseJoint
+  exprSimAggregateEncoding memoryValueFrame bodyPtrBopInMachineMemory
+  abiStaticAggregateProps vyperTyping valueEncodingProps valueEncodingDefs list arithmetic
+  dispatchedDecoderLoopEdgesJoint venomState venomInst venomExecSemantics
+  abiDecoderExecution abiDecoderContract ptrDiscipline bodyPtrDefs finite_map words
+  calldataDynOwned abiDecoderReentry gasOriginPtrLabels entrySinkExtraction
+  loweringStateRelDefs abiDecoderArrayInitExec pred_set fragGasOriginPtrExec
+  venomMemDefs allocaFrontierBound allocaBudgetProps abiDecoderFrame
+  dispatchedDecoderLoopCompanion entryDecoderStateFrame memSafeRun
+
+Theorem reentrant_array_elements_typed[local]:
+  !xs. (!j. j < LENGTH xs ==> value_has_type tv (EL j xs) /\ val_wf tv (EL j xs)) ==>
+    all_have_type tv xs /\ elems_val_wf xs tv
+Proof
+  Induct >- simp[value_has_type_def,val_wf_def] >>
+  gen_tac >> strip_tac >>
+  `value_has_type tv h /\ val_wf tv h` by
+    (first_x_assum (qspec_then `0` mp_tac) >> simp[]) >>
+  `all_have_type tv xs /\ elems_val_wf xs tv` by
+    (first_x_assum irule >> gen_tac >> strip_tac >>
+     first_x_assum (qspec_then `SUC j` mp_tac) >> simp[]) >>
+  simp[value_has_type_def,val_wf_def]
+QED
+
+(* Clean length plus robust occupied elements; unused capacity is unrestricted. *)
+Theorem reentrant_dynarray_robust:
+  LENGTH xs <= maxn /\ mem_word_at d mem = n2w (LENGTH xs) /\
+  (!a. d <= a /\ a < d+32 ==> a NOTIN dirty) /\
+  (!j. j < LENGTH xs ==> value_has_type tv (EL j xs) /\ val_wf tv (EL j xs) /\
+    !m. mem_agree_outside dirty mem m ==>
+      val_in_memory tv (EL j xs) (d+32+j*type_memory_size tv) m) ==>
+  value_has_type (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs)) /\
+  val_wf (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs)) /\
+  (!m. mem_agree_outside dirty mem m ==>
+    val_in_memory (ArrayTV tv (Dynamic maxn)) (ArrayV (DynArrayV xs)) d m)
+Proof
+  strip_tac >>
+  `all_have_type tv xs /\ elems_val_wf xs tv` by
+    (irule reentrant_array_elements_typed >> metis_tac[]) >>
+  simp[value_has_type_def,val_wf_def,val_in_memory_dynarray] >>
+  gen_tac >> strip_tac >> conj_tac
+  >- (drule_all mem_agree_outside_window >>
+      metis_tac[mem_word_at_bytes]) >>
+  irule elems_in_memory_intro >> simp[]
+QED
+
+Theorem calldata_reentrant_loop_exit_joint_companion:
+  lookup_block hdr fn.fn_blocks = SOME
+    <|bb_label := hdr; bb_instructions :=
+      abi_decode_header_insts id (Var q) src CALLDATALOAD iv cv cmp done body_lbl exit|> /\
+  lookup_block exit fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  last.cs_current_bb = exit /\ last.cs_current_insts = [] /\
+  ~ctx_has_dalloca ctx /\ p < dimword (:256) /\ p+32 <= s.vs_alloca_next /\
+  LENGTH xs < dimword (:256) /\
+  abi_decode_load CALLDATALOAD srcword s = n2w (LENGTH xs) /\
+  (!v. MEM v [iv;cv;cmp;done] ==> q <> v /\ root <> v /\ src <> Var v) /\
+  iv <> cv /\
+  (!v z. MEM v [iv;cv;cmp;done] /\ not_fresh_at st z ==> z <> v) /\
+  (!r. last.cs_next_var <= r ==>
+    ~MEM (STRING #"%" (toString r)) [iv;cv;cmp;done]) /\
+  future_frame last.cs_next_var initial s /\ last.cs_next_var <= cutoff /\
+  calldata_reentrant_loop_invariant ctx fn site lo st last initial initial_G initial_tn
+    header hdr src srcword root q p oid base_addr cap d tv maxn xs (LENGTH xs) (s,G,tn) ==>
+  ?b. calldata_reentrant_loop_output ctx fn site lo st last initial initial_G initial_tn
+        root d tv maxn xs b /\
+      calldata_loop_framed_joint_rel cutoff lo ctx fn PG (s,G,tn) b /\
+      entry_decoder_obs s (FST b) /\
+      ((!fuel. mem_safe_run fuel ctx fn (FST b)) ==>
+        !fuel. mem_safe_run fuel ctx fn s)
+Proof
+  disch_then (map_every assume_tac o CONJUNCTS) >>
+  qpat_x_assum `calldata_reentrant_loop_invariant _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _`
+    mp_tac >>
+  simp_tac bool_ss [calldata_reentrant_loop_invariant_def,calldata_loop_phys_def] >>
+  strip_tac >>
+  `mem_word_taint tn.t_mem (w2n (n2w p:bytes32)) = {} /\
+   w2n (n2w p:bytes32) = p` by
+    (simp[mem_word_taint_def,EXTENSION,w2n_n2w] >>
+     gen_tac >> Cases_on `x < 32` >> simp[] >>
+     first_x_assum irule >> decide_tac) >>
+  `src <> Var iv` by metis_tac[MEM] >>

+Theorem loop_budget_allocation_choice[local]:
+  abi_decoder_budget first last b cap s /\ id IN abi_decoder_ids first last ==>
+  ?p. (FLOOKUP s.vs_allocas id = NONE /\ p = s.vs_alloca_next /\
+       p+32 < dimword (:256)) \/
+      (FLOOKUP s.vs_allocas id = SOME (p,32) /\ p+32 <= s.vs_alloca_next /\
+       s.vs_alloca_next < dimword (:256))
+Proof
+  strip_tac >> Cases_on `FLOOKUP s.vs_allocas id`
+  >- (drule_all abi_decoder_missing_credit >> strip_tac >>
+      qexists_tac `s.vs_alloca_next` >> simp[] >>
+      qpat_x_assum `abi_decoder_budget _ _ _ _ _` mp_tac >>
+      pure_rewrite_tac[abi_decoder_budget_def] >> strip_tac >> decide_tac) >>
+  rename1 `SOME pair` >> PairCases_on `pair` >>
+  qpat_x_assum `abi_decoder_budget _ _ _ _ _` mp_tac >>
+  pure_rewrite_tac[abi_decoder_budget_def] >> strip_tac >>
+  qpat_x_assum `!id off sz. _ ==> sz = 32 /\ _` drule >>
+  disch_then drule >> strip_tac >> qexists_tac `pair0` >> simp[] >> decide_tac
+QED

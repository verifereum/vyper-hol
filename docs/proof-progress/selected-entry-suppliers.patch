+  `dispatched_registration_caller ctx fn site lo PG first limit_st t H u old` by
+    simp[dispatched_registration_caller_def] >>
+  `calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (t,H,u)` by
+    metis_tac[dispatchedDecoderLoopCaseJointTheory.calldata_loop_joint_rel_trans] >>
+  suspend "ownership"
+QED
+
+Resume dispatched_registration_singleton_prefix_owned[ownership]:
+  `not_fresh_at allocated (STRING #"%" (toString st.cs_next_var))` by
+    (simp[not_fresh_at_def] >> decide_tac) >>
+  `u.t_stor = tn.t_stor /\ u.t_trans = tn.t_trans /\ u.t_imm = tn.t_imm` by
+    simp[Abbr `ta`] >>
+  suspend "publish"
+QED
+
+Resume dispatched_registration_singleton_prefix_owned[publish]:
+  `ptr_covers H u (STRING #"%" (toString st.cs_next_var)) t n` by
+    (simp[ptr_covers_def] >>
+     qpat_assum `ptr_covers Ga ta _ a n`
+       (mp_tac o REWRITE_RULE [ptr_covers_def]) >> simp[]) >>
+  `eval_operand buf.buf_operand t = SOME (n2w s.vs_alloca_next)` by
+    (simp[eval_operand_def] >>
+     `lookup_var (STRING #"%" (toString st.cs_next_var)) t =
+      lookup_var (STRING #"%" (toString st.cs_next_var)) a` by metis_tac[] >>
+     simp[Abbr `a`, update_var_def, lookup_var_def, FLOOKUP_UPDATE]) >>
+  `abi_decoder_operand_live first.cs_next_var buf.buf_operand` by
+    (simp[abi_decoder_operand_live_def, abi_decoder_older_vars_def] >> decide_tac) >>
+  `abi_decode_load CALLDATALOAD (4w + n2w (off-4):bytes32) a =
+   abi_decode_load CALLDATALOAD (4w + n2w (off-4):bytes32) s` by
+    (simp[abi_decode_load_def, abi_decode_source_def] >> REFL_TAC) >>
+  `entry_decoder_obs s t` by
+    metis_tac[entryDecoderStateFrameTheory.entry_decoder_obs_trans] >>
+  `!op. abi_decoder_operand_live st.cs_next_var op ==>
+    eval_operand op t = eval_operand op s` by
+    (rpt strip_tac >> `!v. op = Var v ==> not_fresh_at allocated v` by
+       (Cases_on `op` >> gvs[abi_decoder_operand_live_def,
+         abi_decoder_older_vars_def, not_fresh_at_def] >> decide_tac) >> metis_tac[]) >>
+  `FLOOKUP H (STRING #"%" (toString st.cs_next_var)) = SOME (s.vs_alloca_next,n)` by
+    ( `FLOOKUP H (STRING #"%" (toString st.cs_next_var)) =
+       FLOOKUP Ga (STRING #"%" (toString st.cs_next_var))` by metis_tac[] >>
+      simp[Abbr `Ga`, FLOOKUP_UPDATE]) >>
+  drule_all actual_alloc_buffer_site >> strip_tac >>
+  qexistsl_tac [`buf.buf_operand`, `src`, `first`, `t`, `H`, `u`, `s.vs_alloca_next`] >>
+  simp[dispatched_registration_ready_def] >>
+  conj_tac
+  >- (qexists_tac `mk_inst st.cs_next_id ALLOCA [Lit (n2w n)]
+        [STRING #"%" (toString st.cs_next_var)]` >> simp[mk_inst_def]) >>
+  simp[FLOOKUP_UPDATE] >>
+  qpat_assum `calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (t,H,u)`
+    (mp_tac o REWRITE_RULE
+      [dispatchedDecoderLoopCaseJointTheory.calldata_loop_joint_rel_def]) >>
+  metis_tac[]
+QED
+Finalise dispatched_registration_singleton_prefix_owned

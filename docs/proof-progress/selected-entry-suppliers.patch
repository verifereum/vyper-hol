+Resume calldata_decoder_loop_prepare_joint[head_values]:
+  simp[NoAsms,Abbr `head`,abi_decode_header_state_def,jump_to_def,
+    update_var_def,lookup_var_def,FLOOKUP_UPDATE,mload_def] >>
+  simp[DISJ_IMP_THM,FORALL_AND_THM] >>
+  Cases_on `src` >>
+  fs[eval_operand_def,lookup_var_def,FLOOKUP_UPDATE,mload_def,
+    DISJ_IMP_THM,FORALL_AND_THM]
+QED

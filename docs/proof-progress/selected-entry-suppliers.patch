+Theorem registration_decoder_histories:
+  calldata_loop_frame ctx fn site first last t p n v /\
+  calldata_loop_joint_rel lo ctx fn PG (t,H,u) (v,J,z) /\
+  fn_inst_ids_distinct fn /\ alloca_history fn t /\ alloca_inv t /\
+  abi_alloca_history (fn_insts fn) t ==>
+  alloca_history fn v /\ abi_alloca_history (fn_insts fn) v
+Proof
+  strip_tac >> conj_tac
+  >- (gvs[calldata_loop_joint_rel_def] >>
+      metis_tac[body_full_path_alloca_history]) >>
+  qpat_x_assum `calldata_loop_frame _ _ _ _ _ _ _ _ _`
+    (strip_assume_tac o REWRITE_RULE [calldata_loop_frame_def]) >>
+  fs[calldata_loop_own_def] >>
+  simp_tac bool_ss [abi_alloca_history_def] >>
+  rpt strip_tac >> Cases_on `id < first.cs_next_id \/ last.cs_next_id <= id`
+  >- (`FLOOKUP t.vs_allocas id = SOME (off,sz)` by metis_tac[] >>
+      qpat_x_assum `abi_alloca_history _ t`
+        (mp_tac o REWRITE_RULE [abi_alloca_history_def]) >>
+      disch_then drule >> simp[]) >>
+  `first.cs_next_id <= id /\ id < last.cs_next_id` by decide_tac >>
+  first_x_assum drule_all >> strip_tac >>
+  qexistsl_tac [`ins`, `32w`] >> simp[dimword_def]

+Proof
+  strip_tac >>
+  `out_taint tn (mk_inst id opc ops [out]) s = {}` by
+    (gvs[] >> simp[out_taint_def, mk_inst_def] >>
+     Cases_on `ops` >> simp[out_taint_def] >>
+     Cases_on `t` >> simp[out_taint_def] >>
+     Cases_on `eval_operand h s` >> simp[] >>
+     Cases_on `t'` >> simp[] >> metis_tac[]) >>
+  drule_at (Pat `out_taint _ _ _ = {}`) calldata_decoder_read_ghost >>
+  simp[] >> disch_then (qspecl_then [`w`,`PG`,`G`] strip_assume_tac) >>
+  `step_inst 0 ctx (mk_inst id opc ops [out]) s = OK (update_var out w s)` by
+    (gvs[] >> simp[step_inst_non_invoke, mk_inst_def]) >>
+  `ghost_step 0 ctx PG G tn (mk_inst id opc ops [out]) s =
+     (DRESTRICT G (COMPL {out}),tn with t_var := tn.t_var |+ (out,{}))` by
+    (drule_at (Pat `step_inst _ _ _ _ = _`) ghost_step_non_invoke >>
+     gvs[mk_inst_def]) >>
+  irule dispatched_decoder_joint_step >>
+  simp[update_var_def] >> qexists_tac `0` >>
+  gvs[] >>
+  simp[mk_inst_def, gas_events_step_def, gas_count_step_def,
+    is_terminator_def, mem_safe_step_non_invoke,
+    inst_mem_below_frontier_def, source_memory_read_ranges_def,
+    source_memory_write_ranges_def, update_var_def] >>
+  gen_tac >> simp_tac (srw_ss()) [ptr_safe_defs, ptr_inst_ok_def,
+    mk_inst_def, access_ok_def, taint_ok_def,
+    source_memory_read_ranges_def, source_memory_write_ranges_def] >>
+  gvs[GSYM mk_inst_def, step_inst_non_invoke, update_var_def] >>
+  rpt strip_tac >> gvs[] >>
+  gvs[DISJ_IMP_THM, FORALL_AND_THM, op_prov_def, flookup_thm] >>

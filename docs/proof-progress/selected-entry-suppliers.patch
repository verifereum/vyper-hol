+(* Proof-only accumulator interface for accepted positional registration. *)
+Theory dispatchedRegistrationResultDefs
+Ancestors
+  dispatchedRegistrationPrefixResources dispatchedDecoderReentrantDefs
+  calldataRegistrationExec vyperCalldata dispatchedDecoderLoopCaseJoint
+  finite_map words list arithmetic
+
+Definition registration_outputs_def:
+  registration_outputs fn ce st s G tn owners specs outputs <=>
+    LIST_REL (\(name,prim,dyn,sz,ty,tv) (x,dst,p,id).
+      ?root ins. dst = Var root /\
+        FLOOKUP ce.ce_vars name = SOME (PtrVar dst (type_memory_size tv)) /\
+        MEM (root,id,p,type_memory_size tv,tv,x) owners /\
+        MEM ins (fn_insts fn) /\ ins.inst_opcode = ALLOCA /\
+        ins.inst_outputs = [root] /\ ins.inst_id = id) specs outputs
+End
+
+Definition registration_result_def:
+  registration_result ctx fn site lo PG st last limit_st initial G tn old
+      cef specs xs v H u owners outputs <=>
+    dispatched_registration_caller ctx fn site lo PG last limit_st v H u owners /\
+    EVERY (\owner. MEM owner owners) old /\
+    registration_outputs fn cef last v H u owners specs outputs /\
+    MAP (\(x,dst,p,id). x) outputs = xs /\
+    calldata_loop_joint_rel lo ctx fn PG (initial,G,tn) (v,H,u) /\
+    entry_decoder_obs initial v /\
+    (!op. abi_decoder_operand_live st.cs_next_var op ==>
+      eval_operand op v = eval_operand op initial) /\
+    (!id entry. FLOOKUP initial.vs_allocas id = SOME entry ==>
+      FLOOKUP v.vs_allocas id = SOME entry) /\
+    initial.vs_alloca_next <= v.vs_alloca_next /\
+    u.t_stor = tn.t_stor /\ u.t_trans = tn.t_trans /\ u.t_imm = tn.t_imm /\
+    (!fuel r. run_from fuel ctx fn v = r /\ (!err. r <> Error err) ==>
+      ?fuel'. run_from fuel' ctx fn initial = r /\
+        (mem_safe_run fuel ctx fn v ==> mem_safe_run fuel' ctx fn initial)) /\
+    ((!fuel. mem_safe_run fuel ctx fn v) ==> !fuel. mem_safe_run fuel ctx fn initial)
+End
+
+Definition registration_input_def:
+  registration_input ctx fn site lo PG ce env sf specs ofs st cef last limit_st
+      initial G tn old xs <=>
+    compile_register_positional_args ce
+      (MAP (\(name,prim,dyn,sz,ty,tv).
+        (name,prim,dyn,sz,type_to_abi_dec_info sf ce ty)) specs)
+      (4+ofs) st = (cef,last) /\
+    calldata_decode_args initial.vs_call_ctx.cc_calldata
+      (MAP (\(name,prim,dyn,sz,ty,tv). tv) specs) ofs = SOME xs /\
+    dispatched_registration_caller ctx fn site lo PG st limit_st initial G tn old /\
+    fn_has_code st last fn /\ fn_inst_ids_distinct fn /\
+    ALL_DISTINCT (MAP (\i. i.inst_id) (fn_insts fn)) /\
+    unit_alloca_budget ctx < dimword (:256) /\ ~ctx_has_dalloca ctx /\
+    (last.cs_current_insts = [] ==>
+      !bb. lookup_block last.cs_current_bb fn.fn_blocks = SOME bb ==>
+        phi_prefix_length bb.bb_instructions = 0) /\
+    last.cs_next_var <= limit_st.cs_next_var /\
+    ALL_DISTINCT (MAP (\(name,prim,dyn,sz,ty,tv). name) specs) /\
+    EVERY (\(name,prim,dyn,sz,ty,tv).
+      abi_decoder_coherent ce env sf ty tv /\
+      (?loc. FLOOKUP ce.ce_vars name = SOME loc /\
+        var_location_memory_size loc = SOME (type_memory_size tv)) /\
+      dyn = tv_abi_dynamic tv /\ sz = tv_abi_size tv /\
+      (prim ==> ~dyn /\ ?c. type_to_abi_dec_info sf ce ty = DecPrimWord c) /\
+      type_memory_size tv < dimword (:256)) specs /\
+    4+ofs+SUM (MAP (\(name,prim,dyn,sz,ty,tv). tv_abi_size tv) specs) < dimword (:256)
+End
+
+Theorem registration_outputs_nil[simp]:
+  registration_outputs fn ce st s G tn owners [] outputs <=> outputs = []
+Proof
+  simp[registration_outputs_def]
+QED
+
+Theorem registration_outputs_length:
+  registration_outputs fn ce st s G tn owners specs outputs ==>
+  LENGTH specs = LENGTH outputs
+Proof
+  simp[registration_outputs_def] >> metis_tac[LIST_REL_LENGTH]
+QED
+
+Theorem registration_outputs_member:
+  registration_outputs fn ce st s G tn owners specs outputs /\
+  MEM (name,prim,dyn,sz,ty,tv) specs ==>
+  ?x dst p id root ins.
+    MEM (x,dst,p,id) outputs /\ dst = Var root /\
+    FLOOKUP ce.ce_vars name = SOME (PtrVar dst (type_memory_size tv)) /\
+    MEM (root,id,p,type_memory_size tv,tv,x) owners /\
+    MEM ins (fn_insts fn) /\ ins.inst_opcode = ALLOCA /\
+    ins.inst_outputs = [root] /\ ins.inst_id = id
+Proof
+  simp_tac bool_ss [registration_outputs_def] >> strip_tac >>
+  drule_all LIST_REL_MEM_IMP >> simp[pairTheory.EXISTS_PROD] >> metis_tac[]
+QED
+
+Theorem registration_result_nil:
+  dispatched_registration_caller ctx fn site lo PG st limit_st s G tn old ==>
+  registration_result ctx fn site lo PG st st limit_st s G tn old
+    ce [] [] s G tn old []
+Proof
+  strip_tac >>
+  `~s.vs_halted` by metis_tac[dispatched_registration_caller_cursor] >>
+  simp[registration_result_def, registration_outputs_def,
+    EVERY_MEM, entryDecoderStateFrameTheory.entry_decoder_obs_def,
+    calldata_loop_joint_rel_refl] >>
+  rpt strip_tac >> qexists_tac `fuel` >> simp[]
+QED
diff --git a/lowering/dispatchedRegistrationSourceResourcesScript.sml b/lowering/dispatchedRegistrationSourceResourcesScript.sml
new file mode 100644
index 000000000..f9f0f915b
--- /dev/null
+++ b/lowering/dispatchedRegistrationSourceResourcesScript.sml
@@ -0,0 +1,123 @@
+(* Initial resources independent of the canonical entry and body tower. *)
+Theory dispatchedRegistrationSourceResources
+Ancestors
+  compileVyper vyperCompiler e2eDefs loweringShapeSource o1PipelineCorrect
+  ctorDeployMemoryFrontier acceptedContextPhi entryDispatchProps
+  registrationSizeAdmissibility entryDecoderBudgetBoundary
+  venomState venomInst venomMemDefs ptrDiscipline bodyPtrDefs
+  vyperLoweringCorrect moduleLoweringProps
+  supportedProgram supportedDecls finite_map words list arithmetic
+
+Theorem dispatched_registration_supported_no_dalloca:
+  lower_vyper_runtime_unit tops rpolicy = SOME unit /\
+  supported_program tops /\ source_typing_ok tops am tx ==>
+  ~ctx_has_dalloca unit.cu_context
+Proof
+  strip_tac >>
+  `raw_shape_free_program tops` by
+    metis_tac[supported_program_raw_shape_free_program] >>
+  `o1_source_unit_ok unit` by
+    (fs[source_typing_ok_def] >>
+     drule_all lower_vyper_runtime_unit_source_unit_ok_checked >> simp[]) >>
+  metis_tac[o1_source_unit_ok_no_dalloca]
+QED
+
+Theorem dispatched_registration_external_allocs_ok:
+  lower_vyper_runtime_unit tops rpolicy = SOME unit /\
+  supported_program tops /\ name <> "__default__" /\
+  vyperInterpreter$lookup_function NONE name External tops =
+    SOME (mut,nr,args,defaults,ret,fbody) ==>
+  ?rr:bool. fn_allocs_ok tops (mut,nr,rr,name,args,defaults,ret,fbody)
+Proof
+  strip_tac >>
+  `supported_declaration_headers tops` by fs[supported_program_def] >>
+  drule_all supported_headers_external_member >> strip_tac >>
+  Cases_on `classify_functions tops` >> PairCases_on `r` >> gvs[] >>
+  qexists_tac `rr` >> irule lower_vyper_runtime_unit_allocs_ok >>
+  metis_tac[]
+QED
+
+Theorem dispatched_registration_start_resources[local]:
+  initial_venom_state_rel tops am tx vs /\ vars_pc_only vs s ==>
+  s.vs_allocas = FEMPTY /\ s.vs_alloca_next = 0 /\
+  s.vs_memory = [] /\ alloca_inv s /\ allocas_from lower s /\
+  s.vs_call_ctx = vs.vs_call_ctx
+Proof
+  simp[initial_venom_state_rel_def, vars_pc_only_def,
+       venom_state_component_equality] >> rpt strip_tac >>
+  simp[alloca_inv_def, allocas_non_overlapping_def,
+       alloca_next_valid_def, allocas_from_def]
+QED
+
+Theorem dispatched_registration_empty_frontier[local]:
+  lowering_context_ok ctx /\ ctx.ctx_entry = SOME name /\
+  venomInst$lookup_function name ctx.ctx_functions = SOME fn /\ s.vs_alloca_next = 0 ==>
+  alloca_frontier_inv ctx fn site s /\ unit_alloca_budget ctx < dimword (:256)
+Proof
+  strip_tac >> drule_all lowered_unit_entry_facts >> strip_tac >>
+  `fn.fn_name = name /\ MEM fn ctx.ctx_functions` by
+    metis_tac[lookup_function_result_name, lookup_function_MEM] >>
+  `fcg_is_reachable (fcg_analyze ctx) name` by
+    (irule fcgCorrectnessProofTheory.fcg_analyze_reachable_complete_proof >>
+     simp[fcgDefsTheory.fcg_path_def, venomInstTheory.ctx_fn_names_def] >>
+     metis_tac[lookup_function_mem]) >>
+  reverse conj_tac
+  >- (fs[lowering_context_ok_def] >> decide_tac) >>
+  simp[allocaFrontierBoundTheory.alloca_frontier_inv_def] >> conj_tac
+  >- (rpt strip_tac >>
+      `reachable_fcg_acyclic ctx (fcg_analyze ctx)` by fs[lowering_context_ok_def] >>
+      `fcg_is_reachable (fcg_analyze ctx) g` by
+        metis_tac[fcgPostorderTheory.reachable_fcg_acyclic_tc_rank] >>
+      metis_tac[fcgPostorderTheory.reachable_fcg_acyclic_no_reachable_cycle]) >>
+  simp_tac bool_ss [unit_alloca_budget_def, LET_THM] >>
+  qmatch_goalsub_abbrev_tac `CARD below * frame + r <= (1+n)*frame` >>
+  `r <= frame` by
+    simp[Abbr `r`, Abbr `frame`, allocaFrontierBoundTheory.remaining_alloca_budget_frame] >>
+  `CARD below <= n` by
+    simp[Abbr `below`, Abbr `n`, allocaFrontierBoundTheory.call_targets_card] >>
+  `CARD below * frame <= n * frame` by (irule LESS_MONO_MULT >> simp[]) >>
+  full_simp_tac bool_ss [RIGHT_ADD_DISTRIB, MULT_LEFT_1] >> decide_tac
+QED
+
+Theorem dispatched_registration_runtime_acceptance[local]:
+  lower_vyper_runtime_unit tops policy = SOME unit ==>
+  lowering_context_ok unit.cu_context /\ unit.cu_context.ctx_entry = SOME "__entry"
+Proof
+  simp[lower_vyper_runtime_unit_def, bool_case_eq] >>
+  Cases_on `classify_functions tops` >> PairCases_on `r` >> simp[] >>
+  strip_tac >> Cases_on `EXISTS external_has_defaults q` >> gvs[]
+  >- (conj_tac
+      >- metis_tac[run_grouped_lowering_context] >>
+      qpat_x_assum `run_grouped_lowering _ _ _ _ _ = SOME _` mp_tac >>
+      simp[run_grouped_lowering_def] >> rpt strip_tac >>
+      pairarg_tac >>
+      gvs[AllCaseEqs(), extract_context_with_internals_def, mk_venom_context_def]) >>
+  metis_tac[run_lowering_context_ok, run_lowering_entry]
+QED

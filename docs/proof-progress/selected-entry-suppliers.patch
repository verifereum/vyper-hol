+Theorem calldata_loop_init_observation_pull:
+  abi_decode_array_loop_init (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+    maxn abi_sz sa = (setup,sb) /\
+  fn_has_code sa sb fn /\
+  lookup_block sb.cs_current_bb fn.fn_blocks = SOME jumpbb /\
+  get_instruction jumpbb (LENGTH sb.cs_current_insts) =
+    SOME (mk_inst jid JMP [Label hdr] []) /\
+  lookup_block hdr fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  ~s.vs_halted /\ s.vs_current_bb = sa.cs_current_bb /\
+  s.vs_inst_idx = LENGTH sa.cs_current_insts /\
+  lookup_var root s = SOME (n2w d) /\ d < dimword(:256) /\
+  not_fresh_at sa root /\ (!x. src = Var x ==> not_fresh_at sa x) /\
+  eval_operand src s = SOME (n2w off) /\
+  abi_decode_load CALLDATALOAD (n2w off:bytes32) s = n2w n /\
+  n <= maxn /\ maxn < dimword(:256) /\
+  abi_decoder_budget first last b cap s /\ first <= sa.cs_next_id /\ sb.cs_next_id <= last /\
+  alloca_inv s /\ FLOOKUP s.vs_allocas oid = SOME (owner_base,extent) /\
+  owner_base <= d /\ d + capacity <= owner_base + extent /\ 32 <= capacity /\
+  run_inst_seq (emitted_insts sa sb) s = OK t ==>
+  entry_decoder_obs s (jump_to hdr t) /\
+  ((!fuel. mem_safe_run fuel ctx fn (jump_to hdr t)) ==>
+   !fuel. mem_safe_run fuel ctx fn s)
+Proof
+  strip_tac >>
+  `abi_decode_source_opcode CALLDATALOAD` by simp[abi_decode_source_opcode_def] >>
+  drule_all abi_decode_array_loop_init_shape >> strip_tac >>
+  drule_all abi_decode_array_loop_init_site_bounds >> strip_tac >>
+  `sb.cs_next_id-2 IN abi_decoder_ids first last` by simp[abi_decoder_ids_def] >>
+  drule_all loop_budget_allocation_choice >> strip_tac >>
+  (`abi_decoder_operand_live sa.cs_next_var src /\
+   abi_decoder_operand_live sa.cs_next_var (Var root)` by
+    (Cases_on `src` >> fs[abi_decoder_operand_live_def,calldata_operand_live_not_fresh]) >>
+  `d+32 <= s.vs_alloca_next` by
+    (qpat_assum `alloca_inv s` mp_tac >>
+     pure_rewrite_tac[alloca_inv_def,alloca_next_valid_def] >>
+     strip_tac >>
+     qpat_x_assum `!aid base sz. FLOOKUP _ _ = _ ==> _`
+       (qspec_then `oid` mp_tac) >> simp[] >> decide_tac) >>
+  `run_inst_seq_mem_ok (emitted_insts sa sb) s` by
+    (ho_match_mp_tac (GEN_ALL loop_init_mem_ok) >>
+     goal_assum (drule_at (Pos hd)) >>
+     qexistsl_tac [`p`,`n`,`d`,`off`] >> simp[eval_operand_def]) >>
+  drule_all abi_decode_array_loop_init_reentry_code >> strip_tac >>
+  drule_all entry_decoder_sequence_obs >> strip_tac >>
+  conj_tac >- simp[entry_decoder_obs_def,jump_to_def] >>
+  mp_tac (Q.INST [`P` |-> `\s:venom_state. T`, `st` |-> `sa`, `ready` |-> `sb`]
+    (SPEC_ALL successful_sequence_endpoint)) >>
+  asm_simp_tac (srw_ss()) [LET_THM] >> strip_tac >>
+  qabbrev_tac `entry = t with vs_inst_idx := LENGTH sb.cs_current_insts` >>
+  `((!fuel. mem_safe_run fuel ctx fn (jump_to hdr t)) ==>
+    !fuel. mem_safe_run fuel ctx fn entry)` suffices_by metis_tac[] >>
+  ho_match_mp_tac (GEN_ALL decoder_edge_all_fuel_pullback) >>
+  qexistsl_tac [`target`,`jumpbb`] >>
+  fs[Abbr `entry`,jump_to_def] >>
+  conj_tac
+  >- (gen_tac >> simp[Once run_block_non_phis_def,
+        step_inst_def,step_inst_base_opcode_eqs,mk_inst_def,is_terminator_def,jump_to_def]) >>
+  gen_tac >> simp[Once mem_safe_block_def,mem_safe_step_non_invoke,mk_inst_def,
+    inst_mem_below_frontier_def,source_memory_read_ranges_def,source_memory_write_ranges_def,
+    step_inst_def,is_terminator_def,venomExecPropsTheory.step_jmp_behavior])
+QED

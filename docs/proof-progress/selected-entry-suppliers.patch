+(* Source-decoder acceptance at the actual positional offset. *)
+Theory dispatchedRegistrationSource
+Ancestors
+  vyperCalldata calldataSourceCorrespondence calldataSourceSize
+  calldataSourceDecisions calldataRegistration abiDecoderCoherence
+  words list arithmetic
+
+Theorem registration_source_head:
+  calldata_decode_args cd (tv::tvs) ofs = SOME xs ==>
+  ?x rest. xs = x::rest /\
+    4 <= (if tv_abi_dynamic tv then
+      (4+w2n (cd_word cd (4+ofs))) MOD dimword (:256) else 4+ofs) /\
+    cd_decode F cd tv (if tv_abi_dynamic tv then
+      (4+w2n (cd_word cd (4+ofs))) MOD dimword (:256) else 4+ofs) = SOME x /\
+    calldata_decode_args cd tvs (ofs+tv_abi_size tv) = SOME rest
+Proof
+  simp[Once calldata_decode_args_def, AllCaseEqs()] >>
+  rpt strip_tac >> gvs[] >> metis_tac[NOT_LESS]
+QED
+
+Theorem registration_source_prefix_address:
+  4+ofs < dimword (:256) /\ dyn = tv_abi_dynamic tv /\
+  (prim ==> ~dyn) ==>
+  w2n (if dyn /\ ~prim then n2w 4 + abi_decode_load CALLDATALOAD
+    (n2w 4 + n2w ((4+ofs)-4):bytes32) s
+    else n2w 4 + n2w ((4+ofs)-4):bytes32) =
+  (if tv_abi_dynamic tv then
+    (4+w2n (cd_word s.vs_call_ctx.cc_calldata (4+ofs))) MOD dimword (:256)
+    else 4+ofs)
+Proof
+  strip_tac >> `dyn /\ ~prim <=> dyn` by metis_tac[] >>
+  simp[calldata_decode_load_word, word_add_n2w, w2n_n2w,
+    arithmeticTheory.LESS_MOD] >>
+  Cases_on `dyn` >> gvs[wordsTheory.word_add_def,
+    wordsTheory.w2n_n2w]
+QED
+
+Theorem registration_source_prefix_guard:
+  4+ofs < dimword (:256) /\ dyn = tv_abi_dynamic tv /\ (prim ==> ~dyn) /\
+  calldata_decode_args s.vs_call_ctx.cc_calldata (tv::tvs) ofs = SOME xs ==>
+  (dyn /\ ~prim ==> ~(n2w 4 + abi_decode_load CALLDATALOAD
+    (n2w 4 + n2w ((4+ofs)-4):bytes32) s <+ 4w))
+Proof
+  strip_tac >> drule registration_source_head >> strip_tac >>
+  drule_all registration_source_prefix_address >>
+  disch_then (qspec_then `s` assume_tac) >>
+  strip_tac >>
+  qpat_x_assum `calldata_decode_args _ (tv::tvs) _ = _` kall_tac >>
+  qpat_x_assum `cd_decode _ _ _ _ = _` kall_tac >>
+  qpat_x_assum `calldata_decode_args _ tvs _ = _` kall_tac >>
+  fs[WORD_LO, w2n_n2w] >> gvs[]
+QED
+
+Theorem registration_positional_source_metadata:
+  abi_decoder_coherent ce env ce.ce_struct_fields ty tv ==>
+  ?prim dyn sz info.
+    build_positional_arg ce (name,ty) = (name,prim,dyn,sz,info) /\
+    dyn = tv_abi_dynamic tv /\ sz = tv_abi_size tv /\
+    info = type_to_abi_dec_info ce.ce_struct_fields ce ty /\
+    (prim ==> ~dyn /\ ?c. info = DecPrimWord c)
+Proof
+  strip_tac >> simp[compileVyperTheory.build_positional_arg_def] >>
+  drule calldata_coherent_dynamic >> drule calldata_coherent_embedded_size >>
+  rpt strip_tac >> simp[] >>
+  `is_word_type ty ==> ?c. type_to_abi_dec_info ce.ce_struct_fields ce ty = DecPrimWord c` by
+    metis_tac[word_type_decoder_primitive] >>
+  `is_word_type ty ==> ~tv_abi_dynamic tv` by
+    (strip_tac >> first_x_assum drule >> strip_tac >>
+     drule calldata_coherent_offset >>
+     simp[abiEncoderTheory.dec_info_needs_offset_def]) >> metis_tac[]
+QED

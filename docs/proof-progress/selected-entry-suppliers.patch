+  qpat_x_assum `compile_register_positional_args _ _ _ _ = _`
+    (strip_assume_tac o PURE_ONCE_REWRITE_RULE [SIMP_RULE (srw_ss()) []
+      (Q.SPEC `[(name,prim,dyn,sz,type_to_abi_dec_info sf ce ty)]`
+        register_positional_args_append)]) >>
+  drule registration_source_head >> strip_tac >>
+  `st.cs_next_var <= stm.cs_next_var /\ stm.cs_next_var <= last.cs_next_var` by
+    metis_tac[registration_compile_counters] >>
+  `cs_extends st stm /\ cs_extends stm last` by
+    metis_tac[register_positional_args_suffix_extends] >>
+  `fn_has_code st stm fn /\ fn_has_code stm last fn` by
+    metis_tac[fragExecTheory.fn_has_code_split] >>
+  `stm.cs_current_insts = [] ==>
+    !bb. lookup_block stm.cs_current_bb fn.fn_blocks = SOME bb ==>
+      phi_prefix_length bb.bb_instructions = 0` by
+    (rpt strip_tac >> metis_tac[registration_suffix_empty_phi]) >>
+  qexistsl_tac [`cenvm`,`stm`,`x`,`rest'`] >>
+  gvs[] >> simp[] >>
+  gvs[vyperCalldataTheory.calldata_decode_args_def]
+QED
+
+Theorem registration_input_cons_tail:
+  registration_input ctx fn site lo PG ce env sf
+    ((name,prim,dyn,sz,ty,tv)::rest) ofs st cef last limit_st initial G tn old (x::ys) /\
+  compile_register_positional_args ce
+    [(name,prim,dyn,sz,type_to_abi_dec_info sf ce ty)] (4+ofs) st = (cem,mid) /\
+  compile_register_positional_args cem
+    (MAP (\(n,p,d,z,t,v). (n,p,d,z,type_to_abi_dec_info sf ce t)) rest)
+    (4+ofs+sz) mid = (cef,last) /\
+  calldata_decode_args initial.vs_call_ctx.cc_calldata
+    (MAP (\(n,p,d,z,t,v). v) rest) (ofs+sz) = SOME ys /\
+  registration_result ctx fn site lo PG st mid limit_st initial G tn old
+    cem [(name,prim,dyn,sz,ty,tv)] [x] t H u owners outs ==>
+  registration_input ctx fn site lo PG cem env sf rest (ofs+sz)
+    mid cef last limit_st t H u owners ys
+Proof
+  strip_tac >>
+  `cem.ce_struct_fields = ce.ce_struct_fields /\
+   cem.ce_flag_n_members = ce.ce_flag_n_members` by
+    metis_tac[registration_env_fields] >>
+  `!ty. type_to_abi_dec_info sf cem ty = type_to_abi_dec_info sf ce ty` by
+    metis_tac[registration_dec_info_env_cong] >>

+(* Concrete singleton registration on the actual accepted calldata. *)
+Theory dispatchedRegistrationStep
+Ancestors
+  dispatchedRegistrationResultDefs dispatchedRegistrationSource
+  dispatchedRegistrationPrefixOwned dispatchedDecoderRegistrationResources
+  dispatchedDecoderAcceptedCompanion dispatchedRegistrationDecoderFrame
+  dispatchedRegistrationPrefixResources abiDecoderCounters
+  finite_map words list arithmetic
+
+Theorem registration_singleton_joint:
+  !ctx fn site lo PG ce env sf name prim dyn sz ty tv ofs st cef last limit_st
+      initial G tn old xs.
+    registration_input ctx fn site lo PG ce env sf [(name,prim,dyn,sz,ty,tv)]
+      ofs st cef last limit_st initial G tn old xs ==>
+    ?v H u owners outputs.
+      registration_result ctx fn site lo PG st last limit_st initial G tn old
+        cef [(name,prim,dyn,sz,ty,tv)] xs v H u owners outputs
+Proof
+  rpt gen_tac >> strip_tac >>
+  qpat_x_assum `registration_input _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _`
+    (strip_assume_tac o REWRITE_RULE [registration_input_def]) >>
+  fs[] >>
+  drule registration_source_head >> strip_tac >>
+  `4+ofs < dimword (:256)` by decide_tac >>
+  `prim ==> ~dyn` by metis_tac[] >>
+  `dyn /\ ~prim ==> ~(n2w 4 + abi_decode_load CALLDATALOAD
+    (n2w 4 + n2w ((4+ofs)-4):bytes32) initial <+ 4w)` by
+    ((metis_tac[registration_source_prefix_guard])) >>
+  `cd_decode F initial.vs_call_ctx.cc_calldata tv
+    (w2n (if dyn /\ ~prim then n2w 4 + abi_decode_load CALLDATALOAD
+      (n2w 4 + n2w ((4+ofs)-4):bytes32) initial
+      else n2w 4 + n2w ((4+ofs)-4))) = SOME x` by
+    (metis_tac[registration_source_prefix_address]) >>
+  gvs[] >>
+  `prim ==> ?c. type_to_abi_dec_info sf ce ty = DecPrimWord c` by metis_tac[] >>
+  drule_all (SIMP_RULE (boss_ss()) []
+    (Q.INST [`off` |-> `4+ofs`] (SPEC_ALL dispatched_registration_singleton_prefix_owned))) >>
+  strip_tac >>
+  `?root. dst = Var root` by fs[dispatched_registration_ready_def] >>
+  gvs[] >>
+  drule_all calldata_registration_joint_decoder_applicable >> strip_tac >>
+  `fresh_vars_wrt first ready` by
+    metis_tac[dispatched_registration_ready_resources, dispatched_registration_caller_fresh] >>
+  `compile_abi_decode_to_buf (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+    (type_to_abi_dec_info sf ce ty) first = ((),last)` by
+    fs[dispatched_registration_ready_def] >>
+  drule_all calldata_exact_accepted_joint_companion >>
+  disch_then (qspec_then `PG` strip_assume_tac) >>
+  `first.cs_next_var <= last.cs_next_var` by
+    metis_tac[abi_decoder_variable_counter] >>
+  `first.cs_next_id <= last.cs_next_id` by
+    (mp_tac (cj 1 abiDecoderCodeTheory.abi_decoder_code_mutual) >>
+     disch_then (qspecl_then [`Var root`, `src`, `CALLDATALOAD`, `Lit 0w`,
+       `Lit 0w`, `type_to_abi_dec_info sf ce ty`] mp_tac) >>
+     simp[abiDecoderCodeTheory.abi_decoder_code_def] >>
+     disch_then (qspec_then `first` mp_tac) >> simp[]) >>
+  `rest = []` by fs[vyperCalldataTheory.calldata_decode_args_def] >>
+  gvs[] >>
+  irule_at Any registration_decoder_result >>
+  goal_assum (drule_at Any) >> simp[] >>
+  goal_assum (drule_at Any) >> simp[] >>
+  goal_assum (drule_at Any) >> simp[] >>
+  goal_assum (drule_at Any) >> simp[]
+QED

+       strip_tac >> gvs[] >> imp_res_tac inst_extends_emit_op >>
+       metis_tac[inst_extends_trans]) >> metis_tac[inst_extends_emit_op]) >>
+  `emitted_insts st fin = emitted_insts st mid ++ emitted_insts mid fin` by
+    (qspecl_then [`st`,`mid`,`fin`] mp_tac emitted_insts_append >> fs[inst_extends_def]) >>

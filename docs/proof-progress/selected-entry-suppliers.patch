+(* This suffix uses the actual ghost endpoint of the three emitted instructions. *)
+Theorem calldata_reentrant_backedge_slots_joint:
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME bb /\
+  bb.bb_instructions = prefix ++
+    [mk_inst id ADD [Var iv;Lit 1w] [nv];
+     mk_inst (id+1) MSTORE [Var q;Var nv] [];
+     mk_inst (id+2) JMP [Label hdr] []] /\
+  s.vs_inst_idx = LENGTH prefix /\
+  lookup_block hdr fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  eval_operand (Var iv) s = SOME w /\ eval_operand (Var q) s = SOME (n2w p) /\
+  q <> nv /\ ptr_covers G tn q s 32 /\ op_taint tn (Var iv) = {} /\
+  p < dimword (:256) /\ p+32 <= s.vs_alloca_next /\
+  i <= maxn /\ (p+32 <= d \/ d+32+maxn*type_memory_size tv <= p) /\
+  (!j. j < i ==> value_has_type tv (EL j xs) /\ val_wf tv (EL j xs) /\
+    !m. mem_agree_outside tn.t_mem s.vs_memory m ==>
+      val_in_memory tv (EL j xs) (d+32+j*type_memory_size tv) m) ==>
+  ?H u.
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) []
+      (OK (jump_to hdr (mstore p (w+1w) (update_var nv (w+1w) s))),H,u)) /\
+    u.t_mem SUBSET tn.t_mem /\
+    (!j. j < i ==> value_has_type tv (EL j xs) /\ val_wf tv (EL j xs) /\
+      !m. mem_agree_outside u.t_mem
+        (jump_to hdr (mstore p (w+1w) (update_var nv (w+1w) s))).vs_memory m ==>
+        val_in_memory tv (EL j xs) (d+32+j*type_memory_size tv) m)
+Proof
+  disch_then (map_every assume_tac o CONJUNCTS) >>
+  `w2n (n2w p:bytes32)+32 <= s.vs_alloca_next` by simp[] >>
+  drule_all calldata_decoder_loop_backedge_ghost_joint >>
+  disch_then (qspec_then `PG` mp_tac) >>
+  simp[] >> strip_tac >> qexistsl_tac [`H`, `tm`] >>
+  conj_tac >- simp[] >>
+  conj_tac >- simp[] >>
+  gen_tac >> strip_tac >>
+  qpat_x_assum `!j. j < i ==> _` (drule_then strip_assume_tac) >>
+  simp[] >> rpt strip_tac >> irule robust_val_in_memory_shrinking_frame >>
+  conj_tac >- simp[] >>
+  qexistsl_tac [`tn.t_mem`, `tm.t_mem`, `s.vs_memory`,
+    `(jump_to hdr (mstore p (w+1w) (update_var nv (w+1w) s))).vs_memory`,
+    `type_memory_size tv`] >>
+  simp[val_footprint_le] >>
+  simp[jump_to_def,mstore_def,update_var_def] >>
+  mp_tac (Q.INST [`w` |-> `w+1w`, `s` |-> `s`] reentrant_counter_slots_frame) >>
+  simp[mstore_def] >> gvs[]
+QED

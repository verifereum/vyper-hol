+  qexistsl_tac [`q`,`HG`,`u`,`t with vs_inst_idx := LENGTH fin.cs_current_insts`] >>
+  simp[fresh_vars_wrt_def, eval_op_inst_idx] >>
+  conj_tac >- suspend "path" >>

+    eval_operand op u = eval_operand op initial) /\
+  abi_decode_footprint_frame ((d,bufsize)::scratch) initial u /\
+  (!q k. MEM (q,k) scratch ==> ?id. st.cs_next_id <= id /\ id < end_st.cs_next_id /\

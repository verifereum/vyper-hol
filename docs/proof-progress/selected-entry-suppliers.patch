+
+Theorem registration_actual_address_joint_physical:
+  emit_op ADD [Lit (n2w 4); Lit (n2w (off-4))] st = (head,after_head) /\
+  (if dyn /\ ~prim then
+    ?offset after_load after_src.
+      emit_op CALLDATALOAD [head] after_head = (offset,after_load) /\
+      emit_op ADD [Lit (n2w 4); offset] after_load = (src,after_src) /\
+      compile_abi_arg_ptr_guard CALLDATALOAD src (Lit 4w) after_src = ((),first)
+   else src = head /\ first = after_head) /\
+  (dyn /\ ~prim ==> ~((n2w 4 + abi_decode_load CALLDATALOAD
+    (n2w 4 + n2w (off-4):bytes32) s) <+ 4w)) /\
+  fn_has_code st first fn /\ fn_inst_ids_distinct fn /\
+  allocas_from lo s /\ lo <= s.vs_alloca_next /\ ~ctx_has_dalloca ctx /\
+  ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts /\
+  fresh_vars_wrt limit s /\ first.cs_next_var <= limit.cs_next_var /\
+  alloca_inv s /\ alloca_frontier_inv ctx fn site s /\ alloca_history fn s ==>
+  ?t H u.
+    calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (t,H,u) /\
+    ~t.vs_halted /\ t.vs_current_bb = first.cs_current_bb /\
+    t.vs_inst_idx = LENGTH first.cs_current_insts /\ fresh_vars_wrt limit t /\
+    eval_operand src t = SOME
+      (if dyn /\ ~prim then n2w 4 + abi_decode_load CALLDATALOAD
+         (n2w 4 + n2w (off-4):bytes32) s else n2w 4 + n2w (off-4)) /\
+    abi_decoder_operand_live first.cs_next_var src /\
+    op_taint u src = {} /\ op_prov H src = NONE /\
+    t = s with <|vs_vars := t.vs_vars; vs_inst_idx := LENGTH first.cs_current_insts|> /\
+    (!op. (!x. op = Var x ==> not_fresh_at st x) ==>
+      eval_operand op t = eval_operand op s) /\
+    (!x. not_fresh_at st x ==> lookup_var x t = lookup_var x s /\
+      FLOOKUP H x = FLOOKUP G x /\ op_taint u (Var x) = op_taint tn (Var x)) /\
+    u.t_mem = tn.t_mem /\ u.t_stor = tn.t_stor /\
+    u.t_trans = tn.t_trans /\ u.t_imm = tn.t_imm /\
+    alloca_inv t /\ alloca_frontier_inv ctx fn site t /\ alloca_history fn t /\
+    entry_decoder_obs s t /\
+    ((!fuel. mem_safe_run fuel ctx fn t) ==> !fuel. mem_safe_run fuel ctx fn s) /\
+    (!fuel r. run_from fuel ctx fn t = r /\ (!err. r <> Error err) ==>
+      ?fuel'. run_from fuel' ctx fn s = r /\
+        (mem_safe_run fuel ctx fn t ==> mem_safe_run fuel' ctx fn s))
+Proof
+  strip_tac >> Cases_on `dyn /\ ~prim`
+  >- suspend "dynamic" >> gvs[] >>
+  mp_tac (Q.INST [`dyn` |-> `F`, `lower` |-> `lo`, `src` |-> `head`, `first` |-> `after_head`]
+    (SPEC_ALL registration_prelude_joint_physical)) >> simp[] >> strip_tac >>
+  qexistsl_tac [`t`, `H`, `u`] >>
+  fs[registration_address_physical_def, calldata_loop_joint_rel_def] >>
+  drule gas_path_mem_exec >> simp[exit_result_def]
+QED
+
+Resume registration_actual_address_joint_physical[dynamic]:
+  gvs[] >>
+  `cs_extends st after_head /\ cs_extends after_head after_load /\
+   cs_extends after_load after_src /\ cs_extends after_src first` by
+    (drule registration_ptr_guard_extends >> strip_tac >>
+     imp_res_tac emit_op_extends >> simp[] >> rpt conj_tac >>
+     irule cs_extends_same_block >> gvs[same_blocks_def, IS_PREFIX_APPEND]) >>
+  `cs_extends st after_src` by metis_tac[cs_extends_trans] >>
+  `fn_has_code st after_src fn /\ fn_has_code after_src first fn` by
+    metis_tac[fn_has_code_split] >>
+  `after_src.cs_next_var <= first.cs_next_var /\
+   st.cs_next_var <= after_src.cs_next_var` by
+    (drule registration_ptr_guard_code >>
+     imp_res_tac emitted_insts_emit_op >> strip_tac >> decide_tac) >>
+  `after_src.cs_next_var <= limit.cs_next_var` by decide_tac >>
+  mp_tac (Q.INST [`dyn` |-> `T`, `first` |-> `after_src`, `lower` |-> `lo`]
+    (SPEC_ALL registration_prelude_joint_physical)) >> simp[] >> strip_tac >>
+  rename1 `gas_path_mem ctx fn s 0 (OK a)` >>
+  rename1 `op_taint ta src = {}` >> rename1 `op_prov Ga src = NONE` >>
+  `!x. src = Var x ==> not_fresh_at after_src x` by
+    (Cases_on `src` >> gvs[abi_decoder_operand_live_def,
+      abi_decoder_older_vars_def, not_fresh_at_def]) >>
+  `allocas_from lo a` by
+    (qpat_assum `a = s with <|vs_vars := _; vs_inst_idx := _|>`
+      (fn th => once_rewrite_tac[th]) >> fs[allocas_from_def] >> metis_tac[]) >>
+  drule_all registration_ptr_guard_joint_success_limit >>
+  disch_then (qspec_then `PG` strip_assume_tac) >>
+  suspend "guard"
+QED
+
+Resume registration_actual_address_joint_physical[guard]:
+  `alloca_inv a /\ alloca_frontier_inv ctx fn site a /\ alloca_history fn a` by
+    fs[registration_address_physical_def] >>
+  `registration_address_physical ctx fn site a t` by
+    (drule_all registration_ptr_guard_exact_frame >>
+     simp[registration_address_physical_def]) >>
+  `registration_address_physical ctx fn site s t` by
+    metis_tac[registration_address_physical_trans] >>
+  qpat_x_assum `t = update_var _ _ _ with vs_inst_idx := _` kall_tac >>
+  suspend "join"
+QED
+
+Resume registration_actual_address_joint_physical[join]:
+  `!x. not_fresh_at st x ==> not_fresh_at after_src x` by
+    (simp[not_fresh_at_def] >> rpt strip_tac >> decide_tac) >>
+  `eval_operand src t = eval_operand src a` by metis_tac[] >>
+  `op_taint u src = {} /\ op_prov H src = NONE` by
+    (Cases_on `src` >> gvs[op_taint_def, op_prov_def] >> metis_tac[]) >>
+  `abi_decoder_operand_live first.cs_next_var src` by
+    (Cases_on `src` >> gvs[abi_decoder_operand_live_def,
+      abi_decoder_older_vars_def] >> decide_tac) >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) [] (OK t,H,u)` by
+    (rpt gen_tac >> irule gas_origin_ptr_path_trans >>
+     qexistsl_tac [`Ga`, `a`, `ta`] >> simp[]) >>
+  `calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (t,H,u)` by
+    (simp[calldata_loop_joint_rel_def] >>
+     dxrule gas_path_mem_exec >> simp[exit_result_def] >> strip_tac >>
+     dxrule gas_path_mem_exec >> simp[exit_result_def] >> strip_tac >>
+     rpt strip_tac >>
+     qpat_x_assum `!fuel. (!e. run_from fuel ctx fn t <> Error e) ==> _`
+       (qspec_then `fuel` mp_tac) >> simp[] >> strip_tac >>
+     qpat_x_assum `!fuel. (!e. run_from fuel ctx fn a <> Error e) ==> _`
+       (qspec_then `fuel'` mp_tac) >> simp[] >> metis_tac[]) >>
+  qexistsl_tac [`t`, `H`, `u`] >> fs[registration_address_physical_def] >>
+  qpat_assum `t = a with <|vs_vars := _; vs_inst_idx := _|>`
+    (fn th => once_rewrite_tac[th]) >>
+  qpat_assum `a = s with <|vs_vars := _; vs_inst_idx := _|>`
+    (fn th => once_rewrite_tac[th]) >> simp[]
+QED
+
+Finalise registration_actual_address_joint_physical

+(* Unlike compile_lit_byte_offset, emit_op emits an ADD even for zero. *)
+Theorem calldata_member_destination_add_joint:
+  emit_op ADD [Var root; Lit (n2w off)] sa = (out,sb) /\
+  fn_has_code sa sb func /\ ~ctx_has_dalloca ctx /\
+  s.vs_current_bb = sa.cs_current_bb /\
+  s.vs_inst_idx = LENGTH sa.cs_current_insts /\ ~s.vs_halted /\
+  lookup_var root s = SOME a /\ ptr_covers G tn root s capacity /\
+  off + needed <= capacity /\ w2n a + off < dimword(:256) /\
+  allocas_from lo s ==>
+  ?q Gf tnf sf.
+    out = Var q /\
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,func,PG)
+      (s,G,tn) [] (OK sf,Gf,tnf)) /\
+    sf.vs_current_bb = sb.cs_current_bb /\
+    sf.vs_inst_idx = LENGTH sb.cs_current_insts /\ ~sf.vs_halted /\
+    lookup_var q sf = SOME (a + n2w off) /\ ptr_covers Gf tnf q sf needed /\
+    (sf with <|vs_vars := s.vs_vars; vs_inst_idx := s.vs_inst_idx|>) = s /\
+    sf.vs_allocas = s.vs_allocas /\ sf.vs_data_section = s.vs_data_section /\
+    sf.vs_memory = s.vs_memory /\ sf.vs_call_ctx = s.vs_call_ctx /\
+    tnf.t_mem = tn.t_mem /\ tnf.t_stor = tn.t_stor /\
+    tnf.t_trans = tn.t_trans /\ tnf.t_imm = tn.t_imm /\
+    (!p. not_fresh_at sa p ==>
+      lookup_var p sf = lookup_var p s /\ FLOOKUP Gf p = FLOOKUP G p /\
+      op_taint tnf (Var p) = op_taint tn (Var p))
+Proof
+  strip_tac >>
+  `eval_operand (Lit (n2w off)) s = SOME (n2w off) /\
+   op_taint tn (Lit (n2w off)) = {} /\
+   op_prov G (Lit (n2w off)) = NONE` by
+    simp[eval_operand_def, op_taint_def, op_prov_def] >>
+  drule emitted_insts_emit_op >> strip_tac >>
+  qabbrev_tac `t = update_var ("%" ++ toString sa.cs_next_var) (a + n2w off) s` >>
+  `run_inst_seq (emitted_insts sa sb) s = OK t` by
+    simp[run_inst_seq_def, step_inst_base_opcode_eqs, mk_inst_def,
+      exec_pure2_def, eval_operand_def, Abbr `t`] >>
+  drule_all emit_ptr_offset_endpoint_ptr_origin_core >>
+  disch_then (qspecl_then [`ARB`,`ARB`,`ctx`,`PG`,`ARB`] strip_assume_tac) >>
+  qexistsl_tac [`q`,`HG`,`u`,`t with vs_inst_idx := SUC s.vs_inst_idx`] >>
+  `sb.cs_current_bb = sa.cs_current_bb /\
+   LENGTH sb.cs_current_insts = SUC (LENGTH sa.cs_current_insts)` by
+    gvs[emit_op_def, emit_inst_def, fresh_var_def, fresh_id_def, emit_def,
+      comp_bind_def, comp_ignore_bind_def, comp_return_def] >>
+  qpat_x_assum `frag_exec_ptr _ _ _ _ _ _ _ _ _` kall_tac >>
+  gvs[Abbr `t`, update_var_def, lookup_var_def, FLOOKUP_UPDATE,
+    venom_state_component_equality, GSYM word_add_n2w]
+QED
+
+Theorem calldata_member_address_accepted_joint:
+  (do ep <- compile_getelemptr_abi src dyn ao CALLDATALOAD (Lit 0w) (Lit 0w);
+      dp <- emit_op ADD [Var root; Lit (n2w vo)]; return (ep,dp) od) st = ((ep,dp),fin) /\
+  fn_has_code st fin func /\ ~ctx_has_dalloca ctx /\
+  s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts /\ ~s.vs_halted /\
+  fresh_vars_wrt st s /\ eval_operand src s = SOME p /\
+  lookup_var root s = SOME a /\ not_fresh_at st root /\
+  (!q. src = Var q ==> not_fresh_at st q) /\
+  ptr_covers G tn root s capacity /\ op_taint tn src = {} /\ op_prov G src = NONE /\
+  vo + needed <= capacity /\ w2n a + vo < dimword(:256) /\ allocas_from lo s ==>
+  ?q Gf tnf sf.
+    dp = Var q /\
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,func,PG)
+      (s,G,tn) [] (OK sf,Gf,tnf)) /\
+    sf.vs_current_bb = fin.cs_current_bb /\
+    sf.vs_inst_idx = LENGTH fin.cs_current_insts /\ ~sf.vs_halted /\
+    eval_operand dp sf = SOME (a + n2w vo) /\ ptr_covers Gf tnf q sf needed /\
+    eval_operand ep sf = SOME
+      (if dyn then p + abi_decode_load CALLDATALOAD (p + n2w ao) s else p + n2w ao) /\
+    op_taint tnf ep = {} /\ op_prov Gf ep = NONE /\ fresh_vars_wrt fin sf /\
+    sf.vs_allocas = s.vs_allocas /\ sf.vs_data_section = s.vs_data_section /\
+    sf.vs_memory = s.vs_memory /\ sf.vs_call_ctx = s.vs_call_ctx /\
+    tnf.t_mem = tn.t_mem /\ tnf.t_stor = tn.t_stor /\
+    tnf.t_trans = tn.t_trans /\ tnf.t_imm = tn.t_imm /\
+    (!x. not_fresh_at st x ==>
+      lookup_var x sf = lookup_var x s /\ FLOOKUP Gf x = FLOOKUP G x /\
+      op_taint tnf (Var x) = op_taint tn (Var x))
+Proof
+  strip_tac >>
+  drule calldata_member_address_shape >> strip_tac >>
+  `eval_operand (Var root) s = SOME a` by simp[eval_operand_def] >>
+  drule_all calldata_member_address_sequence >> strip_tac >>
+  qpat_x_assum `(do _ <- _; _ od) st = _` mp_tac >>
+  simp[comp_bind_def, comp_return_def] >>
+  pairarg_tac >> simp[] >> pairarg_tac >> simp[] >> strip_tac >> gvs[] >>
+  rename1 `compile_getelemptr_abi src dyn ao CALLDATALOAD (Lit 0w) (Lit 0w) st = (ep,mid)` >>
+  rename1 `emit_op ADD [Var root; Lit (n2w vo)] mid = (dp,fin)` >>
+  `inst_extends st mid /\ inst_extends mid fin` by
+    (conj_tac >-
+      (Cases_on `dyn` >>
+       qpat_x_assum `compile_getelemptr_abi _ _ _ _ _ _ _ = _` mp_tac >>
+       simp[compile_getelemptr_abi_def, compile_abi_dec_addr_def, comp_bind_def, comp_ignore_bind_def,
+         comp_return_def] >> rpt (pairarg_tac >> gvs[]) >>
+       strip_tac >> gvs[] >> imp_res_tac inst_extends_emit_op >>
+       metis_tac[inst_extends_trans]) >> metis_tac[inst_extends_emit_op]) >>
+  `emitted_insts st fin = emitted_insts st mid ++ emitted_insts mid fin` by
+    (qspecl_then [`st`,`mid`,`fin`] mp_tac emitted_insts_append >> fs[inst_extends_def]) >>
+  `?v. run_inst_seq (emitted_insts st mid) s = OK v` by
+    (spose_not_then assume_tac >>
+     qspecl_then [`emitted_insts st mid`,`emitted_insts mid fin`,`s`] mp_tac run_inst_seq_append_err >>
+     gvs[]) >>
+  rename1 `run_inst_seq (emitted_insts st mid) s = OK prepared` >>
+  `run_inst_seq (emitted_insts mid fin) prepared = OK t` by
+    (qpat_assum `run_inst_seq (emitted_insts st mid) s = _`
+       (mp_then Any mp_tac run_inst_seq_append) >>
+     disch_then (qspec_then `emitted_insts mid fin` mp_tac) >> fs[]) >>
+  drule_all calldata_ep_source_frag_ptr_origin_core >>
+  disch_then (qspecl_then [`ARB`,`ARB`,`ctx`,`PG`,`ARB`] strip_assume_tac) >>
+  rename1 `op_taint u1 ep = {}` >> rename1 `op_prov H1 ep = NONE` >>
+  `same_blocks st mid /\ same_blocks mid fin` by
+    (drule emit_op_same_blocks >> gvs[same_blocks_def]) >>
+  `cs_extends st mid /\ cs_extends mid fin` by
+    (conj_tac >> irule cs_extends_same_block >> fs[inst_extends_def, same_blocks_def]) >>
+  `fn_has_code st mid func /\ fn_has_code mid fin func` by
+    metis_tac[fn_has_code_split] >>
+  `EVERY (\i. i.inst_opcode <> INVOKE /\ ~is_terminator i.inst_opcode)
+     (emitted_insts st mid)` by
+    (fs[EVERY_APPEND] >> fs[EVERY_MEM]) >>
+  `~prepared.vs_halted /\ prepared.vs_current_bb = s.vs_current_bb` by
+    (drule_all run_inst_seq_preserves_entry_control >> simp[]) >>
+  `lookup_var root prepared = SOME a /\ ptr_covers H1 u1 root prepared capacity` by
+    (qpat_assum `!q. not_fresh_at st q ==> _`
+       (qspec_then `root` assume_tac) >> gvs[ptr_covers_def]) >>
+  qabbrev_tac `sp = prepared with vs_inst_idx := LENGTH mid.cs_current_insts` >>
+  `run_inst_seq (emitted_insts mid fin) sp = OK (t with vs_inst_idx := sp.vs_inst_idx)` by
+    (qpat_assum `emit_op ADD _ mid = _` (mp_then Any mp_tac emit_op_run_pc) >>
+     disch_then (qspecl_then [`prepared`,`sp.vs_inst_idx`] mp_tac) >>
+     simp[is_terminator_def, exec_result_map_def, Abbr `sp`]) >>
+  `lookup_var root sp = SOME a /\ ptr_covers H1 u1 root sp capacity /\
+   eval_operand (Lit (n2w vo)) sp = SOME (n2w vo) /\
+   op_taint u1 (Lit (n2w vo)) = {} /\ op_prov H1 (Lit (n2w vo)) = NONE /\
+   vo + needed <= capacity /\ w2n a + vo < dimword(:256)` by
+    gvs[Abbr `sp`, lookup_var_def, ptr_covers_def, eval_operand_def, op_taint_def, op_prov_def] >>
+  drule_all emit_ptr_offset_endpoint_ptr_origin_core >>
+  disch_then (qspecl_then [`ARB`,`ARB`,`ctx`,`PG`,`ARB`] strip_assume_tac) >>
+  `!x. not_fresh_at st x ==> not_fresh_at mid x` by
+    (drule abi_decoder_member_pointer_counters >>
+     strip_tac >> Cases_on `dyn` >> gvs[not_fresh_at_def] >> decide_tac) >>
+  `!x. ep = Var x ==> not_fresh_at mid x` by
+    (drule abi_decoder_member_pointer_counters >> strip_tac >>
+     Cases_on `ep` >> gvs[abi_decoder_operand_live_def, abi_decoder_older_vars_def, not_fresh_at_def]) >>
+  `op_taint u ep = {} /\ op_prov HG ep = NONE` by
+    (Cases_on `ep` >> gvs[op_taint_def, op_prov_def] >> metis_tac[]) >>
+  `~t.vs_halted /\ t.vs_current_bb = s.vs_current_bb` by
+    (qpat_assum `run_inst_seq (emitted_insts st fin) s = OK t`
+       (mp_then Any mp_tac run_inst_seq_preserves_entry_control) >>
+     impl_tac >- fs[EVERY_CONJ] >> simp[]) >>
+  qexistsl_tac [`q`,`HG`,`u`,`t with vs_inst_idx := LENGTH fin.cs_current_insts`] >>
+  simp[fresh_vars_wrt_def, eval_op_inst_idx] >>
+  conj_tac >- suspend "path" >>
+  conj_tac >- (gvs[ptr_covers_def, lookup_var_def]) >>
+  rpt strip_tac >> gvs[Abbr `sp`, lookup_var_def, fresh_vars_wrt_def] >>
+  first_x_assum (drule_then strip_assume_tac) >> gvs[]
+QED
+
+Resume calldata_member_address_accepted_joint[path]:
+  rpt gen_tac >>
+  qpat_x_assum `!D lower explicit ctx' func. _ ==> gas_origin_ptr_path _ (s,G,tn) _ _`
+    (qspecl_then [`D`,`lo`,`explicit`,`ctx`,`func`] mp_tac) >>
+  simp[] >> strip_tac >>

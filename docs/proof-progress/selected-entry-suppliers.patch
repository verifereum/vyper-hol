+Theorem dispatched_registration_initial_ptr_resources:
+  lower_vyper_runtime_unit tops policy = SOME unit /\
+  initial_venom_state_rel tops am tx vs /\
+  vars_pc_only (vs with <| vs_prev_bb := NONE; vs_current_bb := elbl;
+    vs_inst_idx := 0 |>) s /\
+  venomInst$lookup_function "__entry" unit.cu_context.ctx_functions = SOME fn /\
+  ~ctx_has_dalloca unit.cu_context ==>
+  s.vs_allocas = FEMPTY /\ s.vs_alloca_next = 0 /\ s.vs_memory = [] /\
+  alloca_inv s /\ allocas_from 0 s /\ s.vs_call_ctx = vs.vs_call_ctx /\
+  alloca_frontier_inv unit.cu_context fn site s /\
+  unit_alloca_budget unit.cu_context < dimword (:256) /\
+  (!label bb. lookup_block label fn.fn_blocks = SOME bb ==>
+    phi_prefix_length bb.bb_instructions = 0)
+Proof
+  strip_tac >>
+  `vars_pc_only vs s` by gvs[vars_pc_only_def, venom_state_component_equality] >>
+  drule_all dispatched_registration_start_resources >>
+  disch_then (qspec_then `0` strip_assume_tac) >>
+  drule dispatched_registration_runtime_acceptance >> strip_tac >>
+  drule_all dispatched_registration_empty_frontier >>
+  disch_then (qspec_then `site` strip_assume_tac) >>
+  asm_rewrite_tac [] >> rpt strip_tac >>
+  irule lowering_context_ok_block_phi >>
+  goal_assum (drule_at Any) >> goal_assum (drule_at Any) >>
+  asm_rewrite_tac [] >> qexists_tac `"__entry"` >> asm_rewrite_tac []
+QED
diff --git a/lowering/dispatchedRegistrationSourceScript.sml b/lowering/dispatchedRegistrationSourceScript.sml

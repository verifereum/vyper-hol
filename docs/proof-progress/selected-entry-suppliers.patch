+Theorem registration_input_cons_head:
+  registration_input ctx fn site lo PG ce env sf
+    ((name,prim,dyn,sz,ty,tv)::rest) ofs st cef last limit_st initial G tn old xs ==>
+  ?cem mid x ys.
+    xs = x::ys /\
+    compile_register_positional_args ce
+      [(name,prim,dyn,sz,type_to_abi_dec_info sf ce ty)] (4+ofs) st = (cem,mid) /\
+    compile_register_positional_args cem
+      (MAP (\(n,p,d,z,t,v). (n,p,d,z,type_to_abi_dec_info sf ce t)) rest)
+      (4+ofs+sz) mid = (cef,last) /\
+    calldata_decode_args initial.vs_call_ctx.cc_calldata
+      (MAP (\(n,p,d,z,t,v). v) rest) (ofs+sz) = SOME ys /\
+    st.cs_next_var <= mid.cs_next_var /\

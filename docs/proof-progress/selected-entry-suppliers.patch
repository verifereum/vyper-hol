+(* The whole header selects its endpoint before horizon quantification. *)
+Theorem calldata_decoder_loop_header_joint[local]:
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME
+    <|bb_label := hdr; bb_instructions :=
+      abi_decode_header_insts id (Var p) src CALLDATALOAD iv cv cmp done body_lbl exit|> /\
+  s.vs_inst_idx = 0 /\
+  lookup_block (if j<n then body_lbl else exit) fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  eval_operand (Var p) s = SOME dw /\ ptr_covers G tn p s 32 /\
+  mem_word_taint tn.t_mem (w2n dw) = {} /\ w2n dw+32 <= s.vs_alloca_next /\
+  eval_operand src s = SOME sw /\ op_taint tn src = {} /\ op_prov G src = NONE /\
+  src <> Var iv /\ iv <> cv /\
+  mload (w2n dw) s = n2w j /\
+  abi_decode_load CALLDATALOAD sw s = n2w n /\ j <= n /\ n < dimword(:256) ==>
+  ?H th.
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) []
+      (OK (jump_to (if j<n then body_lbl else exit)
+        (abi_decode_header_state iv cv cmp done j n s)),H,th)) /\
+    H = DRESTRICT (DRESTRICT (DRESTRICT (DRESTRICT G (COMPL {iv}))
+      (COMPL {cv})) (COMPL {cmp})) (COMPL {done}) /\
+    th = tn with t_var := tn.t_var |+ (iv,{}) |+ (cv,{}) |+ (cmp,{}) |+ (done,{})
+Proof
+  strip_tac >>
+  qabbrev_tac `s1 = update_var iv (n2w j) s with vs_inst_idx := 1` >>
+  qabbrev_tac `G1 = DRESTRICT G (COMPL {iv})` >>
+  qabbrev_tac `t1 = tn with t_var := tn.t_var |+ (iv,{})` >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) [] (OK s1,G1,t1)` by
+    (simp[NoAsms, Abbr `s1`, Abbr `G1`, Abbr `t1`] >>
+     `1 = SUC s.vs_inst_idx` by simp[] >> pop_assum SUBST1_TAC >>
+     qpat_assum `mload _ _ = _` (SUBST1_TAC o SYM) >>
+     irule calldata_decoder_clean_mload_joint >>
+     simp[get_instruction_def, abi_decode_header_insts_def] >> metis_tac[]) >>
+  qabbrev_tac `s2 = update_var cv (n2w n) s1 with vs_inst_idx := 2` >>
+  qabbrev_tac `G2 = DRESTRICT G1 (COMPL {cv})` >>
+  qabbrev_tac `t2 = t1 with t_var := t1.t_var |+ (cv,{})` >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s1,G1,t1) [] (OK s2,G2,t2)` by suspend "load" >>
+  qabbrev_tac `s3 = update_var cmp (bool_to_word (j<n)) s2 with vs_inst_idx := 3` >>
+  qabbrev_tac `G3 = DRESTRICT G2 (COMPL {cmp})` >>
+  qabbrev_tac `t3 = t2 with t_var := t2.t_var |+ (cmp,{})` >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s2,G2,t2) [] (OK s3,G3,t3)` by suspend "lt" >>
+  qabbrev_tac `s4 = update_var done (bool_to_word (~(j<n))) s3 with vs_inst_idx := 4` >>
+  qabbrev_tac `G4 = DRESTRICT G3 (COMPL {done})` >>
+  qabbrev_tac `t4 = t3 with t_var := t3.t_var |+ (done,{})` >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s3,G3,t3) [] (OK s4,G4,t4)` by suspend "zero" >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s4,G4,t4) [] (OK (jump_to (if j<n then body_lbl else exit) s4),G4,t4)`
+    by suspend "branch" >>
+  qexistsl_tac [`G4`,`t4`] >>
+  reverse (rpt conj_tac)
+  >- simp[Abbr `t4`,Abbr `t3`,Abbr `t2`,Abbr `t1`]
+  >- simp[Abbr `G4`,Abbr `G3`,Abbr `G2`,Abbr `G1`] >>
+  `jump_to (if j<n then body_lbl else exit) s4 =
+    jump_to (if j<n then body_lbl else exit)
+      (abi_decode_header_state iv cv cmp done j n s)` by
+    simp[Abbr `s4`,Abbr `s3`,Abbr `s2`,Abbr `s1`,
+      abi_decode_header_state_def,update_var_def,jump_to_def] >>
+  metis_tac[dispatched_decoder_joint_then]
+QED
+
+Resume calldata_decoder_loop_header_joint[load]:
+  simp[NoAsms,Abbr `s2`,Abbr `G2`,Abbr `t2`] >>
+  `2 = SUC s1.vs_inst_idx` by simp[Abbr `s1`,update_var_def] >>
+  pop_assum SUBST1_TAC >> irule calldata_decoder_clean_test_joint >>
+  simp[Abbr `s1`,Abbr `G1`,Abbr `t1`,update_var_def,
+    allocas_from_def,get_instruction_def,abi_decode_header_insts_def] >>
+  reverse conj_tac >- fs[allocas_from_def] >>
+  qexistsl_tac [`id+1`,`CALLDATALOAD`,`[src]`] >>
+  simp[step_inst_base_opcode_eqs,mk_inst_def,exec_read1_def,
+    abi_decode_load_def,abi_decode_source_def,update_var_def] >>
+  Cases_on `src` >> gvs[eval_operand_def,lookup_var_def,op_taint_def,
+    op_prov_def,FLOOKUP_DRESTRICT,FLOOKUP_UPDATE,abi_decode_load_def,
+    abi_decode_source_def]
+QED
+
+Resume calldata_decoder_loop_header_joint[lt]:
+  simp[NoAsms,Abbr `s3`,Abbr `G3`,Abbr `t3`] >>
+  `3 = SUC s2.vs_inst_idx` by simp[Abbr `s2`,update_var_def] >>
+  pop_assum SUBST1_TAC >> irule calldata_decoder_clean_test_joint >>
+  simp[Abbr `s2`,Abbr `s1`,Abbr `G2`,Abbr `G1`,Abbr `t2`,Abbr `t1`,
+    update_var_def,allocas_from_def,get_instruction_def,abi_decode_header_insts_def] >>
+  reverse conj_tac >- fs[allocas_from_def] >>
+  qexistsl_tac [`id+2`,`LT`,`[Var iv;Var cv]`] >>
+  simp[step_inst_base_opcode_eqs,mk_inst_def,exec_pure2_def,
+    eval_operand_def,lookup_var_def,update_var_def,FLOOKUP_UPDATE,
+    op_taint_def,op_prov_def,FLOOKUP_DRESTRICT,w2n_n2w] >>
+  `j < dimword(:256)` by decide_tac >>
+  simp[DISJ_IMP_THM,FORALL_AND_THM]
+QED
+
+Resume calldata_decoder_loop_header_joint[zero]:
+  simp[NoAsms,Abbr `s4`,Abbr `G4`,Abbr `t4`] >>
+  `4 = SUC s3.vs_inst_idx` by simp[Abbr `s3`,update_var_def] >>
+  pop_assum SUBST1_TAC >> irule calldata_decoder_clean_test_joint >>
+  simp[Abbr `s3`,Abbr `s2`,Abbr `s1`,Abbr `G3`,Abbr `t3`,
+    update_var_def,allocas_from_def,get_instruction_def,abi_decode_header_insts_def] >>
+  reverse conj_tac >- fs[allocas_from_def] >>
+  qexistsl_tac [`id+3`,`ISZERO`,`[Var cmp]`] >>
+  simp[step_inst_base_opcode_eqs,mk_inst_def,exec_pure1_def,
+    eval_operand_def,lookup_var_def,update_var_def,FLOOKUP_UPDATE,
+    op_taint_def,op_prov_def,FLOOKUP_DRESTRICT,bool_to_word_def] >>
+  Cases_on `j<n` >> simp[]
+QED
+
+Resume calldata_decoder_loop_header_joint[branch]:
+  `jump_to (if j<n then body_lbl else exit) s4 =
+    jump_to (if bool_to_word (~(j<n)) <> 0w then exit else body_lbl) s4` by
+    (Cases_on `j<n` >> simp[bool_to_word_def]) >>
+  pop_assum SUBST1_TAC >>
+  irule (Q.INST [`w` |-> `bool_to_word (~(j<n))`,
+    `yes` |-> `exit`, `no` |-> `body_lbl`] calldata_decoder_jnz_joint) >>
+  simp[Abbr `s4`,Abbr `s3`,Abbr `s2`,Abbr `s1`,Abbr `G4`,Abbr `t4`,
+    update_var_def,get_instruction_def,abi_decode_header_insts_def] >>
+  conj_tac
+  >- (qexists_tac `target` >> Cases_on `j<n` >> gvs[]) >>
+  reverse conj_tac >- (fs[allocas_from_def] >> metis_tac[]) >>
+  qexistsl_tac [`Var done`,`id+4`] >>
+  simp[eval_operand_def,lookup_var_def,update_var_def,FLOOKUP_UPDATE,op_taint_def]
+QED
+
+Finalise calldata_decoder_loop_header_joint
+
+Theorem calldata_decoder_loop_exit_joint:
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME
+    <|bb_label := hdr; bb_instructions :=
+      abi_decode_header_insts id (Var p) src CALLDATALOAD iv cv cmp done body_lbl exit|> /\
+  s.vs_inst_idx = 0 /\ lookup_block exit fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  eval_operand (Var p) s = SOME dw /\ ptr_covers G tn p s 32 /\
+  mem_word_taint tn.t_mem (w2n dw) = {} /\ w2n dw+32 <= s.vs_alloca_next /\
+  eval_operand src s = SOME sw /\ op_taint tn src = {} /\ op_prov G src = NONE /\
+  (!v. MEM v [iv;cv;cmp;done] ==> p <> v /\ src <> Var v) /\ iv <> cv /\
+  mload (w2n dw) s = n2w n /\
+  abi_decode_load CALLDATALOAD sw s = n2w n /\ n < dimword(:256) ==>
+  ?H th.
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) []
+      (OK (jump_to exit (abi_decode_header_state iv cv cmp done n n s)),H,th)) /\
+    ptr_covers H th p (jump_to exit (abi_decode_header_state iv cv cmp done n n s)) 32 /\
+    op_prov H src = NONE /\ op_taint th src = {} /\
+    th.t_mem = tn.t_mem /\
+    (!v. ~MEM v [iv;cv;cmp;done] ==>
+      FLOOKUP H v = FLOOKUP G v /\ op_taint th (Var v) = op_taint tn (Var v))
+Proof
+  strip_tac >>
+  `src <> Var iv` by metis_tac[MEM] >>
+  drule_all (SRULE [] (Q.INST [`j` |-> `n`] calldata_decoder_loop_header_joint)) >>
+  strip_tac >>
+  qexistsl_tac [`DRESTRICT G (COMPL {iv} INTER (COMPL {cv} INTER (COMPL {cmp} INTER COMPL {done})))`,
+    `tn with t_var := tn.t_var |+ (iv,{}) |+ (cv,{}) |+ (cmp,{}) |+ (done,{})`] >>
+  conj_tac >- simp[] >>
+  gvs[DISJ_IMP_THM,FORALL_AND_THM] >>
+  conj_tac
+  >- (gvs[ptr_covers_def,abi_decode_header_state_def,jump_to_def,
+        update_var_def,FLOOKUP_DRESTRICT,op_taint_def,FLOOKUP_UPDATE,
+        lookup_var_def] >> metis_tac[]) >>
+  simp[FLOOKUP_DRESTRICT,op_taint_def,FLOOKUP_UPDATE] >>
+  conj_tac
+  >- (Cases_on `src` >> gvs[op_prov_def,FLOOKUP_DRESTRICT]) >>
+  Cases_on `src` >> gvs[op_taint_def,FLOOKUP_UPDATE]
+QED

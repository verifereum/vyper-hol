+  drule_all calldata_element_setup_repeat_frag_mem >>
+  disch_then (qspec_then `ctx` mp_tac) >>
+  rewrite_tac[frag_exec_mem_def] >>
+  disch_then (qspec_then `fn` mp_tac) >>
+  disch_then (qspec_then `head` mp_tac) >>

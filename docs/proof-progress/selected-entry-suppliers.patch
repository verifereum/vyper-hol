+        drule_all registration_old_resources_member >> strip_tac >> decide_tac) >>
+     drule_all registration_decoder_old_frame >> simp[]) >>
+  `alloca_history fn v /\ abi_alloca_history (fn_insts fn) v` by
+    (fs[dispatched_registration_ready_def, dispatched_registration_caller_def,
+        calldata_reentrant_post_def] >>
+     drule_all registration_decoder_histories >> simp[]) >>
+  `calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (v,J,w)` by
+    (drule dispatched_registration_ready_joint >> strip_tac >>
+     fs[calldata_reentrant_post_def] >>
+     metis_tac[calldata_loop_joint_rel_trans]) >>
+  `fresh_vars_wrt last v /\ fresh_vars_wrt limit_st v` by
+    (fs[dispatched_registration_ready_def, dispatched_registration_caller_def] >>
+     conj_tac
+     >- (drule_all calldata_reentrant_fresh_boundary >> simp[]) >>
+     drule_all calldata_reentrant_fresh_boundary >> strip_tac >>
+     drule_all registration_fresh_vars_mono >> simp[]) >>
+  qpat_x_assum `dispatched_registration_ready _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _`
+    (strip_assume_tac o REWRITE_RULE [dispatched_registration_ready_def]) >>
+  qpat_x_assum `calldata_reentrant_post _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _`
+    (strip_assume_tac o REWRITE_RULE [calldata_reentrant_post_def]) >>
+  qpat_x_assum `calldata_loop_frame _ _ _ _ _ _ _ _ _`
+    (strip_assume_tac o REWRITE_RULE [calldata_loop_frame_def]) >>
+  gvs[] >>
+  `not_fresh_at first root` by
+    gvs[calldata_operand_live_not_fresh] >>
+  `FLOOKUP J root = SOME (p,type_memory_size tv) /\
+   lookup_var root v = SOME (n2w p)` by
+    (conj_tac
+     >- (first_assum (qspec_then `root` mp_tac) >> simp[] >> NO_TAC) >>
+     qpat_x_assum `!op. abi_decoder_operand_live first.cs_next_var op ==> _`
+       (qspec_then `Var root` mp_tac) >>
+     gvs[venomStateTheory.eval_operand_def]) >>
+  `lo <= v.vs_alloca_next` by
+    (fs[dispatched_registration_caller_def] >> decide_tac) >>
+  `!id entry. FLOOKUP v.vs_allocas id = SOME entry ==> id < last.cs_next_id` by
+    (rpt strip_tac >> Cases_on `id < last.cs_next_id` >- simp[] >>
+     `FLOOKUP v.vs_allocas id = FLOOKUP t.vs_allocas id` by
+       (qpat_x_assum `!id. id < first.cs_next_id \/ _ ==> _`
+          (qspec_then `id` mp_tac) >>
+        (impl_tac >- decide_tac) >> disch_then ACCEPT_TAC) >>
+     qpat_x_assum `dispatched_registration_caller _ _ _ _ _ first _ _ _ _ _`
+       (strip_assume_tac o REWRITE_RULE [dispatched_registration_caller_def]) >>
+     `id < first.cs_next_id` by metis_tac[] >> decide_tac) >>
+  `not_fresh_at last root` by
+    (gvs[not_fresh_at_def] >> metis_tac[LESS_EQ_TRANS, LESS_LESS_EQ_TRANS]) >>
+  simp_tac bool_ss [registration_result_def] >>
+  conj_tac
+  >- (simp[dispatched_registration_caller_def, registration_old_resources_def,
+           EVERY_APPEND] >>
+      fs[registration_old_resources_def]) >>
+  simp[EVERY_MEM, registration_outputs_def] >>
+  conj_tac >- (qexists_tac `ins` >> simp[]) >>
+  conj_tac >- metis_tac[entryDecoderStateFrameTheory.entry_decoder_obs_trans] >>
+  conj_tac
+  >- (rpt strip_tac >>
+      `abi_decoder_operand_live first.cs_next_var op` by
+        metis_tac[abi_decoder_operand_live_mono] >>
+      qpat_x_assum `!op. abi_decoder_operand_live first.cs_next_var op ==> _`
+        (qspec_then `op` mp_tac) >> simp[]) >>
+  conj_tac
+  >- (rpt strip_tac >>
+      `FLOOKUP t.vs_allocas id = SOME entry` by metis_tac[] >>
+      PairCases_on `entry` >> metis_tac[]) >>
+  qpat_x_assum `calldata_loop_joint_rel _ _ _ _ (s,G,tn) (v,J,w)`
+    (mp_tac o REWRITE_RULE [calldata_loop_joint_rel_def]) >> simp[]
+QED

+  `allocas_from lower s2` by (fs[allocas_from_def] >> metis_tac[]) >>
+  `eval_operand (Lit (n2w 4)) s2 = SOME (n2w 4) /\
+   op_taint tn2 (Lit (n2w 4)) = {} /\ op_prov G2 (Lit (n2w 4)) = NONE` by
+    simp[eval_operand_def, op_taint_def, op_prov_def] >>

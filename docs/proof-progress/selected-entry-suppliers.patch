+Theorem calldata_exact_word_reentrant_joint_companion:
+  abi_decoder_coherent ce env sf ty tv /\ is_word_type ty /\
+  compile_abi_decode_to_buf (Var root) src CALLDATALOAD (Lit 0w) (Lit 0w)
+    (type_to_abi_dec_info sf ce ty) st = ((),last) /\
+  calldata_reentrant_pre ctx fn site lo st last initial src root p d tv x
+    oid base_addr cap G tn ==>
+  ?v H u. calldata_reentrant_post ctx fn site lo PG st last initial G tn root d tv x v H u /\
+    entry_decoder_obs initial v /\
+    ((!fuel. mem_safe_run fuel ctx fn v) ==> !fuel. mem_safe_run fuel ctx fn initial)
+Proof
+  simp_tac bool_ss [calldata_reentrant_pre_def] >>
+  disch_then (map_every assume_tac o CONJUNCTS) >>
+  `?clamp. type_to_abi_dec_info sf ce ty = DecPrimWord clamp` by
+    metis_tac[word_type_decoder_primitive] >>
+  drule abi_decoder_coherent_header >>
+  simp_tac bool_ss [abi_decoder_header_def] >> strip_tac >>
+  `type_memory_size tv = 32` by (irule abi_word_type_size >> metis_tac[]) >>
+  `cd_word_value tv (cd_word initial.vs_call_ctx.cc_calldata (w2n p)) = SOME x` by
+    (qpat_assum `cd_decode F _ _ _ = SOME x` mp_tac >>
+     qpat_x_assum `evaluate_type env ty = SOME tv` mp_tac >>
+     qpat_assum `is_word_type ty` mp_tac >>
+     rpt (pop_assum kall_tac) >>
+     Cases_on `ty` >> simp[is_word_type_def, evaluate_type_def, AllCaseEqs()] >>
+     rpt strip_tac >> gvs[is_word_type_def, cd_decode_def]) >>

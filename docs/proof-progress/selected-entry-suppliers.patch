+Theorem calldata_reentrant_loop_advance_joint_rel:
+  let size = type_memory_size tv;
+      capacity = 32 + maxn * size;
+      cd = initial.vs_call_ctx.cc_calldata
+  in
+  abi_decode_loop_prefix (Var q) src CALLDATALOAD (Lit 0w) loop_st =
+    ((hdr,body_lbl,exit_lbl),st0) /\
+  abi_decode_array_element_setup (Var q) src (Var root) CALLDATALOAD
+    (Lit 0w) (Lit 0w) di (tv_abi_size tv) size st0 = (ops,middle) /\
+  compile_abi_decode_to_buf (SND (SND ops)) (FST (SND ops)) CALLDATALOAD
+    (Lit 0w) (Lit 0w) di middle = ((),st1) /\
+  abi_decode_loop_suffix (Var q) (FST ops) hdr exit_lbl st1 = ((),last) /\
+  SND (SND ops) = Var child /\
+  fn_has_code loop_st last fn /\ fn_inst_ids_distinct fn /\
+  st.cs_next_id <= header.cs_next_id /\ header.cs_next_id < loop_st.cs_next_id /\
+  st.cs_next_var <= loop_st.cs_next_var /\
+  abi_decoder_operand_live loop_st.cs_next_var src /\
+  abi_decoder_operand_live loop_st.cs_next_var (Var root) /\
+  abi_decoder_operand_live loop_st.cs_next_var (Var q) /\
+  (oid < st.cs_next_id \/ last.cs_next_id <= oid) /\
+  base_addr <= d /\ d+capacity <= base_addr+cap /\
+  d+capacity < dimword (:256) /\ p+32 < dimword (:256) /\
+  (p+32 <= d \/ d+capacity <= p) /\
+  ~ctx_has_dalloca ctx /\ unit_alloca_budget ctx < dimword (:256) /\
+  last.cs_next_var <= cutoff /\ LENGTH xs < dimword (:256) /\
+  abi_decode_load CALLDATALOAD (n2w sb:bytes32) initial = n2w (LENGTH xs) /\
+  (!k. k < LENGTH xs ==>
+    let w:bytes32 =
+      if dec_info_needs_offset di then
+        n2w (sb+32) + abi_decode_load CALLDATALOAD
+          (n2w (sb+32+k*tv_abi_size tv):bytes32) initial
+      else n2w (sb+32+k*tv_abi_size tv)
+    in w2n w = cd_member_ptr F cd tv (sb+32) (k*tv_abi_size tv) /\
+       cd_decode F cd tv (w2n w) = SOME (EL k xs)) /\
+  (!s. R s s) /\ (!s t u. R s t /\ R t u ==> R s u) /\
+  (!s t. entry_decoder_obs s t /\
+    ((!fuel. mem_safe_run fuel ctx fn t) ==> !fuel. mem_safe_run fuel ctx fn s) ==> R s t) /\
+  calldata_reentrant_loop_child_rel R ctx fn site lo PG middle st1
+    (FST (SND ops)) child root q oid base_addr cap d tv maxn (sb+32) xs /\
+  i < LENGTH xs /\
+  calldata_reentrant_loop_invariant ctx fn site lo st last initial initial_G initial_tn
+    header hdr src (n2w sb) root q p oid base_addr cap d tv maxn xs i a ==>
+  ?b. calldata_reentrant_loop_invariant ctx fn site lo st last initial initial_G initial_tn
+        header hdr src (n2w sb) root q p oid base_addr cap d tv maxn xs (SUC i) b /\
+      calldata_loop_framed_joint_rel cutoff lo ctx fn PG a b /\ R (FST a) (FST b)
+Proof
+  simp_tac bool_ss [LET_THM] >>
+  disch_then (map_every assume_tac o CONJUNCTS) >>
+  `abi_decode_source_opcode CALLDATALOAD` by simp[abi_decode_source_opcode_def] >>
+  drule abi_decoder_loop_prefix_facts >> simp_tac std_ss [] >> strip_tac >>
+  drule abi_decoder_loop_phase_lookups >> simp_tac std_ss [] >>
+  disch_then drule >> disch_then drule >> simp_tac std_ss [] >>
+  disch_then drule >> asm_simp_tac bool_ss [] >> disch_then drule >> strip_tac >>
+  drule abi_decoder_loop_phase_containment >> simp_tac std_ss [] >>
+  disch_then drule >> disch_then drule >> simp_tac std_ss [] >>
+  disch_then drule >> asm_simp_tac bool_ss [] >> disch_then drule >> strip_tac >>
+  drule_all abi_decoder_array_body_entry_phi >> strip_tac >>
+  drule abi_decoder_array_setup_head >> strip_tac >>
+  drule_all abi_decoder_array_body_code >> strip_tac >>
+  drule abi_decode_array_element_setup_operands >> strip_tac >>
+  drule_all abi_decode_array_element_setup_shape >> strip_tac >>
+  `abi_decode_loop_suffix (Var q)
+     (Var (STRING #"%" (toString st0.cs_next_var))) hdr exit_lbl st1 = ((),last)` by
+    metis_tac[] >>
+  drule abi_decoder_loop_suffix_facts >> strip_tac >>
+  `!v. MEM v
+     [STRING #"%" (toString loop_st.cs_next_var);
+      STRING #"%" (toString (loop_st.cs_next_var+1));
+      STRING #"%" (toString (loop_st.cs_next_var+2));
+      STRING #"%" (toString (loop_st.cs_next_var+3))] ==>
+     q <> v /\ root <> v /\ src <> Var v` by

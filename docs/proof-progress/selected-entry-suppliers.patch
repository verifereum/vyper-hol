+    simp[exprLoweringPropsTheory.emitted_insts_def] >>
+  `head.vs_memory = s.vs_memory /\ head.vs_call_ctx = s.vs_call_ctx /\
+   head.vs_data_section = s.vs_data_section /\ head.vs_allocas = s.vs_allocas /\
+   head.vs_alloca_next = s.vs_alloca_next` by
+    simp_tac (srw_ss()) [Abbr `head`,abi_decode_header_state_def,jump_to_def,update_var_def] >>
+  qpat_x_assum `abi_decode_array_element_setup _ _ _ _ _ _ _ _ _ _ = _` kall_tac >>
+  qpat_x_assum `fn_has_code _ _ _` kall_tac >>
+  qpat_x_assum `frag_exec_ptr _ _ _ _ _ _ _ _ _` kall_tac >>
+  qpat_x_assum `!D explicit. gas_origin_ptr_path _ _ _ _` kall_tac >>
+  qpat_x_assum `!D lower explicit ctx' func. _ ==> gas_origin_ptr_path _ _ _ _` kall_tac >>
+  qpat_x_assum `!D lower ctx' func. _` kall_tac >>
+  fs[abi_decoder_address_frame_def] >>
+  `!x. not_fresh_at st x ==> lookup_var x head = lookup_var x s /\
+      FLOOKUP HG x = FLOOKUP G x /\ op_taint ht (Var x) = op_taint tn (Var x)` by
+    (rpt strip_tac >>
+     `x <> iv /\ x <> cv /\ x <> cmp /\ x <> done` by metis_tac[MEM] >>
+     simp[Abbr `head`,abi_decode_header_state_def,jump_to_def,update_var_def,
+       lookup_var_def,FLOOKUP_UPDATE,FLOOKUP_DRESTRICT,op_taint_def]) >>
+  `!x. not_fresh_at st x ==> lookup_var x t = lookup_var x s /\

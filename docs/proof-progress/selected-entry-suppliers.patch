+  rename1 `gas_path_mem ctx fn s2 0 (OK s3)` >>
+  `registration_address_physical ctx fn site s2 s3` by
+    (drule_all registration_add_at_joint >> simp[]) >>
+  suspend "join"
+QED
+
+Resume registration_prelude_joint_physical[join]:
+  rename1 `op_taint tn3 src = {}` >> rename1 `op_prov G3 src = NONE` >>
+  `!x. not_fresh_at st x ==> not_fresh_at after_head x /\
+    not_fresh_at after_load x` by
+    (imp_res_tac emitted_insts_emit_op >>
+     simp[not_fresh_at_def] >> rpt strip_tac >> decide_tac) >>
+  `s1.vs_call_ctx = s.vs_call_ctx` by
+    (qpat_assum `s1 = s with <|vs_vars := _; vs_inst_idx := _|>`

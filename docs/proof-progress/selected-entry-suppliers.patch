+Theorem calldata_decoder_loop_future_frame:
+  let H = calldata_loop_invariant ctx fn site lo st last initial initial_G initial_tn
+        header hdr src srcword root q p oid base_addr cap d tv maxn (LENGTH xs);
+      Q = calldata_loop_output ctx fn site lo st last initial initial_G initial_tn
+        root d tv maxn xs;
+      J = calldata_loop_framed_joint_rel cutoff lo ctx fn PG
+  in
+  J (initial,initial_G,initial_tn) start /\ H 0 start /\
+  (!i a. i < LENGTH xs /\ H i a ==> ?b.
+    H (SUC i) b /\ J a b /\
+    value_has_type tv (EL i xs) /\ val_wf tv (EL i xs) /\
+    val_in_memory tv (EL i xs) (d+32+i*type_memory_size tv) (FST b).vs_memory /\
+    mem_bytes_at d (32+i*type_memory_size tv) (FST b).vs_memory =
+    mem_bytes_at d (32+i*type_memory_size tv) (FST a).vs_memory) /\
+  (!a. H (LENGTH xs) a /\
+    (!k. k < LENGTH xs ==> value_has_type tv (EL k xs) /\ val_wf tv (EL k xs) /\
+      val_in_memory tv (EL k xs) (d+32+k*type_memory_size tv) (FST a).vs_memory)
+    ==> ?b. Q b /\ J a b)
+  ==> ?b. Q b /\ calldata_loop_joint_rel lo ctx fn PG
+    (initial,initial_G,initial_tn) b /\ future_frame cutoff initial (FST b)
+Proof
+  simp_tac bool_ss [LET_THM] >>
+  qmatch_goalsub_abbrev_tac `H 0 start` >>
+  qabbrev_tac `Q = calldata_loop_output ctx fn site lo st last initial initial_G
+    initial_tn root d tv maxn xs` >>
+  strip_tac >>
+  `?b. Q b /\ calldata_loop_framed_joint_rel cutoff lo ctx fn PG start b` by
+    (simp_tac bool_ss [Abbr `Q`] >>
+     irule calldata_accepted_joint_iteration >>
+     conj_tac >- metis_tac[calldata_loop_framed_joint_rel_trans] >>
+     qexistsl_tac [`H`,`d`,`0`,`LENGTH xs`,`FST`,`tv`] >> simp[]) >>
+  `calldata_loop_framed_joint_rel cutoff lo ctx fn PG
+    (initial,initial_G,initial_tn) b` by
+    metis_tac[calldata_loop_framed_joint_rel_trans] >>
+  PairCases_on `b` >> gvs[calldata_loop_framed_joint_rel_def] >>
+  qexists_tac `(b0,b1,b2)` >> simp[]
+QED

+    first_assum ACCEPT_TAC) >>
+  simp[Abbr `sp`] >> strip_tac >>
+  metis_tac[gas_origin_ptr_path_append, APPEND_NIL]
+QED
+
+Finalise calldata_member_address_accepted_joint

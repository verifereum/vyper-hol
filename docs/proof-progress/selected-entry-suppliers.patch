+(* Concrete loop-control edges retain the block-entry ghosts, including PHIs. *)
+Theory dispatchedDecoderLoopEdgesJoint
+Ancestors abiDecoderArrayLoopInit abiDecoderIndexInit abiDecoderDynarrayPrefix abiDecoderArrayHeader decoderArrayInitPtr abiDecoderArrayInitExec dispatchedDecoderTrace fragGasOriginPtr fragGasOrigin fragGasPathPtr
+  venomExecSemantics venomState venomInst list arithmetic typedCopyArrayPtr fragExec
+  ptrSafeRun ptrDiscipline memSafeRun unitTransformDefs contextCodegenRel codegenRel
+  gasEvents gasCount typedCopyPtr ptrSafetyTransport fragExecPtr finite_map bodyPtrDefs wordLoadStorePtr
+  abiDecoderExecution abiDecoderContract words
+  decoderArraySetupPtr calldataDynOwned abiDecoderDynamicLoopSetup
+  abiDecoderArraySetupInputs emitHelperProps entrySinkExtraction
+
+Theorem calldata_decoder_joint_enter[local]:
+  ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME bb /\
+  get_instruction bb s.vs_inst_idx = SOME inst /\
+  step_inst fuel ctx inst s = OK t /\
+  is_terminator inst.inst_opcode /\ ~t.vs_halted /\
+  lookup_block t.vs_current_bb fn.fn_blocks = SOME target /\
+  eval_phis t target.bb_instructions = OK entered /\ ~entered.vs_halted /\
+  gas_events_step fuel ctx fn.fn_name inst s = [] /\
+  gas_count_step fuel ctx inst s = 0 /\
+  mem_safe_step fuel ctx inst s /\
+  (!D. ptr_safe_step D lo fuel ctx fn PG G tn inst s) ==>
+  !D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) []
+    (OK (entered with vs_inst_idx := phi_prefix_length target.bb_instructions),
+      entry_prov fn t G, entry_taint_vars fn t tn)
+Proof
+  rpt strip_tac >>
+  `gas_origin_ptr_edge (D,lo,explicit,ctx,fn,PG)
+     (s,G,tn) []
+     (OK (entered with vs_inst_idx := phi_prefix_length target.bb_instructions),
+      entry_prov fn t G, entry_taint_vars fn t tn)` by
+    (simp[gas_origin_ptr_edge_def, gas_origin_edge_def, gas_path_ptr_edge_def] >>
+     conj_tac >> qexists_tac `fuel` >> simp[] >>
+     qexistsl_tac [`bb`, `inst`] >> simp[] >> metis_tac[]) >>
+  `~(entered with vs_inst_idx := phi_prefix_length target.bb_instructions).vs_halted`
+    by simp[] >>
+  metis_tac[gas_origin_ptr_path_rules, APPEND]
+QED
+
+Theorem calldata_decoder_joint_enter_no_phi[local]:
+  ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME bb /\
+  get_instruction bb s.vs_inst_idx = SOME inst /\
+  step_inst fuel ctx inst s = OK t /\
+  is_terminator inst.inst_opcode /\ ~t.vs_halted /\ t.vs_inst_idx = 0 /\
+  lookup_block t.vs_current_bb fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  gas_events_step fuel ctx fn.fn_name inst s = [] /\
+  gas_count_step fuel ctx inst s = 0 /\
+  mem_safe_step fuel ctx inst s /\
+  (!D. ptr_safe_step D lo fuel ctx fn PG G tn inst s) ==>
+  !D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) [] (OK t,G,tn)
+Proof
+  strip_tac >>
+  `eval_phis t target.bb_instructions = OK t` by
+    metis_tac[eval_phis_no_phi] >>
+  `entry_prov fn t G = G /\ entry_taint_vars fn t tn = tn` by
+    metis_tac[entry_ghost_no_phi] >>
+  `t with vs_inst_idx := phi_prefix_length target.bb_instructions = t` by
+    simp[venom_state_component_equality] >>
+  drule_all calldata_decoder_joint_enter >> simp[]
+QED
+
+(* The backedge and header branches enter PHI-free blocks.  This is the
+   concrete branch edge, not a backward continuation argument. *)
+Theorem calldata_decoder_jump_joint:
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME bb /\
+  get_instruction bb s.vs_inst_idx = SOME (mk_inst id JMP [Label dest] []) /\
+  lookup_block dest fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 ==>
+  !D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) [] (OK (jump_to dest s),G,tn)
+Proof
+  strip_tac >> irule calldata_decoder_joint_enter_no_phi >>
+  simp[jump_to_def] >>
+  qexists_tac `0` >>
+  simp[step_inst_non_invoke, step_inst_base_opcode_eqs, mk_inst_def,
+    jump_to_def, is_terminator_def, gas_events_step_def, gas_count_step_def,
+    mem_safe_step_non_invoke, inst_mem_below_frontier_def,
+    source_memory_read_ranges_def, source_memory_write_ranges_def,
+    ptr_safe_defs, ptr_inst_ok_def, access_ok_def, taint_ok_def,
+    op_taint_def, jump_to_def]
+QED
+
+(* Unlike fresh-register emission lemmas this step permits a stale output. *)
+Theorem calldata_decoder_clean_add_joint:
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME bb /\
+  get_instruction bb s.vs_inst_idx = SOME (mk_inst id ADD [left;right] [out]) /\
+  eval_operand left s = SOME a /\ eval_operand right s = SOME b /\
+  op_taint tn left = {} /\ op_taint tn right = {} ==>
+  !D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) []
+    (OK ((update_var out (a+b) s) with vs_inst_idx := SUC s.vs_inst_idx),
+     step_prov PG G (mk_inst id ADD [left;right] [out]) (update_var out (a+b) s),
+     step_taint (mk_inst id ADD [left;right] [out]) s (update_var out (a+b) s) tn)
+Proof
+  strip_tac >> irule dispatched_decoder_joint_step >>
+  simp[update_var_def] >> qexists_tac `0` >>
+  simp[step_inst_non_invoke, ghost_step_non_invoke, mk_inst_def,
+    step_inst_base_opcode_eqs, exec_pure2_def, update_var_def,
+    gas_events_step_def, gas_count_step_def, is_terminator_def,
+    mem_safe_step_non_invoke, inst_mem_below_frontier_def,
+    source_memory_read_ranges_def, source_memory_write_ranges_def] >>
+  gen_tac >> simp_tac (srw_ss()) [ptr_safe_defs] >>
+  irule ptr_inst_ok_lower_bound_transport >>
+  conj_tac >- simp[] >> qexists_tac `0` >> simp[] >>
+  irule (SRULE [mk_inst_def] ptr_inst_ok_copy_len_binop) >> simp[]
+QED
+
+Theorem calldata_decoder_clean_store_joint:
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME bb /\
+  get_instruction bb s.vs_inst_idx = SOME (mk_inst id MSTORE [Var p;value] []) /\
+  eval_operand (Var p) s = SOME dw /\ eval_operand value s = SOME w /\
+  ptr_covers G tn p s 32 /\ op_taint tn value = {} /\
+  w2n dw + 32 <= s.vs_alloca_next ==>
+  !D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) []
+    (OK ((mstore (w2n dw) w s) with vs_inst_idx := SUC s.vs_inst_idx),
+     step_prov PG G (mk_inst id MSTORE [Var p;value] []) (mstore (w2n dw) w s),
+     step_taint (mk_inst id MSTORE [Var p;value] []) s (mstore (w2n dw) w s) tn)
+Proof
+  strip_tac >> irule dispatched_decoder_joint_step >>
+  simp[mstore_def] >> qexists_tac `0` >>
+  simp[step_inst_non_invoke, ghost_step_non_invoke, mk_inst_def,
+    step_inst_base_opcode_eqs, exec_write2_def, mstore_def,
+    gas_events_step_def, gas_count_step_def, is_terminator_def] >>
+  conj_tac
+  >- (gen_tac >> simp_tac (srw_ss()) [ptr_safe_defs] >>
+      irule ptr_inst_ok_lower_bound_transport >>
+      conj_tac >- simp[] >> qexists_tac `0` >> simp[] >>
+      irule (SRULE [mk_inst_def] ptr_inst_ok_mstore) >>
+      fs[eval_operand_def, lookup_var_def]) >>
+  simp[mem_safe_step_non_invoke, inst_mem_below_frontier_def,
+    source_memory_read_ranges_def, source_memory_write_ranges_def,
+    inst_dload_in_section_def, fixed_source_write_range_def]
+QED
+
+(* Concrete three-instruction backedge.  The updated ghosts are chosen once,
+   before the horizon parameters, even when nv was used on an earlier lap. *)
+Theorem calldata_decoder_loop_backedge_joint:
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME bb /\
+  bb.bb_instructions = prefix ++
+    [mk_inst id ADD [Var iv;Lit 1w] [nv];
+     mk_inst (id+1) MSTORE [Var p;Var nv] [];
+     mk_inst (id+2) JMP [Label hdr] []] /\
+  s.vs_inst_idx = LENGTH prefix /\
+  lookup_block hdr fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  eval_operand (Var iv) s = SOME w /\ eval_operand (Var p) s = SOME dw /\
+  p <> nv /\ ptr_covers G tn p s 32 /\ op_taint tn (Var iv) = {} /\
+  w2n dw + 32 <= s.vs_alloca_next ==>
+  ?H tm.
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) []
+      (OK (jump_to hdr (mstore (w2n dw) (w+1w) (update_var nv (w+1w) s))),H,tm)) /\
+    (!x. x <> nv ==> FLOOKUP H x = FLOOKUP G x /\
+      op_taint tm (Var x) = op_taint tn (Var x)) /\
+    op_taint tm (Var nv) = {} /\
+    ptr_covers H tm p
+      (jump_to hdr (mstore (w2n dw) (w+1w) (update_var nv (w+1w) s))) 32
+Proof
+  strip_tac >>
+  qabbrev_tac `a = mk_inst id ADD [Var iv;Lit 1w] [nv]` >>
+  qabbrev_tac `u = update_var nv (w+1w) s` >>
+  qabbrev_tac `G1 = step_prov PG G a u` >>
+  qabbrev_tac `tn1 = step_taint a s u tn` >>
+  qabbrev_tac `s1 = u with vs_inst_idx := SUC s.vs_inst_idx` >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) [] (OK s1,G1,tn1)` by
+    (simp[NoAsms, Abbr `s1`, Abbr `G1`, Abbr `tn1`, Abbr `u`, Abbr `a`] >>
+     irule calldata_decoder_clean_add_joint >>
+     simp[get_instruction_def, EL_APPEND_EQN, eval_operand_def, op_taint_def]) >>
+  `(!x. x <> nv ==> FLOOKUP G1 x = FLOOKUP G x /\
+        op_taint tn1 (Var x) = op_taint tn (Var x)) /\
+    op_taint tn1 (Var nv) = {}` by
+    (simp[Abbr `G1`, Abbr `tn1`, Abbr `a`, step_prov_def, set_prov_def,
+      step_taint_def, set_var_taint_def, op_taint_def, out_taint_def,
+      mk_inst_def, FLOOKUP_UPDATE, FLOOKUP_DRESTRICT] >>
+     gen_tac >> strip_tac >> CASE_TAC >>
+     simp[FLOOKUP_UPDATE, FLOOKUP_DRESTRICT]) >>
+  `ptr_covers G1 tn1 p s1 32` by
+    (gvs[ptr_covers_def, Abbr `s1`, Abbr `u`, lookup_var_def,
+       update_var_def, FLOOKUP_UPDATE]) >>
+  qabbrev_tac `b = mk_inst (id+1) MSTORE [Var p;Var nv] []` >>
+  qabbrev_tac `v = mstore (w2n dw) (w+1w) s1` >>
+  qabbrev_tac `G2 = step_prov PG G1 b v` >>
+  qabbrev_tac `tn2 = step_taint b s1 v tn1` >>
+  qabbrev_tac `s2 = v with vs_inst_idx := SUC s1.vs_inst_idx` >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s1,G1,tn1) [] (OK s2,G2,tn2)` by
+    (simp[Abbr `s2`, Abbr `G2`, Abbr `tn2`, Abbr `v`, Abbr `b`] >>
+     irule calldata_decoder_clean_store_joint >>
+     gvs[Abbr `s1`, Abbr `u`, update_var_def, eval_operand_def,
+       lookup_var_def, FLOOKUP_UPDATE, allocas_from_def,
+       get_instruction_def, EL_APPEND_EQN] >> metis_tac[]) >>
+  `G2 = G1 /\ (!x. op_taint tn2 (Var x) = op_taint tn1 (Var x))` by
+    simp[Abbr `G2`, Abbr `tn2`, Abbr `b`, step_prov_def,
+      set_prov_def, step_taint_def, set_var_taint_def, mk_inst_def, op_taint_def,
+      DRESTRICT_UNIV] >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s2,G2,tn2) [] (OK (jump_to hdr s2),G2,tn2)` by
+    (irule calldata_decoder_jump_joint >>
+     simp[Abbr `s2`, Abbr `v`, Abbr `s1`, Abbr `u`,
+       mstore_def, update_var_def, allocas_from_def,
+       get_instruction_def, EL_APPEND_EQN, GSYM ADD1,
+       arithmeticTheory.ADD_SUB] >>
+     reverse conj_tac >- fs[allocas_from_def] >>
+     qexists_tac `id+2` >>
+     `SUC (SUC (LENGTH prefix)) - LENGTH prefix = 2` by decide_tac >>
+     simp[]) >>
+  qexistsl_tac [`G2`,`tn2`] >>
+  `jump_to hdr s2 = jump_to hdr
+      (mstore (w2n dw) (w+1w) (update_var nv (w+1w) s))` by
+    simp[Abbr `s2`, Abbr `v`, Abbr `s1`, Abbr `u`, jump_to_def,
+      mstore_def, update_var_def] >>
+  conj_tac >- metis_tac[dispatched_decoder_joint_then] >>
+  gvs[ptr_covers_def, jump_to_def, mstore_def, update_var_def,
+    Abbr `u`, lookup_var_def, FLOOKUP_UPDATE] >> metis_tac[]
+QED

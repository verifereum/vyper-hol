+    entryDecoderStateFrameTheory.entry_decoder_obs_def] >>
+  conj_tac
+  >- (`cs_extends st mid /\ cs_extends mid last` by
+        metis_tac[register_positional_args_suffix_extends] >>
+      metis_tac[fragExecTheory.fn_has_code_split]) >>
+  qpat_x_assum `EVERY _ rest` mp_tac >>
+  simp[EVERY_MEM, pairTheory.FORALL_PROD] >> rpt strip_tac >>
+  rename1 `MEM (tail_name,tail_prim,tail_dyn,tail_sz,tail_ty,tail_tv) rest` >>
+  first_x_assum drule >> strip_tac >>
+  `FLOOKUP cem.ce_vars tail_name = FLOOKUP ce.ce_vars tail_name` by

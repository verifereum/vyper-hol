+++ b/lowering/dispatchedRegistrationPrefixJointScript.sml
@@ -0,0 +1,308 @@
+(* Same concrete prelude for the physical and ghost registration certificates. *)
+Theory dispatchedRegistrationPrefixJoint
+Ancestors
+  dispatchedRegistrationAllocJoint dispatchedRegistrationAddressJoint
+  dispatchedRegistrationPrefixResources dispatchedRegistrationAddressPhysical
+  successfulSequenceEndpoint fragExecMem memSafeRun instMemFrontier unitTransformDefs contextCodegenRel codegenRel
+  entryRegistrationSingletonFrame actualAllocExec calldataRegistration calldataRegistrationExec moduleLowering actualRegistrationCode
+  abiDecoderCounters abiDecoderAppend abiDecoderLoopRegisters
+  entryDecoderHistoryFrame entryDecoderStateFrame abiAllocationHistory
+  loweringHalt abiDecoderReentry abiDecoderContract fragExec emitHelperProps compileEnv
+  emitHelper exprLoweringProps venomMemDefs venomExecSemantics venomState
+  loweringStateRelDefs bodyPtrDefs
+  venomInst finite_map words list arithmetic pred_set
+
+Theorem registration_fresh_alloc_physical:
+  compile_alloc_buffer n st = (buf,sa) /\ fn_has_code st sa fn /\
+  alloca_inv s /\ alloca_frontier_inv ctx fn site s /\
+  ALL_DISTINCT (MAP (\i. i.inst_id) (fn_insts fn)) /\
+  n < dimword(:256) /\ unit_alloca_budget ctx < dimword(:256) /\
+  FLOOKUP s.vs_allocas st.cs_next_id = NONE ==>
+  let root = STRING #"%" (toString st.cs_next_var);
+      a = update_var root (n2w s.vs_alloca_next)
+        (s with <|vs_allocas := s.vs_allocas |+ (st.cs_next_id,(s.vs_alloca_next,n));
+                  vs_alloca_next := s.vs_alloca_next+n|>)
+  in s.vs_alloca_next+n < dimword(:256) /\
+     alloca_inv a /\ alloca_frontier_inv ctx fn site a /\
+     exec_alloca (mk_inst st.cs_next_id ALLOCA [Lit (n2w n)] [root])
+       s (n2w n:bytes32) = OK a
+Proof
+  strip_tac >> drule_all actual_alloc_buffer_site >> strip_tac >>
+  drule compile_alloc_buffer_parts >> strip_tac >>
+  qmatch_asmsub_abbrev_tac `MEM ins (fn_insts fn)` >>
+  `ins.inst_opcode = ALLOCA /\ ins.inst_operands = [Lit (n2w n)] /\
+   ins.inst_outputs = [STRING #"%" (toString st.cs_next_var)] /\
+   ins.inst_id = st.cs_next_id` by simp[Abbr `ins`, mk_inst_def] >>
+  `!entry. FLOOKUP s.vs_allocas ins.inst_id = SOME entry ==>
+    ?p. entry = (p,n) /\ p+n < dimword(:256)` by simp[] >>
+  drule_all actual_literal_alloca_owned_step >> strip_tac >>
+  qpat_x_assum `exec_alloca _ _ _ = OK _` mp_tac >>
+  simp[exec_alloca_def] >> strip_tac >> gvs[FLOOKUP_UPDATE] >>
+  simp[Abbr `ins`, LET_THM, exec_alloca_def, mk_inst_def, ADD_COMM]
+QED
+
+Theorem registration_old_resources_prefix_frame:
+  registration_old_resources st s G tn old /\ alloca_inv s /\
+  st.cs_next_id <= first.cs_next_id /\ st.cs_next_var <= first.cs_next_var /\
+  s.vs_alloca_next <= p /\ t.vs_memory = s.vs_memory /\
+  u.t_mem = tn.t_mem UNION {j | p <= j /\ j < p+n} /\
+  (!root. not_fresh_at st root ==>
+    lookup_var root t = lookup_var root s /\ FLOOKUP H root = FLOOKUP G root /\
+    op_taint u (Var root) = op_taint tn (Var root)) /\
+  (!id entry. FLOOKUP s.vs_allocas id = SOME entry ==>
+    FLOOKUP t.vs_allocas id = SOME entry) ==>
+  registration_old_resources first t H u old
+Proof
+  strip_tac >> simp[registration_old_resources_def, EVERY_MEM] >>
+  qx_gen_tac `e` >> strip_tac >> PairCases_on `e` >>
+  rename1 `MEM (root,oid,addr,cap,tv,x) old` >>
+  drule_all registration_old_resources_member >> strip_tac >>
+  `addr + val_footprint tv x <= p` by
+    (drule_all registration_old_value_footprint_bound >> decide_tac) >>
+  `not_fresh_at first root` by
+    (gvs[not_fresh_at_def] >> metis_tac[LESS_EQ_TRANS]) >>
+  `lookup_var root t = lookup_var root s /\ FLOOKUP H root = FLOOKUP G root /\
+   op_taint u (Var root) = op_taint tn (Var root)` by metis_tac[] >>
+  `ptr_covers H u root t cap` by
+    (gvs[ptr_covers_def] >> metis_tac[]) >>
+  simp[] >> rpt strip_tac >> irule logValueFramePtrTheory.robust_val_in_memory_footprint_frame >>
+  conj_tac >- simp[] >>
+  qexistsl_tac [`s.vs_memory`, `s.vs_memory`, `tn.t_mem`,
+    `tn.t_mem UNION {j | p <= j /\ j < p+n}`] >>
+  simp[] >> rpt strip_tac >> gvs[] >> decide_tac
+QED
+
+Theorem registration_alloc_exact_physical:
+  compile_alloc_buffer n st = (buf,last) /\ fn_has_code st last fn /\
+  alloca_inv s /\ alloca_frontier_inv ctx fn site s /\
+  ALL_DISTINCT (MAP (\i. i.inst_id) (fn_insts fn)) /\
+  n < dimword(:256) /\ unit_alloca_budget ctx < dimword(:256) /\
+  FLOOKUP s.vs_allocas st.cs_next_id = NONE /\
+  ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts /\
+  fn_inst_ids_distinct fn /\ alloca_history fn s /\
+  abi_alloca_history (fn_insts fn) s /\
+  fresh_vars_wrt limit_st s /\ last.cs_next_var <= limit_st.cs_next_var ==>
+  let root = STRING #"%" (toString st.cs_next_var);
+      a = update_var root (n2w s.vs_alloca_next)
+        (s with <|vs_allocas := s.vs_allocas |+ (st.cs_next_id,(s.vs_alloca_next,n));
+                  vs_alloca_next := s.vs_alloca_next+n|>);
+      t = a with vs_inst_idx := LENGTH last.cs_current_insts
+  in alloca_inv t /\ alloca_frontier_inv ctx fn site t /\
+    alloca_history fn t /\ abi_alloca_history (fn_insts fn) t /\
+    fresh_vars_wrt limit_st t /\ entry_decoder_obs s t /\
+    ((!fuel. mem_safe_run fuel ctx fn t) ==> !fuel. mem_safe_run fuel ctx fn s)
+Proof
+  strip_tac >> pure_rewrite_tac[LET_THM] >> BETA_TAC >>
+  drule_all registration_fresh_alloc_physical >>

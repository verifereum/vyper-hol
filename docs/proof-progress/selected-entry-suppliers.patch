+(* Conditional positional certificate; no concrete singleton execution dependency. *)
+Theory dispatchedRegistrationPositionalCertificate
+Ancestors
+  dispatchedRegistrationPositionalInput dispatchedRegistrationList
+  dispatchedRegistrationPrefixResources dispatchedRegistrationResultDefs
+  finite_map words list arithmetic
+
+Theorem registration_result_owned_outputs:
+  registration_result ctx fn site lo PG st last limit_st initial G tn old
+    cef specs xs v H u owners outputs ==>
+  LIST_REL (\((name,ty),tv) (x,dst,p,id).
+    ?root ins. dst = Var root /\
+      FLOOKUP cef.ce_vars name = SOME (PtrVar dst (type_memory_size tv)) /\
+      MEM ins (fn_insts fn) /\ ins.inst_opcode = ALLOCA /\
+      ins.inst_outputs = [root] /\ ins.inst_id = id /\
+      not_fresh_at last root /\ id < last.cs_next_id /\
+      lookup_var root v = SOME (n2w p) /\
+      FLOOKUP v.vs_allocas id = SOME (p,type_memory_size tv) /\
+      FLOOKUP H root = SOME (p,type_memory_size tv) /\
+      ptr_covers H u root v (type_memory_size tv) /\
+      value_has_type tv x /\ val_wf tv x /\
+      (!m. mem_agree_outside u.t_mem v.vs_memory m ==>
+        val_in_memory tv x p m))
+    (MAP (\(name,prim,dyn,sz,ty,tv). ((name,ty),tv)) specs) outputs
+Proof
+  simp_tac bool_ss [registration_result_def] >> strip_tac >>
+  drule dispatched_registration_caller_old >> strip_tac >>
+  fs[registration_outputs_def] >>
+  simp[LIST_REL_MAP1, combinTheory.o_DEF, pairTheory.LAMBDA_PROD] >>
+  qpat_x_assum `LIST_REL _ specs outputs` mp_tac >>
+  match_mp_tac LIST_REL_mono >>
+  simp[pairTheory.FORALL_PROD] >> rpt strip_tac >>
+  drule_all registration_old_resources_member >> strip_tac >>
+  goal_assum (drule_at Any) >> simp[] >> metis_tac[]
+QED
+
+Theorem registration_positional_certificate_from_step:
+  (!ctx fn site lo PG ce env sf name prim dyn sz ty tv ofs st cef last limit_st
+      initial G tn old xs.
+    registration_input ctx fn site lo PG ce env sf [(name,prim,dyn,sz,ty,tv)]
+      ofs st cef last limit_st initial G tn old xs ==>
+    ?v H u owners outputs.
+      registration_result ctx fn site lo PG st last limit_st initial G tn old
+        cef [(name,prim,dyn,sz,ty,tv)] xs v H u owners outputs) ==>
+  LIST_REL (\(name,ty) (ty',tv).
+    ty = ty' /\ abi_decoder_coherent ce env ce.ce_struct_fields ty tv /\
+    (?loc. FLOOKUP ce.ce_vars name = SOME loc /\
+      var_location_memory_size loc = SOME (type_memory_size tv)) /\
+    type_memory_size tv < dimword (:256)) args tys /\
+  ALL_DISTINCT (MAP FST args) /\
+  compile_register_positional_args ce (build_positional_args ce args) (4+0) st =
+    (cef,last) /\
+  calldata_decode_args initial.vs_call_ctx.cc_calldata (MAP SND tys) 0 = SOME xs /\
+  4+0+SUM (MAP tv_abi_size (MAP SND tys)) < dimword (:256) /\
+  dispatched_registration_caller ctx fn site lo PG st limit_st initial G tn [] /\
+  fn_has_code st last fn /\ fn_inst_ids_distinct fn /\
+  ALL_DISTINCT (MAP (\i. i.inst_id) (fn_insts fn)) /\
+  unit_alloca_budget ctx < dimword (:256) /\ ~ctx_has_dalloca ctx /\
+  (last.cs_current_insts = [] ==>
+    !bb. lookup_block last.cs_current_bb fn.fn_blocks = SOME bb ==>
+      phi_prefix_length bb.bb_instructions = 0) /\
+  last.cs_next_var <= limit_st.cs_next_var ==>
+  ?specs v H u owners outputs.
+    MAP (\(name,prim,dyn,sz,ty,tv).
+      (name,prim,dyn,sz,type_to_abi_dec_info ce.ce_struct_fields ce ty)) specs =
+      build_positional_args ce args /\
+    MAP (\(name,prim,dyn,sz,ty,tv). name) specs = MAP FST args /\
+    MAP (\(name,prim,dyn,sz,ty,tv). ((name,ty),tv)) specs =
+      ZIP (args,MAP SND tys) /\
+    EVERY (\(name,prim,dyn,sz,ty,tv).
+      abi_decoder_coherent ce env ce.ce_struct_fields ty tv /\
+      (?loc. FLOOKUP ce.ce_vars name = SOME loc /\
+        var_location_memory_size loc = SOME (type_memory_size tv)) /\
+      (prim ==> ?c. type_to_abi_dec_info ce.ce_struct_fields ce ty = DecPrimWord c) /\
+      type_memory_size tv < dimword (:256)) specs /\
+    MAP (\(name,prim,dyn,sz,ty,tv). tv) specs = MAP SND tys /\
+    EVERY (\(name,prim,dyn,sz,ty,tv).
+      dyn = tv_abi_dynamic tv /\ sz = tv_abi_size tv /\
+      (prim ==> ~dyn /\ ?c.
+        type_to_abi_dec_info ce.ce_struct_fields ce ty = DecPrimWord c)) specs /\
+    registration_input ctx fn site lo PG ce env ce.ce_struct_fields specs 0 st
+      cef last limit_st initial G tn [] xs /\
+    registration_result ctx fn site lo PG st last limit_st initial G tn []
+      cef specs xs v H u owners outputs /\
+    LIST_REL (\((name,ty),tv) (x,dst,p,id).
+      ?root ins. dst = Var root /\
+        FLOOKUP cef.ce_vars name = SOME (PtrVar dst (type_memory_size tv)) /\
+        MEM ins (fn_insts fn) /\ ins.inst_opcode = ALLOCA /\
+        ins.inst_outputs = [root] /\ ins.inst_id = id /\
+        not_fresh_at last root /\ id < last.cs_next_id /\
+        lookup_var root v = SOME (n2w p) /\
+        FLOOKUP v.vs_allocas id = SOME (p,type_memory_size tv) /\
+        FLOOKUP H root = SOME (p,type_memory_size tv) /\
+        ptr_covers H u root v (type_memory_size tv) /\
+        value_has_type tv x /\ val_wf tv x /\
+        (!m. mem_agree_outside u.t_mem v.vs_memory m ==>
+          val_in_memory tv x p m)) (ZIP (args,MAP SND tys)) outputs
+Proof
+  disch_tac >> strip_tac >>
+  drule_all registration_positional_input >> strip_tac >>
+  drule registration_list_joint_from_step >>
+  disch_then (drule_then strip_assume_tac) >>
+  drule registration_result_owned_outputs >> strip_tac >>
+  qexistsl_tac [`specs`, `v`, `H`, `u`, `owners`, `outputs`] >> gvs[]
+QED
diff --git a/lowering/dispatchedRegistrationPositionalInputScript.sml b/lowering/dispatchedRegistrationPositionalInputScript.sml

+Theorem calldata_decoder_sequence_future_frame:
+  compile_abi_decode_to_buf dst src CALLDATALOAD (Lit 0w) (Lit 0w) di st = ((),last) /\
+  same_blocks st last /\
+  EVERY (\i. i.inst_opcode <> INVOKE) (emitted_insts st last) /\
+  run_inst_seq (emitted_insts st last) s = OK t /\ last.cs_next_var <= cutoff ==>
+  future_frame cutoff s t
+Proof
+  strip_tac >> irule decoder_sequence_future_frame >>
+  qexists_tac `emitted_insts st last` >> simp[] >>
+  mp_tac (cj 1 abi_decode_outputs_below_final_mutual) >>
+  simp_tac bool_ss [abi_decode_outputs_below_final_def] >>
+  disch_then drule >> strip_tac >>
+  fs[EVERY_MEM] >> rpt strip_tac >> simp[] >>

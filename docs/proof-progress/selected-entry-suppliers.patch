+Theorem calldata_decoder_read_ghost[local]:
+  MEM opc [MLOAD;CALLDATALOAD;LT;ISZERO] /\
+  out_taint tn (mk_inst id opc ops [out]) s = {} ==>
+  step_prov PG G (mk_inst id opc ops [out]) (update_var out w s) =
+    DRESTRICT G (COMPL {out}) /\
+  step_taint (mk_inst id opc ops [out]) s (update_var out w s) tn =
+    (tn with t_var := tn.t_var |+ (out,{}))
+Proof
+  strip_tac >>
+  `new_site_bytes s (update_var out w s) = {}` by
+    (simp[new_site_bytes_def, update_var_def, pred_setTheory.EXTENSION,
+       FLOOKUP_DEF] >> metis_tac[]) >>
+  gvs[] >>
+  simp[step_prov_def, set_prov_def, out_prov_def, step_taint_def,
+    set_var_taint_def, mk_inst_def, mem_taint_def,
+    step_writes_def, written_taint_def, source_memory_write_ranges_def,
+    store_taint_def, adopt_reset_def, imm_taint_def, update_var_def,
+    taint_component_equality, range_bytes_def] >>
+  Cases_on `ops` >> simp[written_taint_def] >>
+  Cases_on `t` >> simp[written_taint_def] >>
+  Cases_on `t'` >> simp[written_taint_def] >>
+  Cases_on `t` >> simp[written_taint_def] >>
+  simp[pred_setTheory.EXTENSION, range_bytes_def, FLOOKUP_DEF] >> metis_tac[]
+QED

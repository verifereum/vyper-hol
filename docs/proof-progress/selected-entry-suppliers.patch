+Theorem calldata_decoder_loop_prepare_joint:
+  abi_decode_array_element_setup (Var p) src (Var root) CALLDATALOAD (Lit 0w) (Lit 0w)
+    di abi_sz mem_sz st = (ops,ready) /\ fn_has_code st ready fn /\
+  allocas_from lo s /\ ~ctx_has_dalloca ctx /\ ~s.vs_halted /\
+  lookup_block s.vs_current_bb fn.fn_blocks = SOME
+    <|bb_label := hdr; bb_instructions :=
+      abi_decode_header_insts id (Var p) src CALLDATALOAD iv cv cmp done body_lbl exit|> /\
+  s.vs_inst_idx = 0 /\ lookup_block body_lbl fn.fn_blocks = SOME target /\
+  phi_prefix_length target.bb_instructions = 0 /\
+  st.cs_current_bb = body_lbl /\ st.cs_current_insts = [] /\
+  lookup_var p s = SOME (n2w slot) /\ slot+32 < dimword(:256) /\
+  slot+32 <= s.vs_alloca_next /\ ptr_covers G tn p s 32 /\
+  (!a. slot <= a /\ a < slot+32 ==> a NOTIN tn.t_mem) /\
+  mload slot s = n2w j /\
+  eval_operand src s = SOME (n2w sb) /\ op_taint tn src = {} /\ op_prov G src = NONE /\
+  abi_decode_load CALLDATALOAD (n2w sb:bytes32) s = n2w n /\ j < n /\ n < dimword(:256) /\
+  lookup_var root s = SOME (n2w d) /\ ptr_covers G tn root s capacity /\
+  not_fresh_at st p /\ not_fresh_at st root /\
+  (!x. src = Var x ==> not_fresh_at st x) /\
+  abi_decoder_operand_live st.cs_next_var src /\
+  abi_decoder_operand_live st.cs_next_var (Var root) /\
+  (!v. MEM v [iv;cv;cmp;done] ==> p <> v /\ root <> v /\ src <> Var v) /\
+  (!v x. MEM v [iv;cv;cmp;done] /\ not_fresh_at st x ==> x <> v) /\ iv <> cv /\
+  32+j*mem_sz+mem_sz <= capacity /\
+  d+32+j*mem_sz < dimword(:256) /\ mem_sz < dimword(:256) ==>
+  ?entry H th child.
+    SND (SND ops) = Var child /\
+    (!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+      (s,G,tn) [] (OK entry,H,th)) /\
+    ~entry.vs_halted /\ entry.vs_current_bb = ready.cs_current_bb /\
+    entry.vs_inst_idx = LENGTH ready.cs_current_insts /\
+    eval_operand (FST ops) entry = SOME (n2w j) /\
+    eval_operand (FST (SND ops)) entry = SOME
+      (if dec_info_needs_offset di then n2w (sb+32) +
+         abi_decode_load CALLDATALOAD (n2w (sb+32+j*abi_sz):bytes32) s
+       else n2w (sb+32+j*abi_sz)) /\
+    lookup_var child entry = SOME (n2w (d+32+j*mem_sz)) /\
+    ptr_covers H th child entry mem_sz /\
+    op_taint th (FST ops) = {} /\ op_prov H (FST ops) = NONE /\
+    op_taint th (FST (SND ops)) = {} /\ op_prov H (FST (SND ops)) = NONE /\
+    ptr_covers H th p entry 32 /\ ptr_covers H th root entry capacity /\
+    op_taint th src = {} /\ op_prov H src = NONE /\
+    entry.vs_memory = s.vs_memory /\ entry.vs_allocas = s.vs_allocas /\
+    entry.vs_alloca_next = s.vs_alloca_next /\ entry.vs_call_ctx = s.vs_call_ctx /\
+    entry.vs_data_section = s.vs_data_section /\ th.t_mem = tn.t_mem /\
+    (!x. not_fresh_at st x ==>
+      lookup_var x entry = lookup_var x s /\ FLOOKUP H x = FLOOKUP G x /\
+      op_taint th (Var x) = op_taint tn (Var x))
+Proof
+  strip_tac >>
+  qabbrev_tac `head = jump_to body_lbl (abi_decode_header_state iv cv cmp done j n s)` >>
+  `src <> Var iv /\ j <= n /\ slot < dimword(:256)` by
+    (conj_tac >- metis_tac[MEM] >> decide_tac) >>
+  `mem_word_taint tn.t_mem (w2n (n2w slot:bytes32)) = {}` by
+    (simp[mem_word_taint_def,pred_setTheory.EXTENSION] >>
+     gen_tac >> Cases_on `x < 32` >> simp[] >> first_x_assum irule >> decide_tac) >>
+  `eval_operand (Var p) s = SOME (n2w slot) /\
+   w2n (n2w slot:bytes32)+32 <= s.vs_alloca_next /\
+   mload (w2n (n2w slot:bytes32)) s = n2w j /\
+   lookup_block (if j<n then body_lbl else exit) fn.fn_blocks = SOME target` by
+    simp[eval_operand_def] >>
+  mp_tac (Q.INST [`s` |-> `s`, `p` |-> `p`, `src` |-> `src`,
+    `j` |-> `j`, `n` |-> `n`, `dw` |-> `(n2w slot:bytes32)`,
+    `sw` |-> `(n2w sb:bytes32)`] calldata_decoder_loop_header_joint) >>
+  (impl_tac >- (asm_rewrite_tac[] >> metis_tac[])) >> strip_tac >>
+  rename1 `gas_origin_ptr_path _ (s,G,tn) [] (OK _,HG,ht)` >>
+  `lookup_var p head = SOME (n2w slot) /\ mload slot head = n2w j /\
+   eval_operand src head = SOME (n2w sb) /\ lookup_var root head = SOME (n2w d)`
+    by suspend "head_values" >>
+  `allocas_from lo head /\ ~head.vs_halted /\
+   head.vs_current_bb = st.cs_current_bb /\
+   head.vs_inst_idx = LENGTH st.cs_current_insts /\
+   slot+32 <= head.vs_alloca_next /\
+   ptr_covers HG ht p head 32 /\ ptr_covers HG ht root head capacity /\
+   (!a. slot <= a /\ a < slot+32 ==> a NOTIN ht.t_mem) /\
+   op_taint ht src = {} /\ op_prov HG src = NONE` by suspend "head_resources" >>
+  `eval_operand (Var p) head = SOME (n2w slot) /\
+   eval_operand (Var root) head = SOME (n2w d) /\
+   mload (w2n (n2w slot:bytes32)) head = n2w j /\ j < dimword(:256)` by
+    (simp[eval_operand_def] >> decide_tac) >>
+  drule_all calldata_element_setup_repeat >> strip_tac >>
+  drule_all calldata_array_element_setup_endpoint_ptr_origin_core >>
+  disch_then (qspecl_then [`ARB`,`cx`,`ctx`,`PG`,`R`] strip_assume_tac) >>
+  rename1 `ptr_covers FG ft child _ mem_sz` >>
+  qabbrev_tac `entry = t with vs_inst_idx := LENGTH ready.cs_current_insts` >>
+  qexistsl_tac [`entry`,`FG`,`ft`,`child`] >>
+  conj_tac >- simp[] >>
+  conj_tac >- suspend "joint" >>
+  suspend "fields"
+QED

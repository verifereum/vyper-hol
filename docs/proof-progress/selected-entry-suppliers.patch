+(* Completed slots survive a decreasing-taint frame without requiring clean slack. *)
+Theorem reentrant_completed_slots_transport[local]:
+  dirty' SUBSET dirty /\
+  (!j. j < i ==> value_has_type tv (EL j xs) /\ val_wf tv (EL j xs) /\
+    mem_bytes_at (d+32+j*type_memory_size tv) (type_memory_size tv) mem' =
+      mem_bytes_at (d+32+j*type_memory_size tv) (type_memory_size tv) mem /\
+    (!m. mem_agree_outside dirty mem m ==>
+      val_in_memory tv (EL j xs) (d+32+j*type_memory_size tv) m)) ==>
+  !j. j < i ==> value_has_type tv (EL j xs) /\ val_wf tv (EL j xs) /\
+    (!m. mem_agree_outside dirty' mem' m ==>
+      val_in_memory tv (EL j xs) (d+32+j*type_memory_size tv) m)
+Proof
+  strip_tac >> gen_tac >> strip_tac >>
+  first_x_assum (drule_then strip_assume_tac) >>
+  simp[] >> rpt strip_tac >> irule robust_val_in_memory_shrinking_frame >>
+  conj_tac >- simp[] >>
+  qexistsl_tac [`dirty`, `dirty'`, `mem`, `mem'`, `type_memory_size tv`] >>
+  simp[val_footprint_le] >> fs[SUBSET_DEF]
+QED

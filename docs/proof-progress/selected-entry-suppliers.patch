+  ?tys tvs.
+    4 <= LENGTH cd /\
+    FIND (\(n,ts). abi_method_id (type_env tops) n ts = cd_selector cd)
+      (abi_external_signatures tops) = SOME (name,tys) /\
+    OPT_MMAP (evaluate_type (type_env tops)) tys = SOME tvs /\
+    4 + SUM (MAP tv_abi_size tvs) <= LENGTH cd /\
+    calldata_decode_args cd tvs 0 = SOME vals
+Proof
+  simp[calldata_dispatch_def, AllCaseEqs()] >>
+  rpt strip_tac >> gvs[] >>
+  goal_assum (drule_at Any) >> simp[]
+QED
+
+Theorem dispatched_decode_inputs:
+  supported_program tops /\ source_typing_ok tops am tx /\
+  calldata_dispatch tops cd = SOME (tx.function_name,tx.args) /\
+  tx.function_name <> "__default__" /\
+  vyperInterpreter$lookup_function NONE tx.function_name External tops =
+    SOME (mut,F,args,[],ret,fbody) ==>
+  ?tvs. OPT_MMAP (evaluate_type (type_env tops)) (MAP SND args) = SOME tvs /\
+    4 + SUM (MAP tv_abi_size tvs) <= LENGTH cd /\
+    calldata_decode_args cd tvs 0 = SOME tx.args
+Proof
+  strip_tac >> drule_all dispatched_signature_hit >> strip_tac >>
+  `MEM (tx.function_name,tys) (abi_external_signatures tops)` by
+    metis_tac[venomInstTheory.FIND_MEM] >>
+  drule_all dispatched_signature_args >> strip_tac >> gvs[] >>
+  goal_assum (drule_at Any) >> simp[]
+QED
+
+Theorem dispatched_entry_target:
+  supported_program tops /\ source_typing_ok tops am tx /\
+  calldata_dispatch tops cd = SOME (tx.function_name,tx.args) /\
+  tx.function_name <> "__default__" /\
+  vyperInterpreter$lookup_function NONE tx.function_name External tops =
+    SOME (mut,F,args,[],ret,fbody) ==>
+  !fb. linear_dispatch_target cd
+    (MAP (\(sel,lbl,z). (sel,lbl))
+      (build_selectors (type_env tops) (FST (classify_functions tops)))) fb =
+    "fn_" ++ tx.function_name
+Proof
+  strip_tac >>
+  `ALL_DISTINCT (FLAT (MAP (external_name_keys_toplevel (NONE:num option)) tops))` by
+    (gvs[source_typing_ok_def] >>
+     drule vyperTypeContractTheory.check_contract_external_names_distinct >>
+     simp[vyperTypeContractTheory.contract_keys_def]) >>
+  drule_all source_dispatched_linear_target >> strip_tac >> gvs[]
+QED
+
+Theorem dispatched_entry_placement:
+  lower_vyper_runtime_unit tops rpolicy = SOME unit /\
+  supported_program tops /\ source_typing_ok tops am tx /\
+  calldata_dispatch tops cd = SOME (tx.function_name,tx.args) /\
+  tx.function_name <> "__default__" /\
+  vyperInterpreter$lookup_function NONE tx.function_name External tops =
+    SOME (mut,F,args,[],ret,fbody) /\
+  bind_arguments (type_env tops) args tx.args = SOME env ==>
+  ?lbl cenv0 pos_args min_cds is_payable nkey ut' iv rt
+    func elbl fb ds de opened st cenv sa st' tvs.
+    set_external_package_target rpolicy.rpol_target
+      (package_external_fn tops T (K global_nonreentrant_slot)
+        (mut,F,lookup_raw_return_or_F (NONE:num option) tx.function_name External tops,
+         tx.function_name,args,([]:expr list),ret,fbody)) =
+      (lbl,cenv0,pos_args,min_cds,is_payable,F,nkey,ut',iv,fbody,rt) /\
+    pos_args = build_positional_args cenv0 args /\
+    ALL_DISTINCT (MAP FST args) /\
+    OPT_MMAP (evaluate_type (type_env tops)) (MAP SND args) = SOME tvs /\
+    4 + SUM (MAP tv_abi_size tvs) <= LENGTH cd /\
+    calldata_decode_args cd tvs 0 = SOME tx.args /\
+    LIST_REL (\ty tv.
+      abi_decoder_coherent cenv0 (type_env tops) cenv0.ce_struct_fields ty tv /\
+      type_memory_bytes cenv0 ty = type_memory_size tv /\
+      abi_embedded_static_size cenv0.ce_struct_fields ty =
+        abi_member_head_size (vyper_to_abi_type (type_env tops) ty))
+      (MAP SND args) tvs /\
+    lbl = "fn_" ++ tx.function_name /\ is_payable = (mut = Payable) /\
+    unit.cu_context.ctx_entry = SOME "__entry" /\
+    venomInst$lookup_function "__entry" unit.cu_context.ctx_functions = SOME func /\
+    fn_entry_label func = SOME elbl /\
+    compile_selector_dispatch_linear
+      (MAP (\(sel,lbl,z). (sel,lbl))
+        (build_selectors (type_env tops) (FST (classify_functions tops))))
+      fb ds = ((),de) /\
+    compile_entry_checks min_cds is_payable opened = ((),st) /\
+    compile_register_positional_args cenv0 pos_args 4 st = (cenv,sa) /\
+    compile_guarded_body cenv F nkey ut' iv fbody rt sa = ((),st') /\
+    fn_has_code ds de func /\ fn_has_code opened st func /\
+    fn_has_code st sa func /\ fn_has_code sa st' func /\
+    ds.cs_current_bb = elbl /\ ds.cs_current_insts = [] /\ ds.cs_next_var = 0 /\
+    opened.cs_current_bb = lbl /\ opened.cs_current_insts = [] /\
+    ~block_is_terminated opened /\
+    shape_state opened /\ shape_state st /\ shape_state sa /\
+    de.cs_next_var <= opened.cs_next_var /\
+    local_ptrs_reserved cenv sa /\ ~block_is_terminated sa /\
+    cenv.ce_return_buf = NONE /\ fn_inst_ids_distinct func /\
+    runtime_entry_body_start tops rpolicy
+      (lbl,cenv0,pos_args,min_cds,is_payable,F,nkey,ut',iv,fbody,rt) st /\
+    linear_dispatch_target cd
+      (MAP (\(sel,lbl,z). (sel,lbl))
+        (build_selectors (type_env tops) (FST (classify_functions tops)))) fb = lbl
+Proof
+  strip_tac >>
+  `ALL_DISTINCT (FLAT (MAP (external_name_keys_toplevel (NONE:num option)) tops))` by
+    (gvs[source_typing_ok_def] >>
+     drule vyperTypeContractTheory.check_contract_external_names_distinct >>
+     simp[vyperTypeContractTheory.contract_keys_def]) >>
+  drule vyperLoweringCorrectTheory.lower_vyper_runtime_unit_context_entry >> strip_tac >>
+  drule_all lowered_unit_entry_facts >> strip_tac >>
+  `?cenv0 pos_args min_cds nkey ut' iv rt.
+    set_external_package_target rpolicy.rpol_target
+      (package_external_fn tops T (K global_nonreentrant_slot)
+        (mut,F,lookup_raw_return_or_F (NONE:num option) tx.function_name External tops,
+         tx.function_name,args,([]:expr list),ret,fbody)) =
+      ("fn_" ++ tx.function_name,cenv0,pos_args,min_cds,mut = Payable,F,nkey,ut',iv,fbody,rt)` by
+    (simp[package_external_fn_def, set_external_package_target_def] >> metis_tac[]) >>
+  drule_all source_selected_entry_prefix_structure_placement >> strip_tac >>
+  drule_all dispatched_entry_target >> strip_tac >>
+  drule_all dispatched_decode_inputs >> strip_tac >>
+  drule_all selected_external_package_evaluated_metadata >> strip_tac >>
+  qexistsl_tac [`"fn_" ++ tx.function_name`, `cenv0`, `pos_args`, `min_cds`,
+    `mut = Payable`, `nkey`, `ut'`, `iv`, `rt`, `fn`, `lbl`,
+    `fb`, `ds`, `de`, `opened`, `st`, `cenv`, `sa`, `st'`, `tvs`] >>
+  simp[runtime_entry_body_start_def]
+QED
diff --git a/lowering/dispatchedRegistrationAddressJointScript.sml b/lowering/dispatchedRegistrationAddressJointScript.sml
new file mode 100644
index 000000000..65011813e
--- /dev/null
+++ b/lowering/dispatchedRegistrationAddressJointScript.sml
@@ -0,0 +1,121 @@
+(* Actual registration address arithmetic and its successful pointer guard. *)
+Theory dispatchedRegistrationAddressJoint
+Ancestors
+  registrationGuardPtr dispatchedDecoderLoopCaseJoint fragGasPathMem
+  calldataRegistrationExec abiDecoderLoopRegisters emitHelperProps exprLoweringProps
+  abiDecoderReentry abiDecoderContract compileEnv emitHelper
+  fragExec fragGasOriginPtrLoop fragGasOriginPtr fragGasOrigin fragGasMode ptrSafeRun ptrDiscipline
+  bodyPtrDefs loweringStateRelDefs venomState venomInst venomExecSemantics
+  finite_map words list arithmetic codegenRel contextCodegenRel
+
+Theorem registration_actual_address_joint:
+  emit_op ADD [Lit (n2w 4); Lit (n2w (off-4))] st = (head,after_head) /\
+  (if dyn /\ ~prim then
+    ?offset after_load after_src.
+      emit_op CALLDATALOAD [head] after_head = (offset,after_load) /\
+      emit_op ADD [Lit (n2w 4); offset] after_load = (src,after_src) /\
+      compile_abi_arg_ptr_guard CALLDATALOAD src (Lit 4w) after_src = ((),first)
+   else src = head /\ first = after_head) /\
+  (dyn /\ ~prim ==> ~((n2w 4 + abi_decode_load CALLDATALOAD
+    (n2w 4 + n2w (off-4):bytes32) s) <+ 4w)) /\
+  fn_has_code st first fn /\ fn_inst_ids_distinct fn /\
+  allocas_from lo s /\ lo <= s.vs_alloca_next /\ ~ctx_has_dalloca ctx /\
+  ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts /\
+  fresh_vars_wrt limit s /\ first.cs_next_var <= limit.cs_next_var ==>
+  ?t H u.
+    calldata_loop_joint_rel lo ctx fn PG (s,G,tn) (t,H,u) /\
+    ~t.vs_halted /\ t.vs_current_bb = first.cs_current_bb /\
+    t.vs_inst_idx = LENGTH first.cs_current_insts /\ fresh_vars_wrt limit t /\
+    eval_operand src t = SOME
+      (if dyn /\ ~prim then n2w 4 + abi_decode_load CALLDATALOAD
+         (n2w 4 + n2w (off-4):bytes32) s else n2w 4 + n2w (off-4)) /\
+    abi_decoder_operand_live first.cs_next_var src /\
+    op_taint u src = {} /\ op_prov H src = NONE /\
+    t = s with <|vs_vars := t.vs_vars; vs_inst_idx := LENGTH first.cs_current_insts|> /\
+    (!op. (!x. op = Var x ==> not_fresh_at st x) ==>
+      eval_operand op t = eval_operand op s) /\
+    (!x. not_fresh_at st x ==> lookup_var x t = lookup_var x s /\
+      FLOOKUP H x = FLOOKUP G x /\ op_taint u (Var x) = op_taint tn (Var x)) /\
+    u.t_mem = tn.t_mem /\ u.t_stor = tn.t_stor /\
+    u.t_trans = tn.t_trans /\ u.t_imm = tn.t_imm
+Proof
+  strip_tac >> Cases_on `dyn /\ ~prim`
+  >- suspend "dynamic" >>
+  gvs[] >>
+  `eval_operand (Lit (n2w 4)) s = SOME (n2w 4) /\
+   eval_operand (Lit (n2w (off-4))) s = SOME (n2w (off-4))` by
+    simp[eval_operand_def] >>
+  `op_taint tn (Lit (n2w 4)) = {} /\
+   op_taint tn (Lit (n2w (off-4))) = {} /\
+   op_prov G (Lit (n2w 4)) = NONE /\
+   op_prov G (Lit (n2w (off-4))) = NONE` by
+    simp[op_taint_def, op_prov_def] >>
+  drule_all registration_add_joint_limit >>
+  disch_then (qspec_then `PG` strip_assume_tac) >>
+  qexistsl_tac [`t`, `H`, `u`] >> simp[calldata_loop_joint_rel_def] >>
+  drule gas_path_mem_exec >> simp[exit_result_def]
+QED
+
+Resume registration_actual_address_joint[dynamic]:
+  gvs[] >>
+  `cs_extends st after_head /\ cs_extends after_head after_load /\
+   cs_extends after_load after_src /\ cs_extends after_src first` by
+    (drule registration_ptr_guard_extends >> strip_tac >>
+     imp_res_tac emit_op_extends >> simp[] >>
+     rpt conj_tac >> irule cs_extends_same_block >>
+     gvs[same_blocks_def, rich_listTheory.IS_PREFIX_APPEND]) >>
+  `cs_extends st after_src` by metis_tac[cs_extends_trans] >>
+  `fn_has_code st after_src fn /\ fn_has_code after_src first fn` by
+    metis_tac[fn_has_code_split] >>
+  `after_src.cs_next_var <= first.cs_next_var /\
+   st.cs_next_var <= after_src.cs_next_var` by
+    (drule registration_ptr_guard_code >>
+     imp_res_tac emitted_insts_emit_op >> strip_tac >> decide_tac) >>
+  `after_src.cs_next_var <= limit.cs_next_var` by decide_tac >>
+  mp_tac (Q.INST [`dyn` |-> `T`, `first` |-> `after_src`, `lower` |-> `lo`] (SPEC_ALL registration_address_prelude_joint_limit)) >>
+  simp[] >> strip_tac >>
+  rename1 `gas_path_mem ctx fn s 0 (OK a)` >>
+  rename1 `op_taint ta src = {}` >> rename1 `op_prov Ga src = NONE` >>
+  `!x. src = Var x ==> not_fresh_at after_src x` by
+    (Cases_on `src` >> gvs[abi_decoder_operand_live_def,
+      abi_decoder_older_vars_def, not_fresh_at_def]) >>
+  `allocas_from lo a` by
+    (qpat_assum `a = s with <|vs_vars := _; vs_inst_idx := _|>`
+      (fn th => once_rewrite_tac[th]) >> fs[allocas_from_def] >> metis_tac[]) >>
+  drule_all registration_ptr_guard_joint_success_limit >>
+  disch_then (qspec_then `PG` strip_assume_tac) >>
+  qpat_x_assum `t = update_var _ _ _ with vs_inst_idx := _` kall_tac >>
+  suspend "join"
+QED
+
+Resume registration_actual_address_joint[join]:
+  `!x. not_fresh_at st x ==> not_fresh_at after_src x` by
+    (simp[not_fresh_at_def] >> rpt strip_tac >> decide_tac) >>
+  `eval_operand src t = eval_operand src a` by metis_tac[] >>
+  `op_taint u src = {} /\ op_prov H src = NONE` by
+    (Cases_on `src` >> gvs[op_taint_def, op_prov_def] >> metis_tac[]) >>
+  `abi_decoder_operand_live first.cs_next_var src` by
+    (Cases_on `src` >> gvs[abi_decoder_operand_live_def,
+      abi_decoder_older_vars_def] >> decide_tac) >>
+  `!D explicit. gas_origin_ptr_path (D,lo,explicit,ctx,fn,PG)
+    (s,G,tn) [] (OK t,H,u)` by
+    (rpt gen_tac >> irule gas_origin_ptr_path_trans >>
+     qexistsl_tac [`Ga`, `a`, `ta`] >> simp[]) >>
+  qexistsl_tac [`t`, `H`, `u`] >> simp[] >>
+  conj_tac
+  >- (simp[calldata_loop_joint_rel_def] >>
+      dxrule gas_path_mem_exec >> simp[exit_result_def] >> strip_tac >>
+      dxrule gas_path_mem_exec >> simp[exit_result_def] >> strip_tac >>
+      rpt strip_tac >>
+      qpat_x_assum `!fuel. (!e. run_from fuel ctx fn t <> Error e) ==> _`
+        (qspec_then `fuel` mp_tac) >> simp[] >> strip_tac >>
+      qpat_x_assum `!fuel. (!e. run_from fuel ctx fn a <> Error e) ==> _`
+        (qspec_then `fuel'` mp_tac) >> simp[] >> metis_tac[]) >>
+  qpat_assum `t = a with <|vs_vars := _; vs_inst_idx := _|>`
+    (fn th => once_rewrite_tac[th]) >>
+  qpat_assum `a = s with <|vs_vars := _; vs_inst_idx := _|>`
+    (fn th => once_rewrite_tac[th]) >> simp[]
+QED
+
+Finalise registration_actual_address_joint
diff --git a/lowering/dispatchedRegistrationAddressPhysicalScript.sml b/lowering/dispatchedRegistrationAddressPhysicalScript.sml
new file mode 100644
index 000000000..25a4fcaad
--- /dev/null
+++ b/lowering/dispatchedRegistrationAddressPhysicalScript.sml
@@ -0,0 +1,350 @@
+(* Physical certificates at the very same states as the joint address path. *)
+Theory dispatchedRegistrationAddressPhysical
+Ancestors
+  dispatchedRegistrationExactFrame dispatchedRegistrationAddressJoint calldataOverwritePtr
+  registrationGuardPtr dispatchedDecoderLoopCaseJoint fragGasPathMem
+  calldataRegistrationExec abiDecoderLoopRegisters emitHelperProps exprLoweringProps
+  abiDecoderReentry abiDecoderContract compileEnv emitHelper
+  fragExec fragGasOriginPtrLoop fragGasOriginPtr fragGasOrigin fragGasMode ptrSafeRun ptrDiscipline
+  bodyPtrDefs loweringStateRelDefs venomState venomInst venomExecSemantics
+  finite_map words list rich_list arithmetic codegenRel contextCodegenRel
+  entryDecoderStateFrame entryDecoderHistoryFrame abiDecoderReentryAddress
+
+Definition registration_address_physical_def:
+  registration_address_physical ctx fn site s t <=>
+    alloca_inv t /\ alloca_frontier_inv ctx fn site t /\ alloca_history fn t /\
+    entry_decoder_obs s t /\
+    ((!fuel. mem_safe_run fuel ctx fn t) ==> !fuel. mem_safe_run fuel ctx fn s) /\
+    (!fuel r. run_from fuel ctx fn t = r /\ (!err. r <> Error err) ==>
+      ?fuel'. run_from fuel' ctx fn s = r /\
+        (mem_safe_run fuel ctx fn t ==> mem_safe_run fuel' ctx fn s))
+End
+
+Theorem registration_address_physical_trans[local]:
+  registration_address_physical ctx fn site s t /\
+  registration_address_physical ctx fn site t u ==>
+  registration_address_physical ctx fn site s u
+Proof
+  simp[registration_address_physical_def] >>
+  metis_tac[entry_decoder_obs_trans]
+QED
+
+Theorem registration_add_at_joint[local]:
+  emit_op ADD [lhs;rhs] st = (out,last) /\
+  eval_operand lhs s = SOME a /\ eval_operand rhs s = SOME b /\
+  t = (update_var (STRING #"%" (toString st.cs_next_var)) (a+b) s)
+    with vs_inst_idx := LENGTH last.cs_current_insts /\
+  fn_has_code st last fn /\ fn_inst_ids_distinct fn /\
+  alloca_history fn s /\ alloca_inv s /\ alloca_frontier_inv ctx fn site s /\
+  fresh_vars_wrt limit s /\ last.cs_next_var <= limit.cs_next_var /\
+  ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts ==>
+  registration_address_physical ctx fn site s t
+Proof
+  strip_tac >>
+  `step_inst_base (mk_inst st.cs_next_id ADD [lhs;rhs]
+    [STRING #"%" (toString st.cs_next_var)]) s =
+    OK (update_var (STRING #"%" (toString st.cs_next_var)) (a+b) s)` by
+    (irule step_ADD >> simp[]) >>
+  drule_all (SRULE [] (Q.INST [`opc` |-> `ADD`] registration_pure_operation_exact_frame)) >>
+  simp[registration_address_physical_def]
+QED
+
+Theorem registration_load_at_joint[local]:
+  emit_op CALLDATALOAD [src] st = (out,last) /\ eval_operand src s = SOME p /\
+  run_inst_seq (emitted_insts st last) s = OK (t with vs_inst_idx := s.vs_inst_idx) /\
+  t.vs_inst_idx = LENGTH last.cs_current_insts /\
+  fn_has_code st last fn /\ fn_inst_ids_distinct fn /\
+  alloca_history fn s /\ alloca_inv s /\ alloca_frontier_inv ctx fn site s /\
+  fresh_vars_wrt limit s /\ last.cs_next_var <= limit.cs_next_var /\
+  ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts ==>
+  registration_address_physical ctx fn site s t
+Proof
+  strip_tac >>
+  `step_inst_base (mk_inst st.cs_next_id CALLDATALOAD [src]
+    [STRING #"%" (toString st.cs_next_var)]) s =
+    OK (update_var (STRING #"%" (toString st.cs_next_var))
+      (abi_decode_load CALLDATALOAD p s) s)` by
+    (irule abi_decode_read_step >> simp[abi_decode_source_opcode_def]) >>
+  `t = (update_var (STRING #"%" (toString st.cs_next_var))
+      (abi_decode_load CALLDATALOAD p s) s)
+      with vs_inst_idx := LENGTH last.cs_current_insts` by
+    (drule emitted_insts_emit_op >> strip_tac >>
+     fs[run_inst_seq_def] >>
+     qpat_x_assum `t.vs_inst_idx = _` (fn th => rewrite_tac[GSYM th]) >>
+     simp[]) >>
+  drule_all (SRULE [] (Q.INST [`opc` |-> `CALLDATALOAD`] registration_pure_operation_exact_frame)) >>
+  simp[registration_address_physical_def]
+QED
+
+Theorem registration_prelude_joint_physical[local]:
+  emit_op ADD [Lit (n2w 4); Lit (n2w (off-4))] st = (head,after_head) /\
+  (if dyn then
+    ?offset after_load.
+      emit_op CALLDATALOAD [head] after_head = (offset,after_load) /\
+      emit_op ADD [Lit (n2w 4); offset] after_load = (src,first)
+   else src = head /\ first = after_head) /\
+  fn_has_code st first fn /\ fn_inst_ids_distinct fn /\
+  allocas_from lower s /\ lower <= s.vs_alloca_next /\ ~ctx_has_dalloca ctx /\
+  ~s.vs_halted /\ s.vs_current_bb = st.cs_current_bb /\
+  s.vs_inst_idx = LENGTH st.cs_current_insts /\
+  fresh_vars_wrt limit s /\ first.cs_next_var <= limit.cs_next_var /\
+  alloca_inv s /\ alloca_frontier_inv ctx fn site s /\ alloca_history fn s ==>
+  ?t H u.
+    ~t.vs_halted /\ t.vs_current_bb = first.cs_current_bb /\
+    t.vs_inst_idx = LENGTH first.cs_current_insts /\ fresh_vars_wrt limit t /\
+    eval_operand src t = SOME
+      (if dyn then n2w 4 + abi_decode_load CALLDATALOAD
+         (n2w 4 + n2w (off-4):bytes32) s else n2w 4 + n2w (off-4)) /\
+    abi_decoder_operand_live first.cs_next_var src /\
+    op_taint u src = {} /\ op_prov H src = NONE /\
+    t = s with <|vs_vars := t.vs_vars; vs_inst_idx := LENGTH first.cs_current_insts|> /\
+    (!op. (!x. op = Var x ==> not_fresh_at st x) ==>
+      eval_operand op t = eval_operand op s) /\
+    (!x. not_fresh_at st x ==> lookup_var x t = lookup_var x s /\
+      FLOOKUP H x = FLOOKUP G x /\ op_taint u (Var x) = op_taint tn (Var x)) /\
+    u.t_mem = tn.t_mem /\ u.t_stor = tn.t_stor /\
+    u.t_trans = tn.t_trans /\ u.t_imm = tn.t_imm /\
+    gas_path_mem ctx fn s 0 (OK t) /\
+    (!D explicit. gas_origin_ptr_path (D,lower,explicit,ctx,fn,PG)
+      (s,G,tn) [] (OK t,H,u)) /\
+    registration_address_physical ctx fn site s t
+Proof
+  strip_tac >> Cases_on `dyn`
+  >- suspend "dynamic" >> gvs[] >>
+  `eval_operand (Lit (n2w 4)) s = SOME (n2w 4) /\
+   eval_operand (Lit (n2w (off-4))) s = SOME (n2w (off-4))` by simp[eval_operand_def] >>
+  `op_taint tn (Lit (n2w 4)) = {} /\
+   op_taint tn (Lit (n2w (off-4))) = {} /\
+   op_prov G (Lit (n2w 4)) = NONE /\
+   op_prov G (Lit (n2w (off-4))) = NONE` by simp[op_taint_def, op_prov_def] >>
+  drule_all registration_add_joint_limit >>
+  disch_then (qspec_then `PG` strip_assume_tac) >>
+  `registration_address_physical ctx fn site s t` by
+    (drule_all registration_add_at_joint >> simp[]) >>
+  qexistsl_tac [`t`, `H`, `u`] >> simp[] >> metis_tac[]
+QED
+
+Resume registration_prelude_joint_physical[dynamic]:
+  gvs[] >>
+  `cs_extends st after_head /\ cs_extends after_head after_load /\
+   cs_extends after_load first` by
+    (imp_res_tac emit_op_extends >> rpt conj_tac >>
+     irule cs_extends_same_block >> gvs[same_blocks_def, IS_PREFIX_APPEND]) >>
+  `fn_has_code st after_head fn /\ fn_has_code after_head after_load fn /\
+   fn_has_code after_load first fn` by metis_tac[fn_has_code_split, cs_extends_trans] >>
+  `after_head.cs_next_var <= limit.cs_next_var /\
+   after_load.cs_next_var <= limit.cs_next_var` by
+    (imp_res_tac emitted_insts_emit_op >> decide_tac) >>
+  `eval_operand (Lit (n2w 4)) s = SOME (n2w 4) /\
+   eval_operand (Lit (n2w (off-4))) s = SOME (n2w (off-4))` by simp[eval_operand_def] >>
+  `op_taint tn (Lit (n2w 4)) = {} /\
+   op_taint tn (Lit (n2w (off-4))) = {} /\
+   op_prov G (Lit (n2w 4)) = NONE /\
+   op_prov G (Lit (n2w (off-4))) = NONE` by simp[op_taint_def, op_prov_def] >>
+  drule_all registration_add_joint_limit >>
+  disch_then (qspec_then `PG` strip_assume_tac) >>
+  rename1 `gas_path_mem ctx fn s 0 (OK s1)` >>
+  rename1 `op_taint tn1 head = {}` >> rename1 `op_prov G1 head = NONE` >>
+  `registration_address_physical ctx fn site s s1` by
+    (drule_all registration_add_at_joint >> simp[]) >>

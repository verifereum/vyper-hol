       i IN tn.t_mem) /\
  (!x. not_fresh_at sa x ==> lookup_var x q = lookup_var x s /\
     FLOOKUP Gq x = FLOOKUP G x /\ op_taint tq (Var x) = op_taint tn (Var x)) ==>

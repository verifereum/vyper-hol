  `(if is_word_type ty then
      eval_operand op s = SOME (typed_val_to_w256 entry.type v) /\ op_taint tn op = {}
    else ?xs sw. op = Var xs /\ not_fresh_at st xs /\ lookup_var xs s = SOME sw /\

           qpat_assum `ee with gas_obs := [] = ee` (fn obs =>
             ACCEPT_TAC (REWRITE_RULE [APPEND_NIL,result,obs] eval)))))) >>
  `expr_sim_inv cenv cx env (es with gas_obs := xs)` by simp[] >>
  drule_all tuple_immutable_target_source_endpoint >> simp[]

    target_store_place cenv head = SOME (SOME (ValPT dty)) /\
    ~is_word_type (EL i tys) /\ ~is_word_type dty /\ dty <> EL i tys /\
    ~(is_bytestring_type dty /\ is_bytestring_type (EL i tys)) ==>
    type_memory_bytes cenv dty < 2 ** 64

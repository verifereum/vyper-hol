  rpt gen_tac >> disch_then (map_every assume_tac o CONJUNCTS) >>
  qspecl_then [`cx`,`gs`,`e`,`DF`,`lo`,`d`,`PG`,`tops`,`bindings`,`ctx`,
    `shadow_ctx`,`func`,`shadow_func`,`cenv`,`env`,`env'`,`ret_ty`,`lctx`,`RetQ`,`es`]

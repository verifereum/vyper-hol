  disch_then (map_every assume_tac o CONJUNCTS) >> gvs[] >>
  `assign_tuple_target_list cx (BaseTarget bt::todo) (v::vs) =
   bind (eval_target_place cx bt) (\pl. bind (write_place cx pl v)
     (\u. assign_tuple_target_list cx todo vs))` by

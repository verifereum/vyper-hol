  (!i. p <= i /\ i < p+n /\ i IN tq.t_mem ==> i IN tn.t_mem) /\
  (!aid a cap i. FLOOKUP s.vs_allocas aid = SOME (a,cap) /\
      a <= i /\ i < a+cap /\ i IN tq.t_mem ==> i IN tn.t_mem) /\

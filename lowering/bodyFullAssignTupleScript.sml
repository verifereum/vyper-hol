    `done_lbl`,`dest`,`ctx`,`cnt`,`capacity`,`bw`,`body_lbl`,`bbh`,`a`,`PG`,
    `n`,`0`,`r`,`Gr`,`tr`] mp_tac) >>
  (impl_tac >- suspend "header") >>
  disch_then (qx_choose_then `t` (qx_choose_then `Gf` (qx_choose_then `tf` strip_assume_tac))) >>

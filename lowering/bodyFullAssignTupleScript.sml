  rename1 `EL i (g::gs) = BaseTarget head` >>
  Cases_on `g` >> Cases_on `i` >>
  simp[allocLimitsTheory.tuple_assign_alloc_ok_def] >> strip_tac >> gvs[] >> metis_tac[]
QED


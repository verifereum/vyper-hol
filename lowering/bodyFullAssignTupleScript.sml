    (gen_tac >> disch_tac >>
     qpat_assum `!region. imm = SOME region ==> _` (drule_then strip_assume_tac) >>
     Cases_on `region` >> gvs[eval_operand_def,copy_old_operand_def,op_prov_def,op_taint_def]) >>
  mp_tac (Q.INST [`sa` |-> `sm`, `s` |-> `r`, `G` |-> `Gr`, `tn` |-> `tr`,

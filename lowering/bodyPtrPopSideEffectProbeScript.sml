Theory bodyPtrPopSideEffectProbe
Ancestors vyperInterpreter vyperState bodyPtrPreds

(* Concrete fixture abbreviations keep the single side-effecting witness readable.
   They are not replacement semantics or simulation predicates. *)
Definition pop_side_word_def:
  pop_side_word = BaseT (UintT 256)
End
Definition pop_side_inner_def:
  pop_side_inner = ArrayT pop_side_word (Dynamic 2)
End
Definition pop_side_middle_def:
  pop_side_middle = ArrayT pop_side_inner (Dynamic 2)
End
Definition pop_side_type_def:
  pop_side_type = ArrayTV
    (ArrayTV (ArrayTV (BaseTV (UintT 256)) (Dynamic 2)) (Dynamic 2)) (Dynamic 2)
End
Definition pop_side_value_def:
  pop_side_value = ArrayV (DynArrayV
    [ArrayV (DynArrayV [ArrayV (DynArrayV [IntV 0])])])
End
Definition pop_side_entry_def:
  pop_side_entry = <| assignable := T; type := pop_side_type;
                     value := pop_side_value; popped := [] |>
End
Definition pop_side_zero_def:
  pop_side_zero = Literal pop_side_word (IntL 0)
End
Definition pop_side_index_def:
  pop_side_index = Subscript pop_side_word
    (Subscript pop_side_inner (Pop pop_side_middle (NameTarget "x")) pop_side_zero)
    pop_side_zero
End
Definition pop_side_target_def:
  pop_side_target = SubscriptTarget
    (SubscriptTarget (NameTarget "x") pop_side_zero) pop_side_index
End
Definition pop_side_initial_def:
  pop_side_initial es = es with scopes := [FEMPTY |+ ("x",pop_side_entry)]
End
Definition pop_side_after_index_def:
  pop_side_after_index es = es with scopes := [FEMPTY |+ ("x",
    pop_side_entry with <| value := ArrayV (DynArrayV []);
      popped := [([ValueSubscript (IntV 0)],
        ArrayV (DynArrayV [ArrayV (DynArrayV [IntV 0])]))] |>)]
End

Theorem pop_side_target_evaluation:
  eval_target_place cx pop_side_target (pop_side_initial es) =
    (INL (MemoryPlace "x" [ValueSubscript (IntV 0); ValueSubscript (IntV 0)]),
     pop_side_after_index es)
Proof
  rpt (CHANGED_TAC (EVAL_TAC >> simp[return_def]))
QED

Theorem pop_side_index_evaluation:
  bind (eval_expr cx pop_side_index) (read_result cx) (pop_side_initial es) =
    (INL (IntV 0), pop_side_after_index es)
Proof
  rpt (CHANGED_TAC (EVAL_TAC >> simp[return_def]))
QED

Theorem pop_side_prefix_evaluation:
  eval_base_place cx (SubscriptTarget (NameTarget "x") pop_side_zero)
    (pop_side_initial es) =
    (INL (PlaceR (MemoryPlace "x" [ValueSubscript (IntV 0)])), pop_side_initial es)
Proof
  rpt (CHANGED_TAC (EVAL_TAC >> simp[return_def]))
QED

Theorem pop_side_target_requires_index_judgment:
  body_base_target_ptr_ok cx pop_side_target ==> body_expr_ptr_ok cx pop_side_index
Proof
  simp[pop_side_target_def, body_base_target_ptr_ok_def] >> strip_tac >>
  first_x_assum irule >>
  qexistsl [`pop_side_initial ARB`,
    `PlaceR (MemoryPlace "x" [ValueSubscript (IntV 0)])`, `pop_side_initial ARB`] >>
  simp[pop_side_prefix_evaluation]
QED

Theorem pop_side_selected_history:
  read_place cx (MemoryPlace "x" [ValueSubscript (IntV 0); ValueSubscript (IntV 0)])
    (pop_side_after_index es) =
    (INL (ArrayV (DynArrayV [IntV 0])), pop_side_after_index es)
Proof
  rpt (CHANGED_TAC (EVAL_TAC >> simp[return_def]))
QED

Theorem pop_side_selected_not_live:
  evaluate_subscripts pop_side_type (ArrayV (DynArrayV []))
    [ValueSubscript (IntV 0); ValueSubscript (IntV 0)] =
    INR (RuntimeError "evaluate_subscripts array_index")
Proof
  rpt (CHANGED_TAC (EVAL_TAC >> simp[return_def]))
QED

Definition pop_side_final_def:
  pop_side_final es = es with scopes := [FEMPTY |+ ("x",
    pop_side_entry with <| value := ArrayV (DynArrayV []);
      popped :=
        [([ValueSubscript (IntV 0); ValueSubscript (IntV 0); ValueSubscript (IntV 0)], IntV 0);
         ([ValueSubscript (IntV 0)], ArrayV (DynArrayV [ArrayV (DynArrayV [])]))] |>)]
End

Theorem pop_side_expression_evaluation:
  eval_expr cx (Pop pop_side_word pop_side_target) (pop_side_initial es) =
    (INL (PlaceR (MemoryPlace "x"
       [ValueSubscript (IntV 0); ValueSubscript (IntV 0); ValueSubscript (IntV 0)])),
     pop_side_final es)
Proof
  rpt (CHANGED_TAC (EVAL_TAC >> simp[return_def]))
QED


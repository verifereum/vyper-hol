(* Finite-step normalization boundaries for the concrete callee experiment.
   Fresh ALLOCA normalization already lives in allocationPtr and is reused. *)
Theory bodyPtrStructLitGhostNormalize
Ancestors allocationPtr ptrDiscipline finite_map pred_set venomInst

Theorem structlit_new_site_bytes_unchanged:
  !s t. t.vs_allocas = s.vs_allocas /\ t.vs_fmp = s.vs_fmp ==>
    new_site_bytes s t = {}
Proof
  rpt strip_tac >> simp[new_site_bytes_def, EXTENSION, FLOOKUP_DEF] >>
  metis_tac[]
QED

Theorem structlit_new_site_bytes_fresh_update:
  !s t aid b sz.
    t.vs_allocas = s.vs_allocas |+ (aid,(b,sz)) /\
    aid NOTIN FDOM s.vs_allocas /\ t.vs_fmp = s.vs_fmp ==>
    new_site_bytes s t = {i | b <= i /\ i < b + sz}
Proof
  rpt strip_tac >>
  rw[new_site_bytes_def, EXTENSION, FLOOKUP_UPDATE] >>
  gvs[AllCaseEqs(), FLOOKUP_DEF] >>
  eq_tac
  >- (strip_tac >> gvs[]) >>
  strip_tac >> qexistsl [`aid`, `b`, `sz`] >> simp[]
QED

(* The generated byte-copy count is a variable, so the literal-count
   cleanliness boundary does not match this fixture's actual instruction. *)
Theorem structlit_mcopy_operand_range_clean:
  !tn id dst src count s s' a b n i.
    eval_operand dst s = SOME a /\ eval_operand src s = SOME b /\
    eval_operand count s = SOME n /\
    (!j. w2n b <= j /\ j < w2n b + w2n n ==> j NOTIN tn.t_mem) /\
    w2n a <= i /\ i < w2n a + w2n n ==>
    i NOTIN (step_taint (mk_inst id MCOPY [dst;src;count] []) s s' tn).t_mem
Proof
  rpt strip_tac >>
  gvs[step_taint_def, mem_taint_def, written_taint_def, step_writes_def,
      codegenRelTheory.source_memory_write_ranges_def,
      codegenRelTheory.fixed_source_write_range_def,
      mk_inst_def, range_bytes_def,
      codegenRelTheory.sized_source_write_range_def] >>
  first_x_assum irule >> decide_tac
QED

Theorem structlit_step_taint_memory_frame:
  !inst s t tn.
    t.vs_allocas = s.vs_allocas /\ t.vs_fmp = s.vs_fmp /\
    step_writes inst s t = [] /\ written_taint tn inst s = {} ==>
    (step_taint inst s t tn).t_mem = tn.t_mem
Proof
  rpt strip_tac >> drule_all structlit_new_site_bytes_unchanged >>
  simp[step_taint_def, mem_taint_def, range_bytes_def]
QED

Theorem structlit_mcopy_operand_byte_clean:
  !tn id dst src count s t a b n j i.
    eval_operand dst s = SOME a /\ eval_operand src s = SOME b /\
    eval_operand count s = SOME n /\ j < w2n n /\
    w2n b + j NOTIN tn.t_mem /\ i = w2n a + j ==>
    i NOTIN
      (step_taint (mk_inst id MCOPY [dst;src;count] []) s t tn).t_mem
Proof
  rpt strip_tac >>
  gvs[step_taint_def, mem_taint_def, written_taint_def, step_writes_def,
      codegenRelTheory.source_memory_write_ranges_def,
      codegenRelTheory.fixed_source_write_range_def,
      mk_inst_def, range_bytes_def,
      codegenRelTheory.sized_source_write_range_def]
QED

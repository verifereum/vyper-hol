fun warm_sue_vars_subset goal = compilerGuardEvalLib.warm_subset
  ``list_subset (fn_ir_vars (FST scalar_wei_large_sue_result))
    (SND scalar_wei_large_sue_result).irs_used_vars`` goal

(* Prepare the original raw transformation before checking its supply guards. *)
val wei_large_sue_started = ref false
fun warm_wei_large_sue_output (goal as (_,proposition)) =
  (if !wei_large_sue_started then () else let
     val inputs = evalCompilerBytecodeLib.timed_evaluation
       ``sue_expand_function_supply`` "single-use input normalization" (fn () =>
       evalCompilerBytecodeLib.normalize_call
         ``sue_expand_function_supply (SND (SND (parity_pass scalar_wei_large_program 5)))
           (FST (parity_pass scalar_wei_large_program 5))``)
   in wei_large_sue_started := true;
      compilerPassEvalLib.active := SOME (rand proposition);
      compilerPassEvalLib.pending := [rhs (concl inputs)] end;
   if null (!compilerPassEvalLib.pending) then Tactical.ALL_TAC goal
   else compilerSingleUseTraversalEvalLib.warm_step
     compilerSupplyInputsEvalLib.warm_step goal)
val wei_large_sue_slice = compilerProofSliceEvalLib.run warm_wei_large_sue_output


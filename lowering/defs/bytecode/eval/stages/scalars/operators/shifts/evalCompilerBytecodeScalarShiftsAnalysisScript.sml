fun dfg_slice goal = let
  val started = Time.now ()
  fun advance remaining goal =
    if remaining = 0 orelse
        Time.- (Time.now (),started) >= Time.fromReal 0.005 then
      Tactical.ALL_TAC goal
    else if compilerDfgBuildEvalLib.complete fixture_dfg_call then
      compilerDfgResultEvalLib.cache_checkpoint goal
    else Tactical.THEN
      (compilerDfgResultEvalLib.warm_call fixture_dfg_call,advance (remaining - 1)) goal
in advance 8 goal end


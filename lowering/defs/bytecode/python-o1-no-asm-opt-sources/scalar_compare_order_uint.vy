@external
@pure
def less_than(a: uint256, b: uint256) -> bool:
    return a < b

@external
@pure
def less_equal(a: uint256, b: uint256) -> bool:
    return a <= b

@external
@pure
def greater_than(a: uint256, b: uint256) -> bool:
    return a > b

@external
@pure
def greater_equal(a: uint256, b: uint256) -> bool:
    return a >= b

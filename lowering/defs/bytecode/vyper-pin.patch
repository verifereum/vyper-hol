Status: merged 2026-11-08 (1a1d7c0481352eefd6989c35e7c9f424c8079517)

Keep an effectless, outputless instruction (assert) as a DFT entry.
Applies after 5336-dft-abort-order.patch.

diff --git a/vyper/venom/passes/dft.py b/vyper/venom/passes/dft.py
--- a/vyper/venom/passes/dft.py
+++ b/vyper/venom/passes/dft.py
@@ -80,7 +80,18 @@
         entry_instructions: OrderedSet[IRInstruction] = OrderedSet(non_phi_instructions)
         for inst in non_phi_instructions:
             to_remove = self.dda.get(inst, OrderedSet()) | self.eda.get(inst, OrderedSet())
-            entry_instructions.dropmany(to_remove)
+            # backport of vyperlang/vyper#5349: an instruction with no
+            # outputs and no effects (an assert) stays an entry even when a
+            # later abort depends on it, so nothing is scheduled above it
+            entry_instructions.dropmany(
+                x
+                for x in to_remove
+                if not (
+                    len(x.get_outputs()) == 0
+                    and x.get_read_effects() == effects.EMPTY
+                    and x.get_write_effects() == effects.EMPTY
+                )
+            )
 
         entry_instructions_list = list(entry_instructions)
 

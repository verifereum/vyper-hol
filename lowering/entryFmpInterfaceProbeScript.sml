Theorem getfmp_load_zero_all_fuel[local]:
  !fuel. mem_safe_run fuel (mk_venom_context [] NONE)
    (mk_raw_function "probe"
      [<|bb_label := "entry"; bb_instructions :=
        [mk_inst 0 GETFMP [] ["p"];
         mk_inst 1 MLOAD [Var "p"] ["v"];
         mk_inst 2 STOP [] []]|>])
    ((init_venom_state "entry") with
      <|vs_alloca_next := 32; vs_fmp := 0w|>)

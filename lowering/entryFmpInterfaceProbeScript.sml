(* Checked finite tests of endpoint FMP normalization, not source counterexamples. *)
Theory entryFmpInterfaceProbe
Ancestors
  memSafeRun venomExecSemantics venomState venomInst unitTransformDefs
  instMemFrontier words fragExecMem vyperCompiler

Theorem getfmp_load_zero_finite[local]:
  mem_safe_run 1 (mk_venom_context [] NONE)
    (mk_raw_function "probe"
      [<|bb_label := "entry"; bb_instructions :=
        [mk_inst 0 GETFMP [] ["p"];
         mk_inst 1 MLOAD [Var "p"] ["v"];
         mk_inst 2 STOP [] []]|>])
    ((init_venom_state "entry") with
      <|vs_alloca_next := 32; vs_fmp := 0w|>)
Proof
  CONV_TAC EVAL >> simp[wordsTheory.dimword_def, venomMemPropsTheory.dimindex_256]
QED


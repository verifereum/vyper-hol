QED

Theorem getfmp_pointer_check_rejects[local]:
  !PL pv. ~inst_ptr_ok_check PL pv (mk_inst 0 GETFMP [] ["p"])
Proof
  simp[inst_ptr_ok_check_def, mk_inst_def]
QED


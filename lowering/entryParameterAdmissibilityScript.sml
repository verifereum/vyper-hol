Theory entryParameterAdmissibility
Ancestors
  list finite_map e2eDefs vyperLoweringCorrect supportedProgram supportedDecls
  vyperTypeContract vyperTypeContractContext vyperInterpreter vyperContext
  vyperAST

(* Supported external lookups cannot select an autogenerated public getter. *)
Theorem selected_external_decl[local]:
  !tops tops0 name mut nr args dflts ret fbody.
    EVERY (supported_declaration_header tops0) tops /\
    lookup_function NONE name External tops =
      SOME (mut, nr, args, dflts, ret, fbody) ==>
    ?raw. MEM (FunctionDecl External mut nr raw name args dflts ret fbody) tops
Proof
  Induct >- simp[lookup_function_def] >>
  rpt gen_tac >> strip_tac >> gvs[] >>
  Cases_on `h` >> gvs[supported_declaration_header_def, lookup_function_def] >>
  BasicProvers.every_case_tac >> gvs[lookup_function_def, AllCaseEqs()] >>
  metis_tac[]
QED

Theorem selected_external_params_ok:
  supported_program tops /\ source_typing_ok tops am tx /\
  lookup_function NONE tx.function_name External tops =
    SOME (mut, nr, args, [], ret, fbody) ==>
  params_ok (type_env tops) args
Proof
  rpt strip_tac >>
  `EVERY (supported_declaration_header tops) tops` by
    fs[supported_program_def, supported_declaration_headers_def] >>
  drule_all selected_external_decl >> strip_tac >>
  fs[source_typing_ok_def] >>
  drule check_contract_main_module_allocated >> simp[] >> strip_tac >>
  `check_function_body am.layouts tx.target [(NONE,tops)] art NONE
     External mut nr args [] ret fbody` by
    (irule check_contract_runtime_function_body_MEM >> simp[] >>
     goal_assum (drule_at Any) >> simp[]) >>
  fs[check_function_body_def, type_env_all_modules_def, type_env_def,
     FUNION_FEMPTY_2]
QED

Theorem selected_external_parameter_assignable:
  supported_program tops /\ source_typing_ok tops am tx /\
  lookup_function NONE tx.function_name External tops =
    SOME (mut, nr, args, [], ret, fbody) /\
  MEM (name, ty) args ==>
  assignable_type (type_env tops) ty
Proof
  strip_tac >> drule_all selected_external_params_ok >>
  simp[params_ok_def, EVERY_MEM] >> strip_tac >>
  first_x_assum (qspec_then `(name,ty)` mp_tac) >> simp[]
QED

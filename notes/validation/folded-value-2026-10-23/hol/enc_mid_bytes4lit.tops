[FunctionDecl External Pure F F "f"
   [("a",BaseT (IntT 128)); ("b",BaseT BoolT)] []
   (BaseT (BytesT (Dynamic 68)))
   [AnnAssign "v" (TupleT [BaseT (IntT 128); BaseT BoolT])
      (Builtin (TupleT [BaseT (IntT 128); BaseT BoolT])
         (MakeArray NONE (Fixed 2))
         [Name (BaseT (IntT 128)) "a"; Name (BaseT BoolT) "b"]);
    Return
      (SOME
         (TypeBuiltin (BaseT (BytesT (Dynamic 68)))
            (AbiEncode F (SOME [222w; 173w; 190w; 239w]))
            (TupleT [TupleT [BaseT (IntT 128); BaseT BoolT]])
            [Name (TupleT [BaseT (IntT 128); BaseT BoolT]) "v"]))]]
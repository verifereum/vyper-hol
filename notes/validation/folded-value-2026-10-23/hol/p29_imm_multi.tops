[VariableDecl Private Immutable "A" (BaseT (UintT 256)) NONE;
 VariableDecl Private Immutable "B" (BaseT AddressT) NONE;
 VariableDecl Private Immutable "C" (BaseT (BytesT (Fixed 32))) NONE;
 FunctionDecl Deploy Nonpayable F F "__init__" [("a",BaseT (UintT 256))] []
   NoneT
   [Assign (BaseTarget (TopLevelNameTarget (NONE,"A")))
      (Name (BaseT (UintT 256)) "a");
    Assign (BaseTarget (TopLevelNameTarget (NONE,"B")))
      (Builtin (BaseT AddressT) (Env Sender) []);
    Assign (BaseTarget (TopLevelNameTarget (NONE,"C")))
      (Literal (BaseT (BytesT (Fixed 32)))
         (BytesL
            [117w; 33w; 209w; 202w; 219w; 207w; 169w; 30w; 236w; 101w; 170w;
             22w; 113w; 91w; 148w; 255w; 193w; 201w; 101w; 75w; 165w; 126w;
             162w; 239w; 26w; 33w; 39w; 188w; 161w; 18w; 122w; 131w]))];
 FunctionDecl External Nonpayable F F "get" [] [] (BaseT (UintT 256))
   [Return (SOME (TopLevelName (BaseT (UintT 256)) (NONE,"A")))];
 FunctionDecl External Nonpayable F F "who" [] [] (BaseT AddressT)
   [Return (SOME (TopLevelName (BaseT AddressT) (NONE,"B")))];
 FunctionDecl External Nonpayable F F "h" [] [] (BaseT (BytesT (Fixed 32)))
   [Return (SOME (TopLevelName (BaseT (BytesT (Fixed 32))) (NONE,"C")))]]
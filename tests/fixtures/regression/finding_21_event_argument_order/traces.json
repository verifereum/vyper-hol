            "unknown_0.vy": {
              "content": "\nevent Seen:\n    data: uint256\n    topic: indexed(uint256)\n\ncounter: uint256\n\n@internal\ndef bump() -> uint256:\n    self.counter += 1\n    return self.counter\n\n@external\ndef emit_values():\n    self.counter = 0\n    log Seen(data=self.bump(), topic=self.bump())\n",

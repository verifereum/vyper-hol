(*
 * The assembly-to-EVM half of codegen_correct (S7): the EVM frame that
 * runs the generated bytecode ends as the assembly run from its entry
 * assembly state does, or starves.
 *
 * TOP-LEVEL (CHEATED, a skeleton piece):
 *   codegen_asm_run_call - run_call against asm_steps from entry_asm_state
 *)

Theory codegenAsmRunCall
Ancestors
  codegenEntryRel asmToBytecodeProps asmBytecodeSim evmStepSim codegenRel
  codegen asmSem frameOutcome callTrace vfmExecution vfmExecutionProp

(* The frame's run is the assembly run step for step (asm_evm_rel, as
   asmBytecodeSim's single-frame simulation), extended to calls and GAS:
   the assembly takes each call outcome and GAS reading from the lists
   initial_ctx_rel ties to the frame's own trace (call_trace,
   gas_readings), so it consumes them in the order the frame produces
   them, and its requests are the frame's call_requests.  A frame that
   runs out of gas or overflows the stack is frame_resource_starved; the
   assembly has no such limits.  The assembly semantics is
   deterministic, so each clause is about its one terminal state. *)
Theorem codegen_asm_run_call:
  !rpolicy unit cp prog Inv vs es.
    generate_context_plan unit.cu_context = SOME cp /\
    codegen_assembly rpolicy unit = SOME prog /\
    unit_shape_ok unit /\
    codegen_context_obligations Inv unit.cu_context cp /\
    codegen_reachability_package Inv unit.cu_context vs /\
    initial_ctx_rel cp prog unit.cu_context vs es
    ==>
    ?r es'.
      run_call es = SOME (r, es') /\
      (frame_resource_starved es r es' \/
       ((!n as'. asm_steps (SND (compute_label_offsets prog)) (build_offset_to_pc prog) prog n
         (entry_asm_state vs es) = AsmHalt as' ==>
           frame_outcome es r es' NONE as'.as_returndata as'.as_logs /\
           es'.rollback.accounts = as'.as_accounts /\
           es'.rollback.toDelete = as'.as_pending_deletions /\
           es'.rollback.tStorage = as'.as_transient /\
           as'.as_requests = call_requests es) /\
        (!n as'. asm_steps (SND (compute_label_offsets prog)) (build_offset_to_pc prog) prog n
         (entry_asm_state vs es) = AsmRevert as' ==>
           ?lgs. frame_outcome es r es' (SOME Reverted) as'.as_returndata lgs) /\
        (!n as'. asm_steps (SND (compute_label_offsets prog)) (build_offset_to_pc prog) prog n
         (entry_asm_state vs es) = AsmFault as' ==>
           ?exc lgs. exc <> Reverted /\
                     frame_outcome es r es' (SOME exc) [] lgs)))
Proof
  cheat
QED

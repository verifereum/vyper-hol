(* Compare bytes at a common writer-relative offset, not at a common
   absolute address.  MCOPY takes its mask from the pre-state. *)
Theorem focus_cut_writer_taint_effect:
  (!d v dt. inst.inst_operands = [d;v] /\
     (inst.inst_opcode = MSTORE \/ inst.inst_opcode = ISTORE) /\
     eval_operand d t = SOME dt ==>
     ?ds. eval_operand d s = SOME ds /\
       op_taint un v SUBSET op_taint tn v /\
       (!k. y = w2n dt + k /\ k IN op_taint un v ==> x = w2n ds + k)) /\
  (!d r n dt rt nt. inst.inst_operands = [d;r;n] /\
     inst.inst_opcode = MCOPY /\ eval_operand d t = SOME dt /\
     eval_operand r t = SOME rt /\ eval_operand n t = SOME nt ==>
     ?ds rs ns. eval_operand d s = SOME ds /\
       eval_operand r s = SOME rs /\ eval_operand n s = SOME ns /\
       (!k. k < w2n nt /\ y = w2n dt + k ==>
         k < w2n ns /\ x = w2n ds + k /\
         (w2n rt + k IN un.t_mem ==> w2n rs + k IN tn.t_mem))) ==>
  y IN written_taint un inst t ==> x IN written_taint tn inst s
Proof
  strip_tac >>
  namedCases_on `inst.inst_operands` ["", "d rest"] >> simp[written_taint_def] >>
  namedCases_on `rest` ["", "v tail"] >> simp[written_taint_def] >>
  namedCases_on `tail` ["", "n more"] >> simp[written_taint_def]
  >- (Cases_on `inst.inst_opcode = MSTORE \/ inst.inst_opcode = ISTORE` >>
      simp[] >> Cases_on `eval_operand d t` >> simp[] >>
      rename1 `eval_operand d t = SOME dstT` >>
      first_x_assum (qspecl_then [`d`,`v`,`dstT`] mp_tac) >>
      simp[] >> strip_tac >> simp[] >> fs[SUBSET_DEF] >> metis_tac[]) >>
  Cases_on `more` >> simp[] >>
  Cases_on `inst.inst_opcode = MCOPY` >> simp[] >>
  Cases_on `eval_operand d t` >> simp[] >>
  Cases_on `eval_operand v t` >> simp[] >>
  Cases_on `eval_operand n t` >> simp[] >> gvs[] >> metis_tac[]
QED

(* Only generated taint needs a matching destination and copy input.
   A generated byte is in the actual write footprint of the target edge. *)
Theorem focus_cut_generated_identity[local]:
  ptr_chrono_step Ct at zt /\
  at.po_inst = concretize_inst_with_positions p a.po_inst /\
  (!op. op_taint at.po_taint op SUBSET {k | k < 32}) /\
  (!op. op_taint at.po_taint op SUBSET op_taint a.po_taint op) /\
  (i IN range_bytes (step_writes at.po_inst at.po_state zt.po_state) ==>
   !ops. mem_write_ops a.po_inst = SOME ops ==>
     eval_operand ops.iao_ofst at.po_state = eval_operand ops.iao_ofst a.po_state) /\
  (a.po_inst.inst_opcode = MCOPY ==>
    ?d r n rs rt sz. a.po_inst.inst_operands = [d;r;n] /\
      eval_operand r a.po_state = SOME rs /\ eval_operand r at.po_state = SOME rt /\
      eval_operand n a.po_state = SOME sz /\ eval_operand n at.po_state = SOME sz /\
      (!k. k < w2n sz ==> w2n rt + k IN at.po_taint.t_mem ==>
                           w2n rs + k IN a.po_taint.t_mem)) ==>
  i IN written_taint at.po_taint at.po_inst at.po_state ==>
  i IN written_taint a.po_taint a.po_inst a.po_state
Proof
  disch_then (map_every assume_tac o CONJUNCTS) >> disch_tac >>
  drule_all ptr_dalloca_chrono_written_footprint >> disch_tac >>
  `at.po_inst = a.po_inst` by metis_tac[ptr_dalloca_written_instruction] >>
  irule (MP_CANON focus_cut_writer_taint_effect) >>
  qexistsl [`at.po_state`, `at.po_taint`, `i`] >>
  asm_rewrite_tac[] >>
  conj_tac
  >- (rpt gen_tac >> strip_tac >>
      `eval_operand d a.po_state = SOME dt` by gvs[mem_write_ops_def] >>
      qexists `dt` >> simp[]) >>
  conj_tac
  >- (rpt gen_tac >> strip_tac >>
      `eval_operand d a.po_state = SOME dt` by gvs[mem_write_ops_def] >>
      qpat_x_assum `a.po_inst.inst_opcode = MCOPY ==> _` mp_tac >>
      simp[] >> strip_tac >> gvs[] >> metis_tac[]) >>
  qpat_x_assum `i IN written_taint _ _ _` mp_tac >> asm_rewrite_tac[]
QED

(* The live masks in the four fields all come from the given successor
   edges.  In particular a return restores variables, not these fields. *)
Theorem focus_cut_ghost_memory_next:
  a = EL (EL q done) h /\ at = EL q ht /\
  z = EL (SUC (EL q done)) h /\ zt = EL (SUC q) ht /\
  ptr_chrono_step C a z /\ ptr_chrono_step Ct at zt /\
  at.po_inst = concretize_inst_with_positions p a.po_inst /\
  (!i. (i < lo \/ dyn_floor C vs <= i) ==>
    i IN at.po_taint.t_mem ==> i IN a.po_taint.t_mem) /\
  at.po_taint.t_stor SUBSET a.po_taint.t_stor /\
  at.po_taint.t_trans SUBSET a.po_taint.t_trans /\
  at.po_taint.t_imm SUBSET a.po_taint.t_imm /\
  ((~is_terminator a.po_inst.inst_opcode /\ a.po_inst.inst_opcode <> INVOKE) ==>
    new_site_bytes at.po_state zt.po_state SUBSET new_site_bytes a.po_state z.po_state /\
    (!op. op_taint at.po_taint op SUBSET {k | k < 32}) /\
    (!op. op_taint at.po_taint op SUBSET op_taint a.po_taint op) /\
    (!i. (i < lo \/ dyn_floor C vs <= i) ==>
      (i IN range_bytes (step_writes at.po_inst at.po_state zt.po_state) <=>
       i IN range_bytes (step_writes a.po_inst a.po_state z.po_state)) /\
      (i IN range_bytes (step_writes at.po_inst at.po_state zt.po_state) ==>
       !ops. mem_write_ops a.po_inst = SOME ops ==>
         eval_operand ops.iao_ofst at.po_state = eval_operand ops.iao_ofst a.po_state)) /\
    (a.po_inst.inst_opcode = MCOPY ==>
      ?d r n rs rt sz. a.po_inst.inst_operands = [d;r;n] /\
        eval_operand r a.po_state = SOME rs /\ eval_operand r at.po_state = SOME rt /\
        eval_operand n a.po_state = SOME sz /\ eval_operand n at.po_state = SOME sz /\
        (!k. k < w2n sz ==> w2n rt + k IN at.po_taint.t_mem ==>
                             w2n rs + k IN a.po_taint.t_mem)) /\
    (!d v. (a.po_inst.inst_opcode = SSTORE \/ a.po_inst.inst_opcode = TSTORE \/
            a.po_inst.inst_opcode = ISTORE) /\ a.po_inst.inst_operands = [d;v] ==>
       eval_operand d at.po_state = eval_operand d a.po_state) /\
    (MEM a.po_inst.inst_opcode [CALL;DELEGATECALL;CREATE;CREATE2] ==>
      ((adopt_guard at.po_state.vs_call_ctx.cc_static at.po_state zt.po_state ((HD at.po_state.vs_outcomes).co_success \/
         MEM a.po_inst.inst_opcode [CREATE;CREATE2])) =
       (adopt_guard a.po_state.vs_call_ctx.cc_static a.po_state z.po_state ((HD a.po_state.vs_outcomes).co_success \/
         MEM a.po_inst.inst_opcode [CREATE;CREATE2]))))) ==>
  (!i. (i < lo \/ dyn_floor C vs <= i) ==>
    i IN (EL (SUC q) ht).po_taint.t_mem ==>
    i IN (EL (SUC (EL q done)) h).po_taint.t_mem) /\
  (EL (SUC q) ht).po_taint.t_stor SUBSET (EL (SUC (EL q done)) h).po_taint.t_stor /\
  (EL (SUC q) ht).po_taint.t_trans SUBSET (EL (SUC (EL q done)) h).po_taint.t_trans /\
  (EL (SUC q) ht).po_taint.t_imm SUBSET (EL (SUC (EL q done)) h).po_taint.t_imm
Proof
  disch_then (map_every assume_tac o CONJUNCTS) >>
  qpat_x_assum `a = EL _ _` kall_tac >>
  qpat_x_assum `at = EL _ _` kall_tac >>
  qpat_x_assum `z = EL _ _` (assume_tac o SYM) >>
  qpat_x_assum `zt = EL _ _` (assume_tac o SYM) >>
  qpat_x_assum `at.po_inst = concretize_inst_with_positions _ _` (mk_asm "translated") >>
  asm_rewrite_tac[] >>
  Cases_on `~is_terminator a.po_inst.inst_opcode /\ a.po_inst.inst_opcode <> INVOKE`
  >- (qpat_x_assum `~is_terminator a.po_inst.inst_opcode /\ _` strip_assume_tac >>
      `~is_terminator at.po_inst.inst_opcode /\ at.po_inst.inst_opcode <> INVOKE` by
        (asm "translated" assume_tac >>
         metis_tac[concretize_positions_nonterminator, concretize_positions_not_invoke]) >>
      qpat_x_assum `(~is_terminator a.po_inst.inst_opcode /\ _ ==> _)` mp_tac >>
      simp[] >> disch_then (map_every assume_tac o CONJUNCTS) >>
      qpat_assum `ptr_chrono_step C a z` (mp_tac o MATCH_MP ptr_dalloca_chrono_ordinary_taint_fields) >>
      qpat_assum `ptr_chrono_step Ct at zt` (mp_tac o MATCH_MP ptr_dalloca_chrono_ordinary_taint_fields) >>
      simp[] >> ntac 2 (disch_then (map_every assume_tac o CONJUNCTS)) >>
      asm_rewrite_tac[] >> conj_tac
      >- (qx_gen_tac `i` >> disch_tac >>
          qpat_x_assum `!i. _ ==> (_ <=> _) /\ _` (qspec_then `i` mp_tac) >>
          simp[] >> strip_tac >>
          `i IN written_taint at.po_taint at.po_inst at.po_state ==>
           i IN written_taint a.po_taint a.po_inst a.po_state` by
            (strip_tac >> asm "translated" assume_tac >>
             irule (MP_CANON focus_cut_generated_identity) >>
             rpt (goal_assum (drule_at Any)) >> simp[]) >>
          simp[step_taint_def, mem_taint_def] >> fs[SUBSET_DEF] >> metis_tac[]) >>
      Cases_on `at.po_inst = a.po_inst`
      >- (irule ptr_dalloca_persistent_next >> asm_rewrite_tac[] >>
          rw[] >> metis_tac[]) >>
      `a.po_inst.inst_opcode = ALLOCA /\
       (at.po_inst.inst_opcode = ASSIGN \/ at.po_inst.inst_opcode = NOP)` by
        (asm "translated" assume_tac >>
         `a.po_inst.inst_opcode = ALLOCA` by metis_tac[concretize_positions_unchanged] >>
         qpat_x_assum `at.po_inst <> a.po_inst` mp_tac >>
         asm_x "translated" SUBST1_TAC >>
         simp[concretizeMemLocDefsTheory.concretize_inst_with_positions_def] >>
         rpt CASE_TAC >> simp[passSharedDefsTheory.mk_assign_inst_def,
                              passSharedDefsTheory.mk_nop_inst_def]) >>
      gvs[step_taint_def, store_taint_def, imm_taint_def, adopt_reset_def]) >>
  `is_terminator a.po_inst.inst_opcode \/ a.po_inst.inst_opcode = INVOKE` by metis_tac[] >>
  `a.po_inst.inst_opcode <> ALLOCA` by (strip_tac >> gvs[is_terminator_def]) >>
  `at.po_inst = a.po_inst` by
    (asm "translated" assume_tac >> metis_tac[concretize_positions_unchanged]) >>
  qpat_assum `ptr_chrono_step C a z` (mp_tac o MATCH_MP ptr_chrono_control_taint_fields) >>
  qpat_assum `ptr_chrono_step Ct at zt` (mp_tac o MATCH_MP ptr_chrono_control_taint_fields) >>
  simp[] >> metis_tac[]
QED
